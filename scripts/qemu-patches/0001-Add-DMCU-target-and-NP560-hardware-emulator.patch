+        env->native_font_copy_source, env->native_font_copy_length,
+        env->native_font_copy_nonzero,
+        env->native_font_copy_nonzero_calls,
+        env->native_font_copy_max_nonzero);
+    g_string_append(text, "\nFONT_COPY_TRACE=");
+    if (env->font_copy_trace_count) {
+        uint32_t start = env->font_copy_trace_count >
+                         DMCU_FONT_COPY_TRACE_SLOTS ?
+                         env->font_copy_trace_count -
+                         DMCU_FONT_COPY_TRACE_SLOTS : 0;
+        uint32_t trace;
+
+        for (trace = start; trace < env->font_copy_trace_count; trace++) {
+            uint32_t slot = trace % DMCU_FONT_COPY_TRACE_SLOTS;
+
+            g_string_append_printf(
+                text, "%s%04x>%06x/%u/%u/%08x",
+                trace == start ? "" : ",",
+                env->font_copy_trace_character[slot] & 0xffff,
+                env->font_copy_trace_source[slot] & 0xffffff,
+                env->font_copy_trace_length[slot],
+                env->font_copy_trace_nonzero[slot],
+                env->font_copy_trace_hash[slot]);
+        }
+    } else {
+        g_string_append(text, "none");
+    }
+    g_string_append(text, "\nFONT_CONFIG_TRACE=");
+    if (env->font_config_trace_count) {
+        uint32_t start = env->font_config_trace_count >
+                         DMCU_FONT_CONFIG_TRACE_SLOTS ?
+                         env->font_config_trace_count -
+                         DMCU_FONT_CONFIG_TRACE_SLOTS : 0;
+        uint32_t trace;
+
+        for (trace = start; trace < env->font_config_trace_count; trace++) {
+            uint32_t slot = trace % DMCU_FONT_CONFIG_TRACE_SLOTS;
+            uint32_t pc = env->font_config_trace_pc[slot];
+
+            g_string_append_printf(
+                text, "%s%02x:%04x/%06x=%04x:%u",
+                trace == start ? "" : ",",
+                dmcu_code_segment(pc), dmcu_code_pc(pc),
+                env->font_config_trace_address[slot],
+                env->font_config_trace_value[slot] & 0xffff,
+                env->font_config_trace_bits[slot]);
+        }
+    } else {
+        g_string_append(text, "none");
+    }
+    g_string_append(text, "\nCOLOR_TRACE=");
+    if (env->color_trace_count) {
+        uint32_t start = env->color_trace_count > DMCU_COLOR_TRACE_SLOTS ?
+                         env->color_trace_count - DMCU_COLOR_TRACE_SLOTS : 0;
+        uint32_t trace;
+
+        for (trace = start; trace < env->color_trace_count; trace++) {
+            uint32_t slot = trace % DMCU_COLOR_TRACE_SLOTS;
+            uint32_t caller = env->color_trace_caller[slot];
+
+            g_string_append_printf(
+                text,
+                "%s%02x:%04x/i%u,%u@%06x:%02x/%02x>%04x,"
+                "%06x:%02x/%02x>%04x",
+                trace == start ? "" : ",",
+                dmcu_code_segment(caller), dmcu_code_pc(caller),
+                env->color_trace_index_a[slot],
+                env->color_trace_index_b[slot],
+                env->color_trace_address_a[slot] & 0x00ffffffu,
+                env->color_trace_raw_a[slot], env->color_trace_lane_a[slot],
+                env->color_trace_result_a[slot],
+                env->color_trace_address_b[slot] & 0x00ffffffu,
+                env->color_trace_raw_b[slot], env->color_trace_lane_b[slot],
+                env->color_trace_result_b[slot]);
+        }
+    } else {
+        g_string_append(text, "none");
+    }
+    g_string_append(text, "\nTEXT_TRACE=");
+    if (env->text_trace_count) {
+        uint32_t start = env->text_trace_count > DMCU_TEXT_TRACE_SLOTS ?
+                         env->text_trace_count - DMCU_TEXT_TRACE_SLOTS : 0;
+        uint32_t trace;
+
+        for (trace = start; trace < env->text_trace_count; trace++) {
+            uint32_t slot = trace % DMCU_TEXT_TRACE_SLOTS;
+            uint32_t pc = env->text_trace_pc[slot];
+
+            g_string_append_printf(
+                text, "%s%02x:%04x@%u,%u/%06x=%08x%08x",
+                trace == start ? "" : ",",
+                dmcu_code_segment(pc), dmcu_code_pc(pc),
+                env->text_trace_x[slot], env->text_trace_y[slot],
+                env->text_trace_pointer[slot],
+                env->text_trace_data0[slot], env->text_trace_data1[slot]);
+        }
+    } else {
+        g_string_append(text, "none");
+    }
+    g_string_append_printf(text, "\nDESKTOP_TEXT_TRACE=COUNT:%u TRACE:",
+                           env->desktop_text_trace_count);
+    if (env->desktop_text_trace_count) {
+        uint32_t count = MIN(env->desktop_text_trace_count,
+                             (uint32_t)DMCU_DESKTOP_TEXT_TRACE_SLOTS);
+        uint32_t trace;
+
+        for (trace = 0; trace < count; trace++) {
+            uint32_t target = env->desktop_text_trace_target[trace];
+            uint32_t caller = env->desktop_text_trace_caller[trace];
+            unsigned depth;
+
+            g_string_append_printf(
+                text,
+                "%s#%u/%02x:%04x>%02x:%04x@%u,%u/%06x=%08x%08x/"
+                "sp%04x/fp%04x/chain",
+                trace ? "," : "", trace + 1,
+                dmcu_code_segment(caller), dmcu_code_pc(caller),
+                dmcu_code_segment(target), dmcu_code_pc(target),
+                env->desktop_text_trace_x[trace],
+                env->desktop_text_trace_y[trace],
+                env->desktop_text_trace_pointer[trace] & 0xffffff,
+                env->desktop_text_trace_data0[trace],
+                env->desktop_text_trace_data1[trace],
+                env->desktop_text_trace_sp[trace],
+                env->desktop_text_trace_fp[trace]);
+            for (depth = 0; depth < DMCU_START_GLYPH_TRACE_FRAMES;
+                 depth++) {
+                uint32_t frame = env->desktop_text_trace_chain[trace][depth];
+
+                if (!frame) {
+                    break;
+                }
+                g_string_append_printf(
+                    text, "%s%02x:%04x", depth ? ">" : "",
+                    dmcu_code_segment(frame), dmcu_code_pc(frame));
+            }
+        }
+    } else {
+        g_string_append(text, "none");
+    }
+    g_string_append_printf(text,
+        "\nNAND=EC:DC:10:95 PAGE=%u+%u BLOCK_PAGES=%u BLOCKS=%u IMAGE=%zu "
+        "CMD=%u STATUS=%u ERROR=%u PAGE_ADDR=%08x COLUMN=%u LENGTH=%u "
+        "BUFFER=%06" HWADDR_PRIx " READS=%" G_GUINT64_FORMAT " "
+        "PROGRAMS=%" G_GUINT64_FORMAT " ERASES=%" G_GUINT64_FORMAT " "
+        "COPIES=%" G_GUINT64_FORMAT,
+        NP560_NAND_PAGE_DATA, NP560_NAND_PAGE_OOB,
+        NP560_NAND_PAGES_PER_BLOCK, NP560_NAND_BLOCKS,
+        s->nand.image_bytes, s->nand.command, s->nand.status,
+        s->nand.error, np560_nand_page(&s->nand), s->nand.column,
+        s->nand.length, np560_nand_buffer(&s->nand), s->nand.page_reads,
+        s->nand.page_programs, s->nand.block_erases,
+        s->nand.page_copies);
+    g_string_append(text, "\nNAND_TRACE=");
+    if (s->nand.trace_index) {
+        uint32_t count = MIN(s->nand.trace_index,
+                             (uint32_t)NP560_NAND_TRACE);
+        uint32_t first = s->nand.trace_index - count;
+        uint32_t trace;
+
+        for (trace = first; trace < s->nand.trace_index; trace++) {
+            uint32_t slot = trace % NP560_NAND_TRACE;
+            uint32_t pc = s->nand.trace_pc[slot];
+            unsigned byte;
+
+            g_string_append_printf(
+                text,
+                "%s%u@%02x:%04x<%02x:%04x/p%08x+c%u/n%u>b%06x/"
+                "f%04x/%08x/",
+                trace == first ? "" : ",",
+                s->nand.trace_command[slot],
+                dmcu_code_segment(pc), dmcu_code_pc(pc),
+                dmcu_code_segment(s->nand.trace_caller[slot]),
+                dmcu_code_pc(s->nand.trace_caller[slot]),
+                s->nand.trace_page[slot], s->nand.trace_column[slot],
+                s->nand.trace_length[slot], s->nand.trace_buffer[slot],
+                s->nand.trace_flags[slot], s->nand.trace_hash[slot]);
+            for (byte = 0; byte < NP560_NAND_TRACE_PREFIX; byte++) {
+                g_string_append_printf(
+                    text, "%02x", s->nand.trace_prefix[slot][byte]);
+            }
+        }
+    } else {
+        g_string_append(text, "none");
+    }
+    g_string_append_printf(
+        text,
+        "\nNAND_CAFE_RECORD=READS:%" G_GUINT64_FORMAT " "
+        "FIRST:%02x:%04x<%02x:%04x<%02x:%04x/p%08x+c%u+o%u/n%u>"
+        "b%06x/f%04x/",
+        s->nand.cafe_record_reads,
+        dmcu_code_segment(s->nand.cafe_first_pc),
+        dmcu_code_pc(s->nand.cafe_first_pc),
+        dmcu_code_segment(s->nand.cafe_first_caller),
+        dmcu_code_pc(s->nand.cafe_first_caller),
+        dmcu_code_segment(s->nand.cafe_first_parent),
+        dmcu_code_pc(s->nand.cafe_first_parent),
+        s->nand.cafe_first_page, s->nand.cafe_first_column,
+        s->nand.cafe_first_offset, s->nand.cafe_first_length,
+        s->nand.cafe_first_buffer, s->nand.cafe_first_flags);
+    for (uint32_t byte = 0; byte < NP560_NAND_CAFE_PREFIX; byte++) {
+        g_string_append_printf(text, "%02x", s->nand.cafe_first_prefix[byte]);
+    }
+    g_string_append_printf(
+        text,
+        " LAST:%02x:%04x<%02x:%04x<%02x:%04x/p%08x+c%u+o%u/n%u>"
+        "b%06x/f%04x/",
+        dmcu_code_segment(s->nand.cafe_pc), dmcu_code_pc(s->nand.cafe_pc),
+        dmcu_code_segment(s->nand.cafe_caller),
+        dmcu_code_pc(s->nand.cafe_caller),
+        dmcu_code_segment(s->nand.cafe_parent),
+        dmcu_code_pc(s->nand.cafe_parent),
+        s->nand.cafe_page, s->nand.cafe_column, s->nand.cafe_offset,
+        s->nand.cafe_length, s->nand.cafe_buffer, s->nand.cafe_flags);
+    for (uint32_t byte = 0; byte < NP560_NAND_CAFE_PREFIX; byte++) {
+        g_string_append_printf(text, "%02x", s->nand.cafe_prefix[byte]);
+    }
+    return g_string_free(text, false);
+}
+
+static void np560_init(MachineState *machine)
+{
+    NP560MachineState *s = NP560_MACHINE(machine);
+    g_autofree char *filename = NULL;
+    CPUState *cs;
+    uint8_t *bootrom = NULL;
+    uint8_t *missing_soc_rom;
+    gsize offset;
+    ssize_t loaded;
+    bool mask_rom03_present = false;
+    uint32_t resident_rom_base = 0;
+    uint32_t resident_rom_limit = 0;
+    uint32_t reset_pc = DMCU_PROGRAM_BASE;
+    uint32_t auxiliary_code_base = 0;
+    uint32_t auxiliary_code_limit = 0;
+    gsize usb_loader_size = 0;
+    gsize burn_code_size = 0;
+    gsize driver_code_size = 0;
+    size_t overlay_index;
+
+    if (s->soc_rom_skeleton && (!s->soc_rom || !*s->soc_rom)) {
+        error_report("NP560+ soc-rom-skeleton=on requires soc-rom=FILE");
+        exit(EXIT_FAILURE);
+    }
+    if (s->soc_rom_skeleton && s->rom_hle) {
+        error_report("NP560+ soc-rom-skeleton and rom-hle cannot be combined");
+        exit(EXIT_FAILURE);
+    }
+
+    /* Back the complete 24-bit data space.  Code ROM uses a separate bus. */
+    memory_region_init_ram(&s->data, NULL, "np560.data",
+                           DMCU_DATA_SIZE, &error_fatal);
+    memory_region_add_subregion(get_system_memory(), 0, &s->data);
+    /* IGNDS is a separate unbanked hardware view, not another name for banked
+     * RAM at the same physical address.  Alias the underlying RAM into two
+     * pages above the 24-bit data store, then overlay only the actual devices
+     * there.  The DMCU target has a 25-bit physical dispatch space for this
+     * purpose. */
+    memory_region_init_alias(&s->data_unbanked_low_alias, NULL,
+                             "np560.unbanked-low-page", &s->data, 0,
+                             DMCU_UNBANKED_PAGE_SIZE);
+    memory_region_add_subregion(get_system_memory(),
+                                DMCU_UNBANKED_LOW_PAGE_BASE,
+                                &s->data_unbanked_low_alias);
+    memory_region_init_alias(&s->data_unbanked_sfr_alias, NULL,
+                             "np560.unbanked-sfr-page", &s->data, 0xf000,
+                             DMCU_UNBANKED_PAGE_SIZE);
+    memory_region_add_subregion(get_system_memory(),
+                                DMCU_UNBANKED_SFR_PAGE_BASE,
+                                &s->data_unbanked_sfr_alias);
+    np560_timer_reset(s);
+    memory_region_init_io(&s->timer_mmio, NULL, &np560_timer_ops, s,
+                          "np560.timer64", NP560_TIMER_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         DMCU_UNBANKED_LOW_PAGE_BASE +
+                                         NP560_TIMER_BASE,
+                                         &s->timer_mmio, 10);
+    qemu_register_reset(np560_timer_reset, s);
+    np560_st7529_reset(s);
+    memory_region_init_io(&s->lcd_mmio, NULL, &np560_st7529_ops, s,
+                          "np560.st7529", NP560_ST7529_MMIO_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         NP560_ST7529_BASE,
+                                         &s->lcd_mmio, 10);
+    qemu_register_reset(np560_st7529_reset, s);
+    np560_ecc_reset(s);
+    memory_region_init_io(&s->ecc_mmio, NULL, &np560_ecc_ops, s,
+                          "np560.hsiao-ecc", NP560_ECC_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         DMCU_UNBANKED_SFR_PAGE_BASE +
+                                         NP560_ECC_BASE - 0xf000,
+                                         &s->ecc_mmio, 10);
+    /*
+     * 51:C1A4 resets and reads the ECC engine through IGNDS, but feeds its
+     * 256 words indirectly through R3=F20E after selecting DS1=1.  That
+     * translated operand lands at banked physical F20E.  Both addresses are
+     * views of the same SoC peripheral, just like the evidenced F100/F160
+     * dual-view registers below.
+     */
+    memory_region_init_alias(&s->ecc_banked_alias, NULL,
+                             "np560.hsiao-ecc-banked-alias",
+                             &s->ecc_mmio, 0, NP560_ECC_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(), NP560_ECC_BASE,
+                                         &s->ecc_banked_alias, 10);
+    qemu_register_reset(np560_ecc_reset, s);
+    np560_adc_reset(s);
+    memory_region_init_io(&s->adc_mmio, NULL, &np560_adc_ops, s,
+                          "np560.adc-comparator", NP560_ADC_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         DMCU_UNBANKED_SFR_PAGE_BASE +
+                                         NP560_ADC_BASE - 0xf000,
+                                         &s->adc_mmio, 10);
+    memory_region_init_alias(&s->adc_banked_alias, NULL,
+                             "np560.adc-comparator-banked-alias",
+                             &s->adc_mmio, 0, NP560_ADC_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(), NP560_ADC_BASE,
+                                         &s->adc_banked_alias, 10);
+    qemu_register_reset(np560_adc_reset, s);
+    np560_load_nand_image(s);
+    np560_nand_reset(s);
+    memory_region_init_io(&s->nand_mmio, NULL, &np560_nand_ops, s,
+                          "np560.reconstructed-nand-controller",
+                          NP560_NAND_CTRL_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         DMCU_UNBANKED_SFR_PAGE_BASE +
+                                         NP560_NAND_CTRL_BASE - 0xf000,
+                                         &s->nand_mmio, 10);
+    qemu_register_reset(np560_nand_reset, s);
+    memset(&s->keyboard, 0, sizeof(s->keyboard));
+    memory_region_init_io(&s->keyboard_gpio_mmio, NULL,
+                          &np560_keyboard_gpio_ops, s,
+                          "np560.keyboard-gpio", NP560_KEYBOARD_GPIO_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         DMCU_UNBANKED_SFR_PAGE_BASE +
+                                         NP560_KEYBOARD_GPIO_BASE - 0xf000,
+                                         &s->keyboard_gpio_mmio, 10);
+    memory_region_init_io(&s->system_control_mmio, NULL,
+                          &np560_system_control_ops, s,
+                          "np560.system-control",
+                          NP560_SYSTEM_CONTROL_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         DMCU_UNBANKED_SFR_PAGE_BASE +
+                                         NP560_SYSTEM_CONTROL_BASE - 0xf000,
+                                         &s->system_control_mmio, 10);
+    /*
+     * The exact application entry at 2D:7E2A selects DS0=1 and writes
+     * A082 to logical 7100.  DMCU bank translation maps that operand to
+     * physical F100, while IGNDS users reach the same register through the
+     * private unbanked-SFR page above.  Both views are aliases of one
+     * hardware register.  Mapping only the IGNDS view left A082 sitting in
+     * ordinary RAM and prevented the already-installed 08:40D0 vector from
+     * ever receiving the 64-Hz interrupt.
+     */
+    memory_region_init_alias(&s->system_control_banked_alias, NULL,
+                             "np560.system-control-banked-alias",
+                             &s->system_control_mmio, 0,
+                             NP560_SYSTEM_CONTROL_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         NP560_SYSTEM_CONTROL_BASE,
+                                         &s->system_control_banked_alias, 10);
+    memory_region_init_io(&s->key_matrix_mmio, NULL,
+                          &np560_key_matrix_ops, s,
+                          "np560.key-matrix", NP560_KEY_MATRIX_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         DMCU_UNBANKED_SFR_PAGE_BASE +
+                                         NP560_KEY_MATRIX_BASE - 0xf000,
+                                         &s->key_matrix_mmio, 10);
+    /* The exact 27:E528 timer callback and its 2E:5F28 scanner select DS0=1
+     * before accessing logical 7160/7164, i.e. banked physical F160/F164.
+     * This is the same dual-view peripheral convention proven above for
+     * F100; without the banked alias the callback reads the 00FF RAM seed
+     * forever and never enters the debounce/matrix path. */
+    memory_region_init_alias(&s->key_matrix_banked_alias, NULL,
+                             "np560.key-matrix-banked-alias",
+                             &s->key_matrix_mmio, 0,
+                             NP560_KEY_MATRIX_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         NP560_KEY_MATRIX_BASE,
+                                         &s->key_matrix_banked_alias, 10);
+    memory_region_init_io(&s->keyboard_mmio, NULL, &np560_keyboard_ops, s,
+                          "np560.reconstructed-keyboard-controller",
+                          NP560_KEYBOARD_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(),
+                                         DMCU_UNBANKED_SFR_PAGE_BASE +
+                                         NP560_KEYBOARD_BASE - 0xf000,
+                                         &s->keyboard_mmio, 10);
+    qemu_register_reset(np560_keyboard_reset, s);
+    memory_region_init(&s->code, NULL, "np560.code", DMCU_DATA_SIZE);
+    /*
+     * Do not silently execute zero-filled data RAM when the internal ROM is
+     * absent.  0x0f00 is an unassigned DMCU opcode, so strict execution traps
+     * at the first missing resident instruction and preserves the true PC.
+     * Real ROM/loader mappings below overlap this diagnostic guard.
+     */
+    memory_region_init_rom(&s->missing_soc_rom, NULL,
+                           "np560.missing-soc-rom", DMCU_SOC_ROM_SIZE,
+                           &error_fatal);
+    missing_soc_rom = memory_region_get_ram_ptr(&s->missing_soc_rom);
+    for (offset = 0; offset < DMCU_SOC_ROM_SIZE; offset += 2) {
+        stw_le_p(missing_soc_rom + offset, 0x0f00);
+    }
+    memory_region_add_subregion(&s->code, 0, &s->missing_soc_rom);
+
+    memory_region_init_alias(&s->code_internal_prefix_alias, NULL,
+                             "np560.code-internal-prefix-alias", &s->data,
+                             NP560_INTERNAL_CODE_PREFIX_BASE,
+                             NP560_INTERNAL_CODE_PREFIX_SIZE);
+    memory_region_add_subregion_overlap(
+        &s->code, NP560_INTERNAL_CODE_PREFIX_BASE,
+        &s->code_internal_prefix_alias, 2);
+    memory_region_init_alias(
+        &s->code_resident_record_load_overlay_alias, NULL,
+        "np560.code-resident-record-load-overlay-alias", &s->data,
+        NP560_RESIDENT_RECORD_LOAD_OVERLAY_BASE,
+        NP560_RESIDENT_RECORD_LOAD_OVERLAY_SIZE);
+    memory_region_add_subregion_overlap(
+        &s->code, NP560_RESIDENT_RECORD_LOAD_OVERLAY_BASE,
+        &s->code_resident_record_load_overlay_alias, 2);
+
+    if (s->soc_rom && *s->soc_rom) {
+        g_autofree char *rom_filename =
+            qemu_find_file(QEMU_FILE_TYPE_BIOS, s->soc_rom);
+        uint8_t *soc_rom_bytes;
+
+        if (s->mask_rom && *s->mask_rom) {
+            error_report("NP560+ soc-rom and mask-rom cannot be used together");
+            exit(EXIT_FAILURE);
+        }
+        if (!rom_filename) {
+            error_report("Unable to find NP560+ SoC ROM '%s'", s->soc_rom);
+            exit(EXIT_FAILURE);
+        }
+        memory_region_init_rom(&s->soc_rom_region, NULL, "np560.soc-rom",
+                               DMCU_SOC_ROM_SIZE, &error_fatal);
+        soc_rom_bytes = memory_region_get_ram_ptr(&s->soc_rom_region);
+        loaded = load_image_size(rom_filename, soc_rom_bytes,
+                                 DMCU_SOC_ROM_SIZE);
+        if (loaded <= 0) {
+            error_report("Unable to load NP560+ SoC ROM '%s'", rom_filename);
+            exit(EXIT_FAILURE);
+        }
+        resident_rom_base = 0;
+        resident_rom_limit = loaded;
+        mask_rom03_present = loaded > DMCU_ROM03_BASE + 0x0032;
+        memory_region_add_subregion_overlap(&s->code, 0,
+                                             &s->soc_rom_region, 1);
+        /*
+         * The recovered 24:7FE4 initializer reads exactly these three small
+         * source ranges from internal program ROM through its copy helper.
+         * Map only the evidenced ranges onto the data bus.  System images
