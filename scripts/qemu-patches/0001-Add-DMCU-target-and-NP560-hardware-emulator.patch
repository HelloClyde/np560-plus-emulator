index 0000000000000000000000000000000000000000..c0c46a5c2e92c89b6766304eb4b91a0479aab674
--- /dev/null
+++ b/seed_np560_factory_clock.py
@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+"""Seed the NP560+ factory clock record in a NAND checkpoint copy.
+
+The recovered application reads twelve logical bytes at ``10:D01F`` through
+the normal NAND-backed mask-resource reader.  The factory bootstrap image has
+those bytes erased (all ``FF``), which deliberately sends the firmware to its
+first-boot year/month/day modal before it can attach the main resource file.
+
+This utility writes a deterministic guest-visible clock record, refreshes the
+affected NAND sector ECC, and invalidates the checkpoint hashes.  It does not
+intercept the clock reader or replace a ROM service.  Run
+``np560_checkpoint_rehash`` on the output before booting it.
+"""
+
+from __future__ import annotations
+
+import argparse
+import mmap
+import shutil
+from datetime import datetime
+from pathlib import Path
+
+from analyze_np560_ecc_checkpoint import sector_descriptor
+from seed_np560_factory_bootstrap import physical_column
+from seed_np560_factory_selector import (
+    ECC_OFFSET,
+    FACTORY_PHYSICAL_PAGE,
+    HEADER_SIZE,
+    PAGE_DATA,
+    PAGE_OOB,
+    PROGRAMMED_PAGE_MARKER_OFFSET,
+    _validate_geometry,
+)
+
+
+FACTORY_CLOCK_ADDRESS = 0x10D01F
+FACTORY_CLOCK_SIZE = 12
+FACTORY_CLOCK_COLUMNS = tuple(
+    physical_column(FACTORY_CLOCK_ADDRESS + index)
+    for index in range(FACTORY_CLOCK_SIZE)
+)
+FACTORY_CLOCK_SECTOR = min(FACTORY_CLOCK_COLUMNS) // 512
+
+
+def encode_factory_clock(value: datetime) -> bytes:
+    """Return the exact sparse-byte clock layout consumed by 4C:4D94."""
+    if not 1901 <= value.year <= 2100:
+        raise ValueError("factory clock year must be in 1901..2100")
+    return bytes((
+        value.year & 0xFF,
+        value.year >> 8,
+        value.month,
+        0,
+        value.day,
+        0,
+        value.hour,
+        0,
+        value.minute,
+        0,
+        value.second,
+        0,
+    ))
+
+
+def seed_factory_clock(
+    image: mmap.mmap,
+    value: datetime,
+    *,
+    force: bool = False,
+) -> bytes:
+    """Patch the factory clock bytes and the containing sector descriptor."""
+    encoded = encode_factory_clock(value)
+    data_size, _ = _validate_geometry(image)
+    data_base = HEADER_SIZE
+    oob_base = data_base + data_size
+    page_data_offset = data_base + FACTORY_PHYSICAL_PAGE * PAGE_DATA
+    page_oob_offset = oob_base + FACTORY_PHYSICAL_PAGE * PAGE_OOB
+
+    for index, byte in enumerate(encoded):
+        offset = page_data_offset + physical_column(FACTORY_CLOCK_ADDRESS + index)
+        existing = image[offset]
+        if not force and existing not in (0xFF, byte):
+            raise ValueError(
+                f"factory clock byte D{FACTORY_CLOCK_ADDRESS + index:03X} "
+                f"already contains 0x{existing:02X}; use --force"
+            )
+        image[offset] = byte
+
+    sector_offset = page_data_offset + FACTORY_CLOCK_SECTOR * 512
+    ecc_offset = ECC_OFFSET + FACTORY_CLOCK_SECTOR * 8
+    image[page_oob_offset + ecc_offset : page_oob_offset + ecc_offset + 8] = (
+        sector_descriptor(image, sector_offset)
+    )
+    image[page_oob_offset + PROGRAMMED_PAGE_MARKER_OFFSET] = 0x00
+
+    # Prevent a partially patched file from passing checkpoint validation.
+    image[48:56] = b"\x00" * 8
+    image.flush()
+    return encoded
+
+
+def parse_clock(text: str) -> datetime:
+    try:
+        return datetime.strptime(text, "%Y-%m-%dT%H:%M:%S")
+    except ValueError as error:
+        raise argparse.ArgumentTypeError(
+            "clock must use YYYY-MM-DDTHH:MM:SS"
+        ) from error
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("destination", type=Path)
+    parser.add_argument("--clock", type=parse_clock, required=True)
+    parser.add_argument(
+        "--force",
+        action="store_true",
+        help="replace a previously seeded clock value",
+    )
+    args = parser.parse_args()
+
+    source = args.source.resolve()
+    destination = args.destination.resolve()
+    if source != destination:
+        if destination.exists():
+            raise FileExistsError(destination)
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, destination)
+    elif not destination.exists():
+        raise FileNotFoundError(destination)
+
+    with destination.open("r+b") as target:
+        image = mmap.mmap(target.fileno(), 0)
+        try:
+            encoded = seed_factory_clock(image, args.clock, force=args.force)
+        finally:
+            image.close()
+
+    print(
+        f"CLOCK={args.clock.isoformat()} BYTES={encoded.hex()} "
+        f"LOGICAL=0x{FACTORY_CLOCK_ADDRESS:06X} "
+        f"PHYSICAL_PAGE=0x{FACTORY_PHYSICAL_PAGE:X} "
+        f"OUTPUT={destination} REHASH_REQUIRED=1"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/seed_np560_factory_selector.py b/seed_np560_factory_selector.py
new file mode 100644
index 0000000000000000000000000000000000000000..1eaf83630c74589db8d83158890804ee41911c42
--- /dev/null
+++ b/seed_np560_factory_selector.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+"""Seed the NP560+ factory selector byte in a NAND checkpoint.
+
+The V3.80 updater starts programming at logical byte 0x110000.  The resident
+application reads one byte immediately before that payload, at 10:D072, to
+select the product variant.  Real hardware therefore supplies this value from
+factory-reserved NAND; updater-only checkpoints leave the corresponding page
+erased.
+
+This utility patches that one byte in the recovered FTL mapping and emits the
+same 51:C1A4 ECC descriptor used by the guest.  It deliberately does not
+recompute the checkpoint FNV-1a hashes; run np560_checkpoint_rehash afterwards.
+"""
+
+from __future__ import annotations
+
+import argparse
+import mmap
+import shutil
+import struct
+from pathlib import Path
+
+from analyze_np560_ecc_checkpoint import sector_descriptor
+
+
+CHECKPOINT_MAGIC = b"NP560N1\0"
+HEADER_SIZE = 64
+PAGE_DATA = 2048
+PAGE_OOB = 64
+PAGES_PER_BLOCK = 64
+BLOCKS = 4096
+DATA_SIZE = PAGE_DATA * PAGES_PER_BLOCK * BLOCKS
+OOB_SIZE = PAGE_OOB * PAGES_PER_BLOCK * BLOCKS
+
+# The FTL table maps logical block 0xE9B (logical data bytes
+# 0x10C000..0x10FFFF) to physical block 0xC02.  Address 10:D072 is page 0x1A
+# within that block and byte 0x72 within the page.
+FACTORY_LOGICAL_ADDRESS = 0x10D072
+FACTORY_PHYSICAL_BLOCK = 0xC02
+FACTORY_BLOCK_PAGE = 0x1A
+FACTORY_PHYSICAL_PAGE = FACTORY_PHYSICAL_BLOCK * PAGES_PER_BLOCK + FACTORY_BLOCK_PAGE
+FACTORY_LOGICAL_COLUMN = FACTORY_LOGICAL_ADDRESS & (PAGE_DATA - 1)
+
+# External byte accesses on the 16-bit NAND data bus observe A0 inverted.
+FACTORY_PHYSICAL_COLUMN = FACTORY_LOGICAL_COLUMN ^ 1
+FACTORY_SECTOR = FACTORY_PHYSICAL_COLUMN // 512
+ECC_OFFSET = (22, 30, 38, 46)[FACTORY_SECTOR]
+PROGRAMMED_PAGE_MARKER_OFFSET = 55
+
+
+def _validate_geometry(image: mmap.mmap) -> tuple[int, int]:
+    if len(image) < HEADER_SIZE or image[:8] != CHECKPOINT_MAGIC:
+        raise ValueError("not an NP560 NAND checkpoint")
+    version, header_size, page_data, page_oob, block_pages, blocks = (
+        struct.unpack_from("<6I", image, 8)
+    )
+    data_size, oob_size = struct.unpack_from("<2Q", image, 32)
+    expected = HEADER_SIZE + data_size + oob_size
+    if (
+        version != 1
+        or header_size != HEADER_SIZE
+        or page_data != PAGE_DATA
+        or page_oob != PAGE_OOB
+        or block_pages != PAGES_PER_BLOCK
+        or blocks != BLOCKS
+        or data_size != DATA_SIZE
+        or oob_size != OOB_SIZE
+        or len(image) != expected
+    ):
+        raise ValueError("incompatible NP560 NAND geometry or file size")
+    return data_size, oob_size
+
+
+def seed_selector(image: mmap.mmap, selector: int, force: bool = False) -> None:
+    """Patch the selector byte and sector-0 ECC in an open checkpoint map."""
+    if not 0 <= selector <= 0xFF:
+        raise ValueError("selector must fit in one byte")
+    data_size, _ = _validate_geometry(image)
+    data_base = HEADER_SIZE
+    oob_base = data_base + data_size
+    page_data_offset = data_base + FACTORY_PHYSICAL_PAGE * PAGE_DATA
+    page_oob_offset = oob_base + FACTORY_PHYSICAL_PAGE * PAGE_OOB
+    page = image[page_data_offset : page_data_offset + PAGE_DATA]
+    spare = image[page_oob_offset : page_oob_offset + PAGE_OOB]
+
+    expected_existing = {0xFF, selector}
+    existing = page[FACTORY_PHYSICAL_COLUMN]
+    descriptor = spare[ECC_OFFSET : ECC_OFFSET + 8]
+    marker = spare[PROGRAMMED_PAGE_MARKER_OFFSET]
+    if not force:
+        if existing not in expected_existing:
+            raise ValueError(
+                f"factory selector already contains 0x{existing:02X}; use --force"
+            )
+        if any(
+            byte != 0xFF
+            for index, byte in enumerate(page)
+            if index != FACTORY_PHYSICAL_COLUMN
+        ):
+            raise ValueError("factory selector page contains other data; use --force")
+        if descriptor != b"\xFF" * 8 and existing == 0xFF:
+            raise ValueError("factory selector page already has an ECC descriptor")
+        allowed_oob = set(range(ECC_OFFSET, ECC_OFFSET + 8)) | {
+            PROGRAMMED_PAGE_MARKER_OFFSET
+        }
+        if any(
+            byte != 0xFF
+            for index, byte in enumerate(spare)
+            if index not in allowed_oob
+        ):
+            raise ValueError("factory selector page contains other OOB data; use --force")
+        if marker not in (0xFF, 0x00):
+            raise ValueError("unexpected programmed-page marker; use --force")
+
+    image[page_data_offset + FACTORY_PHYSICAL_COLUMN] = selector
+    sector_offset = page_data_offset + FACTORY_SECTOR * 512
+    image[page_oob_offset + ECC_OFFSET : page_oob_offset + ECC_OFFSET + 8] = (
+        sector_descriptor(image, sector_offset)
+    )
+    image[page_oob_offset + PROGRAMMED_PAGE_MARKER_OFFSET] = 0x00
+
+    # Prevent a partially patched file from passing checkpoint validation.
+    image[48:56] = b"\x00" * 8
+    image.flush()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("destination", type=Path)
+    parser.add_argument(
+        "--selector",
+        type=lambda value: int(value, 0),
+        required=True,
+        help="factory product selector (for example 0x0B)",
+    )
+    parser.add_argument(
+        "--force",
+        action="store_true",
+        help="replace an existing seeded selector in the destination",
+    )
+    args = parser.parse_args()
+
+    source = args.source.resolve()
+    destination = args.destination.resolve()
+    if source != destination:
+        if destination.exists():
+            raise FileExistsError(destination)
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, destination)
+    elif not destination.exists():
+        raise FileNotFoundError(destination)
+
+    with destination.open("r+b") as target:
+        image = mmap.mmap(target.fileno(), 0)
+        try:
+            seed_selector(image, args.selector, force=args.force)
+        finally:
+            image.close()
+
+    print(
+        f"SELECTOR=0x{args.selector:02X} LOGICAL=0x{FACTORY_LOGICAL_ADDRESS:06X} "
+        f"PHYSICAL_PAGE=0x{FACTORY_PHYSICAL_PAGE:X} "
+        f"PHYSICAL_COLUMN=0x{FACTORY_PHYSICAL_COLUMN:X} "
+        f"OUTPUT={destination} REHASH_REQUIRED=1"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/seed_np560_factory_userinfo.py b/seed_np560_factory_userinfo.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c7698084d622b2409d36407bd268d4ae971685b
--- /dev/null
+++ b/seed_np560_factory_userinfo.py
@@ -0,0 +1,237 @@
+#!/usr/bin/env python3
+"""Seed a complete factory-compatible USERINFO.SYS in an NP560 checkpoint.
+
+The recovered factory filesystem has a FAT-compatible root directory in
+physical NAND page ``0x20037``.  Its first entry is ``TRASH.CAN`` and the next
+slot is the zero end marker.  During first boot the application tries to
+create ``LIRT.NWF`` and recursively opens ``USERINFO.SYS`` while committing
+metadata.  With no factory USERINFO entry, that recursion exhausts the five
+temporary file-root objects and returns FFF6 before any file data is written.
+
+The exact guest validator consumes 0x444 data bytes followed by a little-endian
+CRC16-CCITT word.  The factory FAT16 volume uses 8-KiB clusters; TRASH.CAN owns
+cluster 2 and cluster 3 is free in the recovered image.  This utility installs
+the USERINFO short entry, marks cluster 3 EOC in both FAT copies, writes a
+minimal valid V1.0 record, refreshes every affected NAND-sector ECC descriptor,
+and invalidates the checkpoint hashes.  Run ``np560_checkpoint_rehash`` on the
+output before booting it.
+"""
+
+from __future__ import annotations
+
+import argparse
+import mmap
+import shutil
+import struct
+from pathlib import Path
+
+from analyze_np560_ecc_checkpoint import ECC_OFFSETS, sector_descriptor
+from seed_np560_factory_selector import (
+    HEADER_SIZE,
+    PAGE_DATA,
+    PAGE_OOB,
+    PROGRAMMED_PAGE_MARKER_OFFSET,
+    _validate_geometry,
+)
+
+
+FAT_PHYSICAL_BLOCK = 0xC00
+FAT1_PHYSICAL_PAGE = FAT_PHYSICAL_BLOCK * 64 + 0x08
+FAT2_PHYSICAL_PAGE = FAT_PHYSICAL_BLOCK * 64 + 0x3F
+FAT1_ENTRY_OFFSET = 0x206
+FAT2_ENTRY_OFFSET = 0x606
+ROOT_PHYSICAL_PAGE = 0x20037
+ROOT_DIRECTORY_OFFSET = 0x200
+USERINFO_ENTRY_OFFSET = ROOT_DIRECTORY_OFFSET + 0x20
+USERINFO_DATA_PHYSICAL_PAGE = 0x10003
+USERINFO_DATA_OFFSET = 0x200
+USERINFO_CLUSTER = 3
+USERINFO_SHORT_NAME = b"USERINFOSYS"
+USERINFO_ATTRIBUTE = 0x20
+DIRECTORY_ENTRY_SIZE = 0x20
+USERINFO_DATA_SIZE = 0x444
+USERINFO_FILE_SIZE = USERINFO_DATA_SIZE + 2
+USERINFO_VERSION = b"V1.0  \x00"
+FAT16_EOC = 0xFFFF
+
+
+def pair_swap(data: bytes) -> bytes:
+    """Translate between physical NAND bytes and guest logical byte order."""
+    if len(data) & 1:
+        raise ValueError("pair-swapped data must have even length")
+    swapped = bytearray(data)
+    swapped[0::2] = data[1::2]
+    swapped[1::2] = data[0::2]
+    return bytes(swapped)
+
+
+def crc16_ccitt(data: bytes, initial: int = 0) -> int:
+    """Match exact guest helpers 32:5ACC and 31:F162 (poly 0x1021)."""
+    crc = initial & 0xFFFF
+    for value in data:
+        crc ^= value << 8
+        for _ in range(8):
+            crc = ((crc << 1) ^ 0x1021) & 0xFFFF if crc & 0x8000 else (
+                crc << 1
+            ) & 0xFFFF
+    return crc
+
+
+def factory_userinfo_payload() -> bytes:
+    """Return a minimal record accepted by the original USERINFO validator."""
+    data = bytearray(USERINFO_DATA_SIZE)
+    data[:len(USERINFO_VERSION)] = USERINFO_VERSION
+    checksum = crc16_ccitt(data)
+    return bytes(data) + struct.pack("<H", checksum)
+
+
+def userinfo_directory_entry() -> bytes:
+    """Return the FAT16 short-name entry for the complete seeded file."""
+    entry = bytearray(DIRECTORY_ENTRY_SIZE)
+    entry[:11] = USERINFO_SHORT_NAME
+    entry[11] = USERINFO_ATTRIBUTE
+    struct.pack_into("<H", entry, 26, USERINFO_CLUSTER)
+    struct.pack_into("<I", entry, 28, USERINFO_FILE_SIZE)
+    return bytes(entry)
+
+
+def page_offsets(page: int, data_size: int) -> tuple[int, int]:
+    return (
+        HEADER_SIZE + page * PAGE_DATA,
+        HEADER_SIZE + data_size + page * PAGE_OOB,
+    )
+
+
+def update_page_sectors(
+    image: mmap.mmap, data_size: int, page: int, sectors: set[int],
+) -> None:
+    data_offset, oob_offset = page_offsets(page, data_size)
+    for sector in sorted(sectors):
+        descriptor_offset = ECC_OFFSETS[sector]
+        sector_offset = data_offset + sector * 512
+        image[
+            oob_offset + descriptor_offset : oob_offset + descriptor_offset + 8
+        ] = sector_descriptor(image, sector_offset)
+    image[oob_offset + PROGRAMMED_PAGE_MARKER_OFFSET] = 0x00
+
+
+def logical_page(image: mmap.mmap, data_size: int, page: int) -> bytearray:
+    data_offset, _ = page_offsets(page, data_size)
+    return bytearray(pair_swap(bytes(image[data_offset:data_offset + PAGE_DATA])))
+
+
+def store_logical_page(
+    image: mmap.mmap, data_size: int, page: int, content: bytearray,
+) -> None:
+    data_offset, _ = page_offsets(page, data_size)
+    image[data_offset:data_offset + PAGE_DATA] = pair_swap(bytes(content))
+
+
+def seed_factory_userinfo(image: mmap.mmap, *, force: bool = False) -> None:
+    """Install a valid single-cluster USERINFO.SYS and its FAT metadata."""
+    data_size, _ = _validate_geometry(image)
+    root = logical_page(image, data_size, ROOT_PHYSICAL_PAGE)
+
+    existing = bytes(
+        root[
+            USERINFO_ENTRY_OFFSET : USERINFO_ENTRY_OFFSET + DIRECTORY_ENTRY_SIZE
+        ]
+    )
+    expected = userinfo_directory_entry()
+    if existing != expected:
+        zero_seed = bytearray(DIRECTORY_ENTRY_SIZE)
+        zero_seed[:11] = USERINFO_SHORT_NAME
+        zero_seed[11] = USERINFO_ATTRIBUTE
+        if not force and existing not in (
+            b"\x00" * DIRECTORY_ENTRY_SIZE, bytes(zero_seed),
+        ):
+            raise ValueError(
+                "factory USERINFO directory slot is occupied; use --force"
+            )
+        root[
+            USERINFO_ENTRY_OFFSET : USERINFO_ENTRY_OFFSET + DIRECTORY_ENTRY_SIZE
+        ] = expected
+    store_logical_page(image, data_size, ROOT_PHYSICAL_PAGE, root)
+    update_page_sectors(
+        image, data_size, ROOT_PHYSICAL_PAGE,
+        {USERINFO_ENTRY_OFFSET // 512},
+    )
+
+    for page, offset in (
+        (FAT1_PHYSICAL_PAGE, FAT1_ENTRY_OFFSET),
+        (FAT2_PHYSICAL_PAGE, FAT2_ENTRY_OFFSET),
+    ):
+        fat = logical_page(image, data_size, page)
+        existing_fat = struct.unpack_from("<H", fat, offset)[0]
+        if not force and existing_fat not in (0, FAT16_EOC):
+            raise ValueError(
+                f"FAT cluster {USERINFO_CLUSTER} is 0x{existing_fat:04X}; "
+                "use --force"
+            )
+        struct.pack_into("<H", fat, offset, FAT16_EOC)
+        store_logical_page(image, data_size, page, fat)
+        update_page_sectors(image, data_size, page, {offset // 512})
+
+    payload = factory_userinfo_payload()
+    data = logical_page(image, data_size, USERINFO_DATA_PHYSICAL_PAGE)
+    existing_data = bytes(
+        data[USERINFO_DATA_OFFSET:USERINFO_DATA_OFFSET + len(payload)]
+    )
+    if not force and existing_data not in (b"\x00" * len(payload), payload):
+        raise ValueError("USERINFO cluster data is occupied; use --force")
+    data[
+        USERINFO_DATA_OFFSET:USERINFO_DATA_OFFSET + len(payload)
+    ] = payload
+    store_logical_page(image, data_size, USERINFO_DATA_PHYSICAL_PAGE, data)
+    first_sector = USERINFO_DATA_OFFSET // 512
+    final_sector = (USERINFO_DATA_OFFSET + len(payload) - 1) // 512
+    update_page_sectors(
+        image, data_size, USERINFO_DATA_PHYSICAL_PAGE,
+        set(range(first_sector, final_sector + 1)),
+    )
+
+    # Prevent a partially patched file from passing checkpoint validation.
+    image[48:56] = b"\x00" * 8
+    image.flush()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("destination", type=Path)
+    parser.add_argument(
+        "--force",
+        action="store_true",
+        help="replace a non-empty directory slot",
+    )
+    args = parser.parse_args()
+
+    source = args.source.resolve()
+    destination = args.destination.resolve()
+    if source != destination:
+        if destination.exists():
+            raise FileExistsError(destination)
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, destination)
+    elif not destination.exists():
+        raise FileNotFoundError(destination)
+
+    with destination.open("r+b") as target:
+        image = mmap.mmap(target.fileno(), 0)
+        try:
+            seed_factory_userinfo(image, force=args.force)
+        finally:
+            image.close()
+
+    print(
+        f"USERINFO=SEEDED SHORT={USERINFO_SHORT_NAME.decode('ascii')} "
+        f"PHYSICAL_PAGE=0x{ROOT_PHYSICAL_PAGE:X} "
+        f"LOGICAL_OFFSET=0x{USERINFO_ENTRY_OFFSET:X} "
+        f"CLUSTER={USERINFO_CLUSTER} SIZE=0x{USERINFO_FILE_SIZE:X} "
+        f"OUTPUT={destination} REHASH_REQUIRED=1"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
