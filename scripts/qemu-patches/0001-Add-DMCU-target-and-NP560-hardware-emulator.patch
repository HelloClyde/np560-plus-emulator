+static void np560_set_nand_save(Object *obj, const char *value, Error **errp)
+{
+    NP560MachineState *s = NP560_MACHINE(obj);
+    Error *local_err = NULL;
+
+    if (!value || !*value) {
+        g_clear_pointer(&s->nand_save, g_free);
+        return;
+    }
+    np560_save_nand_checkpoint(s, value, &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return;
+    }
+    g_free(s->nand_save);
+    s->nand_save = g_strdup(value);
+}
