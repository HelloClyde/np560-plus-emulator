+
+static inline uint32_t dmcu_code_pc(uint32_t pc)
+{
+    return pc & 0xffff;
+}
+
+static inline uint32_t dmcu_code_address(uint32_t segment, uint32_t pc)
+{
+    return ((segment & 0xff) << 16) | (pc & 0xffff);
+}
