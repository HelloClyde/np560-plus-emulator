+static bool np560_debug_data_range(NP560MachineState *s, uint64_t address,
+                                   size_t size, Error **errp)
+{
+    uint64_t end = address + size;
+
+    if (!s->cpu || memory_region_size(&s->data) != DMCU_DATA_SIZE) {
+        error_setg(errp, "NP560+ data RAM is not initialized");
+        return false;
+    }
+    if (end < address || end > DMCU_DATA_SIZE ||
+        !((address >= 0x00004000u && end <= 0x00008000u) ||
+          (address >= 0x0000c000u && end <= 0x00010000u) ||
+          address >= 0x00500000u)) {
+        error_setg(errp, "NP560+ debug data range 0x%" PRIx64
+                   "..0x%" PRIx64 " is outside a diagnostic staging window "
+                   "or writable external RAM",
+                   address, end);
+        return false;
+    }
+    return true;
+}
+
+static bool np560_parse_debug_address(const char *value, const char **payload,
+                                      uint64_t *address, Error **errp)
+{
+    const char *separator = strchr(value, '@');
+    g_autofree char *address_text = NULL;
+    char *end = NULL;
+
+    if (!separator || separator == value || !separator[1]) {
+        error_setg(errp, "NP560+ debug data request must use ADDRESS@PAYLOAD");
+        return false;
+    }
+    address_text = g_strndup(value, separator - value);
+    *address = g_ascii_strtoull(address_text, &end, 0);
+    if (!end || *end) {
+        error_setg(errp, "Invalid NP560+ debug data address '%s'", address_text);
+        return false;
+    }
+    *payload = separator + 1;
+    return true;
+}
