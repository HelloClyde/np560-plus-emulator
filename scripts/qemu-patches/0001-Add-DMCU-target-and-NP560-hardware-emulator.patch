+static void np560_load_nand_image(NP560MachineState *s)
+{
+    static const uint8_t checkpoint_magic[8] = {
+        'N', 'P', '5', '6', '0', 'N', '1', 0
+    };
+    NP560NANDState *nand = &s->nand;
+    g_autofree char *filename = NULL;
+    g_autofree gchar *image = NULL;
+    g_autoptr(GError) gerror = NULL;
+    gsize image_size = 0;
+    const uint8_t *payload;
+    gsize payload_size;
+
+    nand->data = g_malloc(NP560_NAND_DATA_SIZE);
+    nand->oob = g_malloc(NP560_NAND_OOB_SIZE);
+    memset(nand->data, 0xff, NP560_NAND_DATA_SIZE);
+    memset(nand->oob, 0xff, NP560_NAND_OOB_SIZE);
+    nand->image_bytes = 0;
+    nand->stripped_maskrom_header = false;
+    nand->restored_checkpoint = false;
+
+    if (s->nand_image && *s->nand_image &&
+        s->nand_checkpoint && *s->nand_checkpoint) {
+        error_report("NP560+ nand-image and nand-checkpoint are mutually exclusive");
+        exit(EXIT_FAILURE);
+    }
+
+    if (s->nand_checkpoint && *s->nand_checkpoint) {
+        const size_t expected_size = NP560_NAND_CHECKPOINT_HEADER_SIZE +
+                                     NP560_NAND_DATA_SIZE +
+                                     NP560_NAND_OOB_SIZE;
+        uint32_t data_hash;
+        uint32_t oob_hash;
+
+        filename = qemu_find_file(QEMU_FILE_TYPE_BIOS, s->nand_checkpoint);
+        if (!filename) {
+            error_report("Unable to find NP560+ NAND checkpoint '%s'",
+                         s->nand_checkpoint);
+            exit(EXIT_FAILURE);
+        }
+        if (!g_file_get_contents(filename, &image, &image_size, &gerror)) {
+            error_report("Unable to load NP560+ NAND checkpoint '%s': %s",
+                         filename, gerror->message);
+            exit(EXIT_FAILURE);
+        }
+        if (image_size != expected_size ||
+            memcmp(image, checkpoint_magic, sizeof(checkpoint_magic)) ||
+            ldl_le_p(image + 8) != NP560_NAND_CHECKPOINT_VERSION ||
+            ldl_le_p(image + 12) != NP560_NAND_CHECKPOINT_HEADER_SIZE ||
+            ldl_le_p(image + 16) != NP560_NAND_PAGE_DATA ||
+            ldl_le_p(image + 20) != NP560_NAND_PAGE_OOB ||
+            ldl_le_p(image + 24) != NP560_NAND_PAGES_PER_BLOCK ||
+            ldl_le_p(image + 28) != NP560_NAND_BLOCKS ||
+            ldq_le_p(image + 32) != NP560_NAND_DATA_SIZE ||
+            ldq_le_p(image + 40) != NP560_NAND_OOB_SIZE) {
+            error_report("NP560+ NAND checkpoint '%s' has an incompatible "
+                         "header or size", filename);
+            exit(EXIT_FAILURE);
+        }
+        data_hash = np560_nand_trace_hash(
+            (const uint8_t *)image + NP560_NAND_CHECKPOINT_HEADER_SIZE,
+            NP560_NAND_DATA_SIZE);
+        oob_hash = np560_nand_trace_hash(
+            (const uint8_t *)image + NP560_NAND_CHECKPOINT_HEADER_SIZE +
+            NP560_NAND_DATA_SIZE, NP560_NAND_OOB_SIZE);
+        if (data_hash != ldl_le_p(image + 48) ||
+            oob_hash != ldl_le_p(image + 52)) {
+            error_report("NP560+ NAND checkpoint '%s' failed its checksum",
+                         filename);
+            exit(EXIT_FAILURE);
+        }
+        memcpy(nand->data,
+               image + NP560_NAND_CHECKPOINT_HEADER_SIZE,
+               NP560_NAND_DATA_SIZE);
+        memcpy(nand->oob,
+               image + NP560_NAND_CHECKPOINT_HEADER_SIZE +
+               NP560_NAND_DATA_SIZE, NP560_NAND_OOB_SIZE);
+        nand->image_bytes = NP560_NAND_DATA_SIZE;
+        nand->restored_checkpoint = true;
+        return;
+    }
+
+    if (!s->nand_image || !*s->nand_image) {
+        return;
+    }
+    filename = qemu_find_file(QEMU_FILE_TYPE_BIOS, s->nand_image);
+    if (!filename) {
+        error_report("Unable to find NP560+ NAND image '%s'", s->nand_image);
+        exit(EXIT_FAILURE);
+    }
+    if (!g_file_get_contents(filename, &image, &image_size, &gerror)) {
+        error_report("Unable to load NP560+ NAND image '%s': %s", filename,
+                     gerror->message);
+        exit(EXIT_FAILURE);
+    }
+    payload = (const uint8_t *)image;
+    payload_size = image_size;
+    if (payload_size >= NP560_MASKROM_HEADER_SIZE &&
+        !memcmp(payload, "MASKROM", 7)) {
+        payload += NP560_MASKROM_HEADER_SIZE;
+        payload_size -= NP560_MASKROM_HEADER_SIZE;
+        nand->stripped_maskrom_header = true;
+    }
+    if (payload_size > NP560_NAND_DATA_SIZE) {
+        error_report("NP560+ logical NAND image '%s' is 0x%zx bytes after "
+                     "its package header; maximum is 0x%zx", filename,
+                     payload_size, NP560_NAND_DATA_SIZE);
+        exit(EXIT_FAILURE);
+    }
+    memcpy(nand->data, payload, payload_size);
+    nand->image_bytes = payload_size;
+}
+
+static char *np560_get_cpu_state(Object *obj, Error **errp)
+{
+    NP560MachineState *s = NP560_MACHINE(obj);
+    CPUDMCUState *env;
+    GString *text;
+    int i;
+
+    if (!s->cpu) {
+        return g_strdup("CPU is not initialized");
+    }
+    env = &s->cpu->env;
+    text = g_string_new(NULL);
+    g_string_append_printf(text,
+        "PC=%02x:%04x  PSW=%c%c%c%c  DS0=%03x DS1=%03x\n",
+        dmcu_code_segment(env->pc), dmcu_code_pc(env->pc),
+        env->psw & DMCU_PSW_Z ? 'Z' : '-',
+        env->psw & DMCU_PSW_C ? 'C' : '-',
+        env->psw & DMCU_PSW_N ? 'N' : '-',
+        env->psw & DMCU_PSW_V ? 'V' : '-',
+        env->sfr[DMCU_SFR_DS0] & 0x1ff,
+        env->sfr[DMCU_SFR_DS1] & 0x1ff);
+    for (i = 0; i < 16; i++) {
+        g_string_append_printf(text, "R%-2d=%04x%s", i,
+                               env->gpr[i] & 0xffff,
+                               (i & 3) == 3 ? "\n" : "  ");
+    }
+    {
+        uint16_t fp = env->gpr[DMCU_FP] & 0xffff;
+        unsigned frame;
+
+        g_string_append_printf(text, "STACK_CHAIN=sp%04x",
+                               env->gpr[DMCU_SP] & 0xffff);
+        for (frame = 0; frame < 8 && fp; frame++) {
+            uint16_t parent = lduw_le_p(s->cpu->internal_data + fp);
+            uint16_t cs = lduw_le_p(
+                s->cpu->internal_data + ((fp + 2) & 0xffff));
+            uint16_t pc = lduw_le_p(
+                s->cpu->internal_data + ((fp + 4) & 0xffff));
+            uint16_t arg0 = lduw_le_p(
+                s->cpu->internal_data + ((fp + 6) & 0xffff));
+            uint16_t arg1 = lduw_le_p(
+                s->cpu->internal_data + ((fp + 8) & 0xffff));
+            uint16_t arg2 = lduw_le_p(
+                s->cpu->internal_data + ((fp + 10) & 0xffff));
+
+            g_string_append_printf(text,
+                                   "%sfp%04x>%02x:%04x/a%04x,%04x,%04x",
+                                   frame ? "," : " ", fp, cs & 0xff, pc,
+                                   arg0, arg1, arg2);
+            if ((cs & 0xff) == 0x28 && pc == 0x9578) {
+                uint16_t outer = lduw_le_p(
+                    s->cpu->internal_data + ((fp - 4) & 0xffff));
+                uint16_t inner = lduw_le_p(
+                    s->cpu->internal_data + ((fp - 2) & 0xffff));
+
+                g_string_append_printf(text, "/scan%04x,%04x", outer, inner);
+            }
+            if (!parent || parent == fp) {
+                break;
+            }
+            fp = parent;
+        }
+        g_string_append_c(text, '\n');
+    }
+    g_string_append_printf(
+        text,
+        "KEY_STATE=%08x  KEY_CODE=%08x KEY_MATRIX=%08x:%08x",
+        env->web_key_state, env->web_key_code,
+        env->web_matrix_state_high, env->web_matrix_state_low);
+    g_string_append_printf(text,
+        "  KEY_GPIO=%04x KEYBOARD_EVENTS=%" G_GUINT64_FORMAT " LAST=%04x",
+        np560_keyboard_gpio_state(env->web_key_state),
+        s->keyboard.events_read, s->keyboard.last_event);
+    g_string_append_printf(
+        text,
+        " F010_READS=%" G_GUINT64_FORMAT
+        " WRITES=%" G_GUINT64_FORMAT " LAST_WRITE=%04x@%02x:%04x",
+        s->keyboard.gpio_reads, s->keyboard.gpio_writes,
+        s->keyboard.gpio_last_write,
+        dmcu_code_segment(s->keyboard.gpio_last_write_pc),
+        dmcu_code_pc(s->keyboard.gpio_last_write_pc));
+    g_string_append_printf(
+        text,
+        " F340_READS=%" G_GUINT64_FORMAT " EVENTS=%" G_GUINT64_FORMAT
+        " LAST_PC=%02x:%04x",
+        s->keyboard.latch_reads, s->keyboard.latch_events,
+        dmcu_code_segment(s->keyboard.latch_last_pc),
+        dmcu_code_pc(s->keyboard.latch_last_pc));
+    if (s->keyboard.trace_index) {
+        uint32_t count = MIN(s->keyboard.trace_index,
+                             (uint32_t)NP560_KEYBOARD_TRACE);
+        uint32_t start = s->keyboard.trace_index - count;
+        uint32_t trace;
+
+        g_string_append(text, "\nF010_TRACE=");
+        for (trace = start; trace < s->keyboard.trace_index; trace++) {
+            uint32_t slot = trace % NP560_KEYBOARD_TRACE;
+            uint32_t pc = s->keyboard.trace_pc[slot];
+
+            g_string_append_printf(
+                text, "%s%02x:%04x/%04x", trace == start ? "" : ",",
+                dmcu_code_segment(pc), dmcu_code_pc(pc),
+                s->keyboard.trace_value[slot]);
+        }
+    } else {
+        g_string_append(text, "\nF010_TRACE=none");
+    }
+    g_string_append_printf(
+        text,
+        "\nIRQ64=ENABLED:%u TICKS:%" G_GUINT64_FORMAT
+        " REQUESTS:%" G_GUINT64_FORMAT " ENTRIES:%u RETURNS:%u DEFER:%u"
+        " LAST_IN:%02x:%04x/sp%04x LAST_OUT:%02x:%04x>%02x:%04x/sp%04x"
+        " BAD:%u@%02x:%04x/sp%04x<%02x:%04x/sp%04x"
+        "=>%02x:%04x/fsp%04x/base%04x"
+        " F100:%04x F160:%04x F164:%04x MATRIX_READS:%" G_GUINT64_FORMAT
+        " MATRIX_WRITES:%" G_GUINT64_FORMAT
+        " ACTIVE:%" G_GUINT64_FORMAT "@%02x:%04x/%04x>%04x",
+        s->timer.irq_enabled, s->timer.irq_ticks, s->timer.irq_requests,
+        env->interrupt_entries, env->interrupt_returns,
+        env->interrupt_frame_overlap_deferrals,
+        dmcu_code_segment(env->interrupt_last_entry_pc),
+        dmcu_code_pc(env->interrupt_last_entry_pc),
+        env->interrupt_last_entry_sp & 0xffff,
+        dmcu_code_segment(env->interrupt_last_return_from),
+        dmcu_code_pc(env->interrupt_last_return_from),
+        dmcu_code_segment(env->interrupt_last_return_pc),
+        dmcu_code_pc(env->interrupt_last_return_pc),
+        env->interrupt_last_return_sp & 0xffff,
+        env->interrupt_bad_returns,
+        dmcu_code_segment(env->interrupt_first_bad_from),
