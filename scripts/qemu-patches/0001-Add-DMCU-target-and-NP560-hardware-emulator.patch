+}
+
+static void np560_set_debug_data_save(Object *obj, const char *value,
+                                      Error **errp)
+{
+    NP560MachineState *s = NP560_MACHINE(obj);
+    const char *separator;
+    const char *range_separator;
+    const char *path;
+    g_autofree char *address_text = NULL;
+    g_autofree char *size_text = NULL;
+    char *end = NULL;
+    uint64_t address;
+    uint64_t size;
+    g_autoptr(GError) gerror = NULL;
+
+    if (!value || !*value) {
+        g_clear_pointer(&s->debug_data_save, g_free);
+        return;
+    }
+    separator = strchr(value, '@');
+    range_separator = strchr(value, ':');
+    if (!separator || !range_separator || range_separator >= separator ||
+        range_separator == value || range_separator + 1 == separator ||
+        !separator[1]) {
+        error_setg(errp, "NP560+ debug data save must use ADDRESS:SIZE@FILE");
+        return;
+    }
+    address_text = g_strndup(value, range_separator - value);
+    size_text = g_strndup(range_separator + 1,
+                          separator - range_separator - 1);
+    address = g_ascii_strtoull(address_text, &end, 0);
+    if (!end || *end) {
+        error_setg(errp, "Invalid NP560+ debug data address '%s'", address_text);
+        return;
+    }
+    size = g_ascii_strtoull(size_text, &end, 0);
+    if (!end || *end || !size || size > DMCU_DATA_SIZE ||
+        address > DMCU_DATA_SIZE - size) {
+        error_setg(errp, "Invalid NP560+ debug data size/range '%s:%s'",
+                   address_text, size_text);
+        return;
+    }
+    if (!s->cpu || memory_region_size(&s->data) != DMCU_DATA_SIZE) {
+        error_setg(errp, "NP560+ data RAM is not initialized");
+        return;
+    }
+    path = separator + 1;
+    if (!g_file_set_contents(path,
+                             memory_region_get_ram_ptr(&s->data) + address,
+                             size, &gerror)) {
+        error_setg(errp, "Unable to save NP560+ debug data '%s': %s",
+                   path, gerror->message);
+        return;
+    }
+    g_free(s->debug_data_save);
+    s->debug_data_save = g_strdup(value);
+}
