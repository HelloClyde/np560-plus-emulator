+/*
+ * F010 is a combined board-input word, not a plain five-bit GPIO register.
+ * The shipped PRG tests its low nibble for the active storage unit (4 is the
+ * internal NP560+ medium).  The exact 31:D9AA routine called once per resident
+ * dispatcher pass samples 0010/0020/0040/0080/0800, matching the product's
+ * documented five-way navigation key.  Other code compares 4xxx/8xxx values,
+ * but there is not yet evidence that those high bits mean key release/press;
+ * do not synthesize them.  The private F340 latch remains only for obsolete
+ * segment-03 diagnostics and is not used by the strict resident scheduler.
+ */
+static void np560_keyboard_reset(void *opaque)
+{
+    NP560MachineState *s = opaque;
+
+    memset(&s->keyboard, 0, sizeof(s->keyboard));
+    s->keyboard.matrix_drive = 0xffff;
+    if (s->cpu) {
+        s->cpu->env.web_key_state = 0;
+        s->cpu->env.web_key_code = 0;
+        s->cpu->env.web_matrix_state_low = 0;
+        s->cpu->env.web_matrix_state_high = 0;
+    }
+}
+
+static uint16_t np560_keyboard_event(uint32_t raw)
+{
+    switch (raw) {
+    case 0x100: /* up */
+    case 0x10c: /* page up */
+        return 0x0082;
+    case 0x101: /* down */
+    case 0x107: /* tab */
+    case 0x10d: /* page down */
+        return 0x0083;
+    case 0x102: /* left */
+    case 0x105: /* escape */
+    case 0x106: /* backspace */
+        return 0x0084;
+    case 0x103: /* right */
+    case 0x104: /* enter */
+        return 0x0085;
+    default:
+        return raw & 0xffff;
+    }
+}
+
+static uint16_t np560_keyboard_key_bits(uint32_t keys)
+{
+    /* Web key-state bits: Up, Down, Left, Right, Enter, in the order sampled
+     * by the exact five-input 31:D9AA resident activity scanner. */
+    if (keys & (1u << 0)) {
+        return 0x0010;
+    }
+    if (keys & (1u << 1)) {
+        return 0x0020;
+    }
+    if (keys & (1u << 2)) {
+        return 0x0040;
+    }
+    if (keys & (1u << 3)) {
+        return 0x0080;
+    }
+    if (keys & (1u << 4)) {
+        return 0x0800;
+    }
+    return 0;
+}
+
+static uint16_t np560_keyboard_gpio_state(uint32_t keys)
+{
+    uint16_t key_bits = np560_keyboard_key_bits(keys);
+
+    /* 0004 is the evidenced idle/internal-storage selector. */
+    return 0x0004 | key_bits;
+}
+
+static uint16_t np560_keyboard_gpio_event(uint16_t state)
+{
+    switch (state & 0x0ff0) {
+    case 0x0010:
+        return 0x0082;
+    case 0x0020:
+        return 0x0083;
+    case 0x0040:
+        return 0x0084;
+    case 0x0080:
+    case 0x0800:
+        return 0x0085;
+    default:
+        return 0;
+    }
+}
+
+static uint64_t np560_keyboard_gpio_read(void *opaque, hwaddr offset,
+                                         unsigned size)
+{
+    NP560MachineState *s = opaque;
+    CPUDMCUState *env = &s->cpu->env;
+    uint16_t key_bits = np560_keyboard_key_bits(env->web_key_state);
+    uint16_t state;
+
+    /* Count a physical assertion once, even though the guest samples F010
+     * repeatedly.  The idle storage selector (0004) is not a key event. */
+    if (key_bits != s->keyboard.last_gpio_state) {
+        if (key_bits) {
+            uint16_t event = np560_keyboard_event(env->web_key_code);
+
+            if (!event) {
+                event = np560_keyboard_gpio_event(key_bits);
+            }
+            s->keyboard.last_event = event;
+            s->keyboard.events_read++;
+        }
+        s->keyboard.last_gpio_state = key_bits;
+    }
+    state = np560_keyboard_gpio_state(env->web_key_state);
+    s->keyboard.gpio_reads++;
+    if (state != 0x0004) {
+        uint32_t slot = s->keyboard.trace_index++ % NP560_KEYBOARD_TRACE;
+
+        s->keyboard.trace_pc[slot] = env->pc & 0x00ffffffu;
+        s->keyboard.trace_value[slot] = state;
+    }
+    return state;
+}
+
+static void np560_keyboard_gpio_write(void *opaque, hwaddr offset,
+                                      uint64_t value, unsigned size)
+{
+    NP560MachineState *s = opaque;
+
+    /* The strict application also reaches F010 through a banked data
+     * mapping.  The available firmware proves that writes are accepted, but
+     * not yet which output/configuration bits are externally observable.
+     * Preserve that evidence without changing the input pins returned by
+     * the read path.  Supplying a write callback is also required by QEMU's
+     * MMIO dispatch; a read-only MemoryRegionOps would call a null handler. */
+    s->keyboard.gpio_writes++;
+    s->keyboard.gpio_last_write = value & 0xffff;
+    s->keyboard.gpio_last_write_pc = s->cpu->env.pc & 0x00ffffffu;
+}
+
+static const MemoryRegionOps np560_keyboard_gpio_ops = {
+    .read = np560_keyboard_gpio_read,
+    .write = np560_keyboard_gpio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 2,
+        .max_access_size = 2,
+    },
+    .impl = {
+        .min_access_size = 2,
+        .max_access_size = 2,
+    },
+};
+
+/* F100 bit 15 enables the 64-Hz system interrupt used by the exact 08:40D0
+ * vector.  Application startup writes A082 after installing callback
+ * 27:E528.  Keeping the enable in the device contract prevents timer IRQs
+ * from reaching an uninitialised overlay during reset/loader execution. */
+static uint64_t np560_system_control_read(void *opaque, hwaddr offset,
+                                         unsigned size)
+{
+    NP560MachineState *s = opaque;
+
+    return s->keyboard.system_control;
+}
+
+static void np560_system_control_write(void *opaque, hwaddr offset,
+                                       uint64_t value, unsigned size)
+{
+    NP560MachineState *s = opaque;
+    CPUDMCUState *env = &s->cpu->env;
+    uint32_t trace = s->keyboard.system_control_trace_index++;
+    uint32_t slot = trace % NP560_SYSTEM_CONTROL_TRACE;
+
+    /*
+     * Keep a bounded, observer-only history while the F100 contract is being
+     * reconstructed.  MMIO helpers run after the instruction decoder has
+     * advanced env->pc, so retain current_instruction_pc as the writer and
+     * env->pc as its fall-through address.  The write itself is never
+     * suppressed or changed by this diagnostic.
+     */
+    s->keyboard.system_control_trace_pc[slot] =
+        env->current_instruction_pc & 0x00ffffffu;
+    s->keyboard.system_control_trace_next_pc[slot] =
+        env->pc & 0x00ffffffu;
+    s->keyboard.system_control_trace_old[slot] =
+        s->keyboard.system_control;
+    s->keyboard.system_control_trace_new[slot] = value;
+    s->keyboard.system_control_trace_ds0[slot] =
+        env->sfr[DMCU_SFR_DS0] & 0x1ff;
+    s->keyboard.system_control_trace_ds1[slot] =
+        env->sfr[DMCU_SFR_DS1] & 0x1ff;
+    s->keyboard.system_control_trace_in_interrupt[slot] = env->in_interrupt;
+
+    s->keyboard.system_control = value;
+    s->timer.irq_enabled = (value & 0x8000) != 0;
+}
+
+static const MemoryRegionOps np560_system_control_ops = {
+    .read = np560_system_control_read,
+    .write = np560_system_control_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 2,
+        .max_access_size = 2,
+    },
+    .impl = {
+        .min_access_size = 2,
+        .max_access_size = 2,
+    },
+};
+
+static uint16_t np560_key_matrix_input(const NP560MachineState *s,
+                                       uint16_t drive)
+{
+    const CPUDMCUState *env = &s->cpu->env;
+    static const uint16_t row_masks[8] = {
+        0x0004, 0x0008, 0x0010, 0x0020,
+        0x0040, 0x0080, 0x4000, 0x8000,
+    };
+    uint64_t matrix = ((uint64_t)env->web_matrix_state_high << 32) |
+                      env->web_matrix_state_low;
+    uint32_t keys = env->web_key_state;
+    /* F160 is a mixed GPIO input register, not just the eight active-low
+     * keyboard columns.  The application power worker at 22:F40C tests
+     * bit 12 to clear its low-power/error latch, while the exact matrix
+     * scanner at 2E:5F28 masks the same register with 00FF before decoding
+     * columns.  Model bit 12 as the external-power/charger input instead of
+     * discarding it or assuming a fixed board state. */
+    uint16_t input = 0x00ff | (s->external_power ? 0x1000 : 0);
+    unsigned index;
+
+    /* 50:5416 supplies the eight F164 row strobes and 50:5426 the eight
+     * active-low F160 column masks used by exact scanner 2E:5F28.  The raw
+     * index is column * 8 + row.  Explicit 64-bit Web matrix state exposes
+     * every evidenced position; retain the older navigation aliases so QMP
+     * clients that only set key-state remain compatible. */
+    if (keys & ((1u << 0) | (1u << 12))) {             /* up: index 61 */
+        matrix |= 1ull << 61;
+    }
+    if (keys & ((1u << 1) | (1u << 7) |
+                (1u << 13))) {                         /* down: index 37 */
+        matrix |= 1ull << 37;
+    }
+    if (keys & ((1u << 2) | (1u << 5) |
+                (1u << 6))) {                          /* back: index 28 */
+        matrix |= 1ull << 28;
+    }
+    if (keys & ((1u << 3) | (1u << 4))) {             /* enter: index 20 */
+        matrix |= 1ull << 20;
+    }
+    /* 2E:5F28 first raises the matrix bank with OR C0FC, then clears one
+     * strobe bit through AND ~row before reading F160.  Selected rows are
+     * therefore active-low.  Combine columns when multiple keys in the same
+     * selected row are held, matching a passive keyboard matrix. */
+    for (index = 0; index < 64; index++) {
+        uint16_t row = row_masks[index & 7];
+        uint16_t column = 1u << (index >> 3);
+
+        if ((matrix & (1ull << index)) && !(drive & row)) {
+            input &= ~column;
+        }
+    }
+    return input;
+}
+
+static uint64_t np560_key_matrix_read(void *opaque, hwaddr offset,
+                                      unsigned size)
+{
+    NP560MachineState *s = opaque;
+    uint16_t input;
+
+    s->keyboard.matrix_reads++;
+    switch (offset) {
+    case 0x00:
+        input = np560_key_matrix_input(s, s->keyboard.matrix_drive);
+        if ((input & 0x00ff) != 0x00ff) {
+            s->keyboard.matrix_active_reads++;
+            s->keyboard.matrix_last_active_drive = s->keyboard.matrix_drive;
+            s->keyboard.matrix_last_active_input = input;
+            s->keyboard.matrix_last_active_pc = s->cpu->env.pc & 0xffffff;
+        }
+        return input;
+    case 0x04:
+        return s->keyboard.matrix_drive;
+    default:
+        return 0;
+    }
+}
+
+static void np560_key_matrix_write(void *opaque, hwaddr offset,
+                                   uint64_t value, unsigned size)
+{
+    NP560MachineState *s = opaque;
+
+    s->keyboard.matrix_writes++;
+    if (offset == 0x04) {
+        uint32_t slot = s->keyboard.matrix_trace_index++ %
+                        NP560_MATRIX_TRACE;
+
+        s->keyboard.matrix_drive = value;
+        s->keyboard.matrix_trace_value[slot] = value;
+        s->keyboard.matrix_trace_pc[slot] = s->cpu->env.pc & 0xffffff;
+    }
+}
+
+static const MemoryRegionOps np560_key_matrix_ops = {
+    .read = np560_key_matrix_read,
+    .write = np560_key_matrix_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 2,
+        .max_access_size = 2,
+    },
+    .impl = {
+        .min_access_size = 2,
+        .max_access_size = 2,
+    },
+};
+
+static uint64_t np560_keyboard_read(void *opaque, hwaddr offset,
+                                    unsigned size)
+{
+    NP560MachineState *s = opaque;
+    CPUDMCUState *env = &s->cpu->env;
+    uint16_t event;
+
+    switch (offset) {
+    case 0x00:
+        s->keyboard.latch_reads++;
+        s->keyboard.latch_last_pc = env->pc & 0x00ffffffu;
+        event = np560_keyboard_event(env->web_key_code);
+        if (event) {
+            s->keyboard.last_event = event;
+            s->keyboard.events_read++;
+            s->keyboard.latch_events++;
+            env->web_key_code = 0;
+        }
+        return event;
+    case 0x02:
+        return env->web_key_state & 0xffff;
+    case 0x04:
+        return env->web_key_state >> 16;
+    case 0x06:
+        return env->web_key_code & 0xffff;
+    default:
+        return 0;
+    }
+}
+
+static void np560_keyboard_write(void *opaque, hwaddr offset, uint64_t value,
+                                 unsigned size)
+{
+    NP560MachineState *s = opaque;
+
+    if (offset == 0x00 && value == 0) {
+        s->cpu->env.web_key_code = 0;
+    }
+}
+
+static const MemoryRegionOps np560_keyboard_ops = {
+    .read = np560_keyboard_read,
+    .write = np560_keyboard_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 2,
+        .max_access_size = 2,
+    },
+    .impl = {
+        .min_access_size = 2,
+        .max_access_size = 2,
+    },
+};
+
+static void np560_st7529_reset(void *opaque)
+{
+    NP560MachineState *s = opaque;
+    NP560ST7529State *lcd = &s->lcd;
+
+    memset(lcd, 0, sizeof(*lcd));
+    lcd->column_end = NP560_ST7529_RAM_COLUMNS - 1;
+    lcd->line_end = NP560_ST7529_RAM_LINES - 1;
+    lcd->display_lines = 4;
+    lcd->sleeping = true;
+}
+
+static uint8_t np560_st7529_parameter_count(uint8_t command)
+{
+    switch (command) {
+    case 0x15: /* CASET */
+    case 0x75: /* LASET */
+    case 0x81: /* VOLCTRL */
+    case 0xa8: /* PTLIN */
+        return 2;
+    case 0xbc: /* DATSDR */
+    case 0xca: /* DISCTRL */
+        return 3;
+    case 0x20: /* PWRCTRL */
+    case 0xab: /* SCSTART */
+    case 0xbb: /* COMSCN */
+    case 0xcd: /* EPCTL */
+        return 1;
+    case 0xaa: /* ASCSET */
+        return 4;
+    default:
+        return 0;
+    }
+}
+
+static void np560_st7529_apply_parameters(NP560ST7529State *lcd)
+{
+    switch (lcd->command) {
+    case 0x15: /* Column addresses select groups of three SEG pixels. */
+        lcd->column_start = MIN(lcd->parameters[0],
+                                NP560_ST7529_RAM_COLUMNS - 1);
+        lcd->column_end = MIN(lcd->parameters[1],
+                              NP560_ST7529_RAM_COLUMNS - 1);
+        if (lcd->column_end < lcd->column_start) {
+            lcd->column_end = lcd->column_start;
+        }
+        break;
+    case 0x75:
+        lcd->line_start = MIN(lcd->parameters[0],
+                              NP560_ST7529_RAM_LINES - 1);
+        lcd->line_end = MIN(lcd->parameters[1],
+                            NP560_ST7529_RAM_LINES - 1);
+        if (lcd->line_end < lcd->line_start) {
+            lcd->line_end = lcd->line_start;
+        }
+        break;
+    case 0xbc:
+        memcpy(lcd->scan, lcd->parameters, sizeof(lcd->scan));
+        break;
+    case 0xbb:
+        lcd->com_scan = lcd->parameters[0] & 7;
+        break;
+    case 0xca:
+        lcd->display_lines = MIN(
+            ((lcd->parameters[1] & 0x3f) + 1u) * 4u,
+            NP560_ST7529_RAM_LINES);
+        break;
+    case 0xa8:
+        lcd->partial_start = lcd->parameters[0] & 0x3f;
+        lcd->partial_end = lcd->parameters[1] & 0x3f;
+        lcd->partial_display = true;
+        break;
+    case 0xaa:
+        memcpy(lcd->area_scroll, lcd->parameters,
+               sizeof(lcd->area_scroll));
+        break;
+    case 0xab:
+        lcd->scroll_start = lcd->parameters[0] & 0x3f;
+        break;
+    default:
+        break;
+    }
+}
+
+static void np560_st7529_command(NP560ST7529State *lcd, uint8_t command)
+{
+    lcd->command = command;
+    lcd->command_writes++;
+    lcd->parameter_index = 0;
+    lcd->parameter_count = np560_st7529_parameter_count(command);
+    lcd->ram_write = false;
+    lcd->ram_read = false;
+
+    switch (command) {
+    case 0x30: /* EXT=0 */
+        lcd->extended = false;
+        break;
+    case 0x31: /* EXT=1 */
+        lcd->extended = true;
+        break;
+    case 0x5c: /* RAMWR */
+        lcd->column = lcd->column_start;
+        lcd->line = lcd->line_start;
+        lcd->pixel = 0;
+        lcd->ram_write = true;
+        break;
+    case 0x5d: /* RAMRD */
+        lcd->column = lcd->column_start;
+        lcd->line = lcd->line_start;
+        lcd->pixel = 0;
+        lcd->ram_read = true;
+        break;
+    case 0x94: /* SLPOUT */
+        lcd->sleeping = false;
+        break;
+    case 0x95: /* SLPIN */
+        lcd->sleeping = true;
+        break;
+    case 0xa6: /* DISNOR */
+        lcd->inverse = false;
+        break;
+    case 0xa7: /* DISINV */
+        lcd->inverse = true;
+        break;
+    case 0xae: /* DISOFF */
+        lcd->display_on = false;
+        break;
+    case 0xaf: /* DISON */
+        lcd->display_on = true;
+        break;
+    case 0xa9: /* PTLOUT */
+        lcd->partial_display = false;
+        break;
+    default:
+        break;
+    }
+}
+
+static bool np560_st7529_advance(NP560ST7529State *lcd)
+{
+    bool wrapped = false;
+
+    lcd->pixel++;
+    if (lcd->pixel < NP560_ST7529_PIXELS_PER_COLUMN) {
+        return false;
+    }
+    lcd->pixel = 0;
+
+    /* DATSDR C/L=0 scans column groups first; C/L=1 scans lines first. */
+    if (!(lcd->scan[0] & 0x04)) {
+        if (lcd->column < lcd->column_end) {
+            lcd->column++;
+        } else {
+            lcd->column = lcd->column_start;
+            if (lcd->line < lcd->line_end) {
+                lcd->line++;
+            } else {
+                lcd->line = lcd->line_start;
+                wrapped = true;
+            }
+        }
+    } else if (lcd->line < lcd->line_end) {
+        lcd->line++;
+    } else {
+        lcd->line = lcd->line_start;
+        if (lcd->column < lcd->column_end) {
+            lcd->column++;
+        } else {
+            lcd->column = lcd->column_start;
+            wrapped = true;
+        }
+    }
+    if (wrapped) {
+        lcd->completed_frames++;
+    }
+    return wrapped;
+}
+
+static uint8_t np560_st7529_visible_level(const NP560ST7529State *lcd,
+                                          unsigned x, unsigned y)
+{
+    unsigned panel_y;
+    uint8_t level;
+
+    /*
+     * The NP560+ glass crosses the ST7529's two 80-COM banks: physical rows
+     * 0..59 are bonded to the second bank in forward pin order, while rows
+     * 60..119 are bonded to the first bank in reverse pin order.  Model that
+     * fixed module wiring before applying COMSCN.  CD1 reverses the first
+     * controller half, CD0 reverses the second, and CD2 exchanges the halves.
+     *
+     * V3.80 programs COMSCN=001.  Combined with the module wiring, visible
+     * rows 0..119 therefore read GRAM lines 139..20.  That global bottom-up
+     * order is also independently visible in the exact 18:6454 font blitter:
+     * each successive glyph row subtracts 0x3c framebuffer words.  Treating
+     * the glass as two normally wired banks made only the lower text upright
+     * and left the upper text vertically mirrored.
+     */
+    panel_y = y < DMCU_LCD_HEIGHT / 2 ?
+        y + DMCU_LCD_HEIGHT / 2 : DMCU_LCD_HEIGHT - 1 - y;
+    if (lcd->com_scan & 4) {
+        panel_y = (panel_y + DMCU_LCD_HEIGHT / 2) % DMCU_LCD_HEIGHT;
+    }
+    if (panel_y < DMCU_LCD_HEIGHT / 2) {
+        if (lcd->com_scan & 2) {
+            panel_y = DMCU_LCD_HEIGHT / 2 - 1 - panel_y;
+        }
+    } else if (lcd->com_scan & 1) {
+        panel_y = DMCU_LCD_HEIGHT + DMCU_LCD_HEIGHT / 2 - 1 - panel_y;
+    }
+    level = lcd->gram[panel_y + NP560_LCD_VISIBLE_LINE][x] & 0x1f;
+
+    if (!lcd->display_on || lcd->sleeping) {
+        return 0;
+    }
+    return lcd->inverse ? 0x1f - level : level;
+}
+
+static void np560_st7529_record_frame(NP560MachineState *s)
+{
+    NP560ST7529State *lcd = &s->lcd;
+    uint64_t sequence = lcd->completed_frames;
+    unsigned slot = (sequence - 1) % NP560_ST7529_FRAME_TRACE;
+    uint32_t hash = 2166136261u;
+    uint32_t levels = 0;
+    uint8_t *data = memory_region_get_ram_ptr(&s->data);
+    uint16_t fp = s->cpu->env.gpr[DMCU_FP] & 0xffff;
+    uint16_t parent_fp = lduw_le_p(data + fp);
+    uint16_t caller_cs = lduw_le_p(data + ((fp + 2) & 0xffff));
+    uint16_t caller_pc = lduw_le_p(data + ((fp + 4) & 0xffff));
+    uint16_t parent_cs = lduw_le_p(data + ((parent_fp + 2) & 0xffff));
+    uint16_t parent_pc = lduw_le_p(data + ((parent_fp + 4) & 0xffff));
+    unsigned x, y;
+
+    for (y = 0; y < DMCU_LCD_HEIGHT; y++) {
+        for (x = 0; x < DMCU_LCD_WIDTH; x++) {
+            uint8_t level = np560_st7529_visible_level(lcd, x, y);
+
+            levels |= UINT32_C(1) << level;
+            hash = (hash ^ level) * UINT32_C(16777619);
+        }
+    }
+    lcd->frame_sequence[slot] = sequence;
+    lcd->frame_data_writes[slot] = lcd->data_writes;
+    lcd->frame_pc[slot] = s->cpu->env.pc;
+    lcd->frame_caller[slot] = ((caller_cs & 0xff) << 16) | caller_pc;
+    lcd->frame_parent[slot] = ((parent_cs & 0xff) << 16) | parent_pc;
+    lcd->frame_hash[slot] = hash;
+    lcd->frame_levels[slot] = levels;
+    for (x = 0; x < 3; x++) {
+        lcd->frame_args[slot][x] =
+            lduw_le_p(data + ((fp + 6 + x * 2) & 0xffff));
+    }
+    lcd->frame_ds0[slot] = s->cpu->env.sfr[DMCU_SFR_DS0] & 0x1ff;
+}
+
+static void np560_st7529_data_write(NP560MachineState *s, uint8_t value)
+{
+    NP560ST7529State *lcd = &s->lcd;
+
+    lcd->data_writes++;
+    if (lcd->parameter_index < lcd->parameter_count) {
+        lcd->parameters[lcd->parameter_index++] = value;
+        if (lcd->parameter_index == lcd->parameter_count) {
+            np560_st7529_apply_parameters(lcd);
+        }
+        return;
+    }
+    if (lcd->ram_write) {
+        unsigned pixel = lcd->pixel;
+        unsigned x;
+
+        if (lcd->scan[1] & 1) { /* CLR reverses P1/P2/P3 in each group. */
+            pixel = NP560_ST7529_PIXELS_PER_COLUMN - 1 - pixel;
+        }
+        x = lcd->column * NP560_ST7529_PIXELS_PER_COLUMN + pixel;
+        if (lcd->line < NP560_ST7529_RAM_LINES &&
+            x < NP560_ST7529_RAM_WIDTH) {
+            uint8_t level = value >> 3;
+
+            /* In 3-byte/3-pixel mode D7..D3 contain the 5-bit gray value. */
+            lcd->gram[lcd->line][x] = level;
+            if (lcd->line >= 140 && level) {
+                uint32_t slot = lcd->status_write_count %
+                                NP560_ST7529_STATUS_TRACE;
+                uint8_t *data = memory_region_get_ram_ptr(&s->data);
+                uint16_t fp = s->cpu->env.gpr[DMCU_FP] & 0xffff;
+                uint16_t parent_fp = lduw_le_p(data + fp);
+
+                lcd->status_write_pc[slot] =
+                    s->cpu->env.pc & 0x00ffffffu;
+                lcd->status_write_caller[slot] =
+                    ((lduw_le_p(data + ((fp + 2u) & 0xffff)) & 0xffu) << 16) |
+                    lduw_le_p(data + ((fp + 4u) & 0xffff));
+                lcd->status_write_parent[slot] =
+                    ((lduw_le_p(data + ((parent_fp + 2u) & 0xffff)) &
+                      0xffu) << 16) |
+                    lduw_le_p(data + ((parent_fp + 4u) & 0xffff));
+                lcd->status_write_x[slot] = x;
+                lcd->status_write_y[slot] = lcd->line;
+                lcd->status_write_level[slot] = level;
+                lcd->status_write_count++;
+            }
+        }
+        if (np560_st7529_advance(lcd)) {
+            np560_st7529_record_frame(s);
+        }
+    }
+}
+
+static uint8_t np560_st7529_data_read(NP560ST7529State *lcd)
+{
+    uint8_t value = 0;
+    unsigned pixel = lcd->pixel;
+    unsigned x;
+
+    if (!lcd->ram_read) {
+        return 0;
+    }
+    if (lcd->scan[1] & 1) {
+        pixel = NP560_ST7529_PIXELS_PER_COLUMN - 1 - pixel;
+    }
+    x = lcd->column * NP560_ST7529_PIXELS_PER_COLUMN + pixel;
+    if (lcd->line < NP560_ST7529_RAM_LINES &&
+        x < NP560_ST7529_RAM_WIDTH) {
+        value = lcd->gram[lcd->line][x] << 3;
+    }
+    np560_st7529_advance(lcd);
+    return value;
+}
+
+static uint64_t np560_st7529_read(void *opaque, hwaddr offset, unsigned size)
+{
+    NP560MachineState *s = opaque;
+
+    if ((offset & 2) != 0) {
+        return np560_st7529_data_read(&s->lcd);
+    }
+    return s->lcd.display_on ? 0x40 : 0;
+}
+
+static void np560_st7529_write(void *opaque, hwaddr offset, uint64_t value,
+                               unsigned size)
+{
+    NP560MachineState *s = opaque;
+
+    if ((offset & 2) != 0) {
+        np560_st7529_data_write(s, value);
+    } else {
+        np560_st7529_command(&s->lcd, value);
+    }
+}
+
+static const MemoryRegionOps np560_st7529_ops = {
+    .read = np560_st7529_read,
+    .write = np560_st7529_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 1,
+    },
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 1,
+    },
+};
+
+static char *np560_get_lcd_frame(Object *obj, Error **errp)
+{
+    NP560ST7529State *lcd = &NP560_MACHINE(obj)->lcd;
+    uint8_t frame[DMCU_LCD_WIDTH * DMCU_LCD_HEIGHT];
+    unsigned x, y;
+
+    for (y = 0; y < DMCU_LCD_HEIGHT; y++) {
+        for (x = 0; x < DMCU_LCD_WIDTH; x++) {
+            frame[y * DMCU_LCD_WIDTH + x] =
+                np560_st7529_visible_level(lcd, x, y);
+        }
+    }
+    return (char *)g_base64_encode(frame, sizeof(frame));
+}
+
+static char *np560_get_lcd_gram_frame(Object *obj, Error **errp)
+{
+    NP560ST7529State *lcd = &NP560_MACHINE(obj)->lcd;
+    uint8_t frame[DMCU_LCD_WIDTH * NP560_ST7529_RAM_LINES];
+    unsigned x;
+    unsigned y;
+
+    /* Observer-only controller-line view, before the NP560 glass wiring. */
+    for (y = 0; y < NP560_ST7529_RAM_LINES; y++) {
+        for (x = 0; x < DMCU_LCD_WIDTH; x++) {
+            uint8_t level = lcd->gram[y][x] & 0x1f;
+
+            if (!lcd->display_on || lcd->sleeping) {
+                level = 0;
+            } else if (lcd->inverse) {
+                level = 0x1f - level;
+            }
+            frame[y * DMCU_LCD_WIDTH + x] = level;
+        }
+    }
+    return (char *)g_base64_encode(frame, sizeof(frame));
+}
+
+static char *np560_get_lcd_annunciators(Object *obj, Error **errp)
+{
+    NP560ST7529State *lcd = &NP560_MACHINE(obj)->lcd;
+    uint8_t planes[NP560_LCD_ANNUNCIATOR_BYTES] = { 0 };
+    static const unsigned lines[NP560_LCD_ANNUNCIATOR_PLANES] = {
+        NP560_LCD_VISIBLE_LINE - 1,
+        NP560_LCD_VISIBLE_LINE + DMCU_LCD_HEIGHT,
+    };
+    unsigned plane;
+    unsigned x;
+
+    /*
+     * V3.80's exact resident 14:6E10 routine writes two 240-bit planes to
+     * controller lines 19 and 140.  Those lines surround the 20..139 raster
+     * window and drive the NP560's custom-glass status icons.  Export the
+     * resulting electrode levels in the firmware's original little-endian
+     * bit order.  This is a read-only view of LCD hardware state; icon names
+     * and battery state are deliberately not synthesized here.
+     */
+    if (lcd->display_on && !lcd->sleeping) {
+        for (plane = 0; plane < NP560_LCD_ANNUNCIATOR_PLANES; plane++) {
+            for (x = 0; x < DMCU_LCD_WIDTH; x++) {
+                bool active = (lcd->gram[lines[plane]][x] & 0x1f) != 0;
+
+                /*
+                 * DATSDR/INV selects dot-matrix optical polarity; it does
+                 * not turn every unselected custom-glass electrode into a
+                 * status icon.  V3.80 uses nonzero level 30 as the explicit
+                 * annunciator selection value, so retain that logical state.
+                 */
+                if (active) {
+                    planes[plane * NP560_LCD_ANNUNCIATOR_BYTES_PER_PLANE +
+                           x / 8] |= 1u << (x & 7);
+                }
+            }
+        }
+    }
+    return (char *)g_base64_encode(planes, sizeof(planes));
+}
+
+static char *np560_get_root_entry_back_frame(Object *obj, Error **errp)
+{
+    NP560MachineState *s = NP560_MACHINE(obj);
+
+    if (!s->cpu || !s->cpu->env.root_entry_frame_valid) {
+        return g_strdup("");
+    }
+    return (char *)g_base64_encode(s->cpu->env.root_entry_back_frame,
+                                   DMCU_NATIVE_FRAMEBUFFER_BYTES);
+}
+
