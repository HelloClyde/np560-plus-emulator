+            &s->code_resident_root_policy_alias[overlay_index], NULL,
+            np560_resident_root_policy_names[overlay_index],
+            &s->data, address, sizeof(uint16_t));
+        memory_region_add_subregion_overlap(
+            &s->code, address,
+            &s->code_resident_root_policy_alias[overlay_index], 3);
+    }
+    memory_region_init_alias(&s->data_uint32_multiply_overlay_alias, NULL,
+                             "np560.data-uint32-multiply-overlay-alias",
+                             &s->data, NP560_UINT32_MULTIPLY_OVERLAY_BASE,
+                             NP560_UINT32_MULTIPLY_OVERLAY_SIZE);
+    memory_region_add_subregion_overlap(
+        get_system_memory(), NP560_UINT32_MULTIPLY_OVERLAY_BASE,
+        &s->data_uint32_multiply_overlay_alias, 2);
+    memory_region_init_alias(&s->code_uint32_multiply_overlay_alias, NULL,
+                             "np560.code-uint32-multiply-overlay-alias",
+                             &s->program,
+                             NP560_UINT32_MULTIPLY_OVERLAY_SOURCE -
+                             DMCU_PROGRAM_BASE,
+                             NP560_UINT32_MULTIPLY_OVERLAY_SIZE);
+    memory_region_add_subregion_overlap(
+        &s->code, NP560_UINT32_MULTIPLY_OVERLAY_BASE,
+        &s->code_uint32_multiply_overlay_alias, 2);
+    memory_region_init_alias(&s->data_system_mode_overlay_alias, NULL,
+                             "np560.data-system-mode-overlay-alias", &s->data,
+                             NP560_SYSTEM_MODE_OVERLAY_BASE,
+                             NP560_SYSTEM_MODE_OVERLAY_SIZE);
+    memory_region_add_subregion_overlap(
+        get_system_memory(), NP560_SYSTEM_MODE_OVERLAY_BASE,
+        &s->data_system_mode_overlay_alias, 2);
+    memory_region_init_alias(&s->code_system_mode_overlay_alias, NULL,
+                             "np560.code-system-mode-overlay-alias", &s->program,
+                             NP560_SYSTEM_MODE_OVERLAY_SOURCE - DMCU_PROGRAM_BASE,
+                             NP560_SYSTEM_MODE_OVERLAY_SIZE);
+    memory_region_add_subregion_overlap(
+        &s->code, NP560_SYSTEM_MODE_OVERLAY_BASE,
+        &s->code_system_mode_overlay_alias, 2);
+    memory_region_init_alias(&s->data_startup_table_service_overlay_alias, NULL,
+                             "np560.data-startup-table-service-overlay-alias",
+                             &s->data, NP560_STARTUP_TABLE_SERVICE_OVERLAY_BASE,
+                             NP560_STARTUP_TABLE_SERVICE_OVERLAY_SIZE);
+    memory_region_add_subregion_overlap(
+        get_system_memory(), NP560_STARTUP_TABLE_SERVICE_OVERLAY_BASE,
+        &s->data_startup_table_service_overlay_alias, 2);
+    memory_region_init_alias(&s->code_startup_table_service_overlay_alias, NULL,
+                             "np560.code-startup-table-service-overlay-alias",
+                             &s->data, NP560_STARTUP_TABLE_SERVICE_OVERLAY_BASE,
+                             NP560_STARTUP_TABLE_SERVICE_OVERLAY_SIZE);
+    memory_region_add_subregion_overlap(
+        &s->code, NP560_STARTUP_TABLE_SERVICE_OVERLAY_BASE,
+        &s->code_startup_table_service_overlay_alias, 2);
+    memory_region_init_alias(&s->data_startup_region_service_overlay_alias, NULL,
+                             "np560.data-startup-region-service-overlay-alias",
+                             &s->data, NP560_STARTUP_REGION_SERVICE_OVERLAY_BASE,
+                             NP560_STARTUP_REGION_SERVICE_OVERLAY_SIZE);
+    memory_region_add_subregion_overlap(
+        get_system_memory(), NP560_STARTUP_REGION_SERVICE_OVERLAY_BASE,
+        &s->data_startup_region_service_overlay_alias, 2);
+    memory_region_init_alias(&s->code_startup_region_service_overlay_alias, NULL,
+                             "np560.code-startup-region-service-overlay-alias",
+                             &s->data, NP560_STARTUP_REGION_SERVICE_OVERLAY_BASE,
+                             NP560_STARTUP_REGION_SERVICE_OVERLAY_SIZE);
+    memory_region_add_subregion_overlap(
+        &s->code, NP560_STARTUP_REGION_SERVICE_OVERLAY_BASE,
+        &s->code_startup_region_service_overlay_alias, 2);
+
+    if (!machine->firmware) {
+        error_report("NP560+ requires a raw firmware image: -bios NP560.PRG");
+        exit(EXIT_FAILURE);
+    }
+    filename = qemu_find_file(QEMU_FILE_TYPE_BIOS, machine->firmware);
+    if (!filename) {
+        error_report("Unable to find NP560+ firmware '%s'", machine->firmware);
+        exit(EXIT_FAILURE);
+    }
+    loaded = load_image_size(filename, memory_region_get_ram_ptr(&s->program),
+                             DMCU_PROGRAM_SIZE);
+    if (loaded < 0) {
+        error_report("Unable to load NP560+ firmware '%s'", filename);
+        exit(EXIT_FAILURE);
+    }
+    if (loaded != DMCU_PROGRAM_SIZE) {
+        warn_report("NP560+ firmware is 0x%zx bytes; expected 0x%x",
+                    loaded, DMCU_PROGRAM_SIZE);
+    }
+
+    /*
+     * Each writable overlay alias has higher priority than immutable NOR on
+     * the code bus.  Before the resident loader writes an overlay, however,
+     * execution must still observe the original PRG bytes at that address.
+     * Seed the RAM slots from NOR once at power-on; subsequent guest data
+     * writes then replace exactly the bytes the loader installs.
+     */
+    np560_seed_program_overlay(s, NP560_CLEAR_OVERLAY_BASE,
+                               NP560_OVERLAY_TRAMPOLINE_SIZE);
+    np560_seed_program_overlay(s, NP560_MULTIPLY_OVERLAY_BASE,
+                               NP560_OVERLAY_TRAMPOLINE_SIZE);
+    np560_seed_program_overlay(s, NP560_COPY_OVERLAY_BASE,
+                               NP560_COPY_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_MEMORY_INIT_OVERLAY_BASE,
+                               NP560_MEMORY_INIT_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_TEXT_DRAW_OVERLAY_BASE,
+                               NP560_TEXT_DRAW_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_SYSTEM_BITS_OVERLAY_BASE,
+                               NP560_SYSTEM_BITS_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_SYSTEM_INIT_OVERLAY_BASE,
+                               NP560_SYSTEM_INIT_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_MODE_INIT_OVERLAY_BASE,
+                               NP560_MODE_INIT_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_MODE_MASK_OVERLAY_BASE,
+                               NP560_MODE_MASK_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_MEMORY_RESET_OVERLAY_BASE,
+                               NP560_MEMORY_RESET_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_MEMORY_MODE_OVERLAY_BASE,
+                               NP560_MEMORY_MODE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_GLOBAL_RESET_OVERLAY_BASE,
+                               NP560_GLOBAL_RESET_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_STARTUP_TABLE_OVERLAY_BASE,
+                               NP560_STARTUP_TABLE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_STARTUP_POINTER_OVERLAY_BASE,
+                               NP560_STARTUP_POINTER_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_STARTUP_ARRAY_OVERLAY_BASE,
+                               NP560_STARTUP_ARRAY_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_STARTUP_RUNTIME_OVERLAY_BASE,
+                               NP560_STARTUP_RUNTIME_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_LCD_INIT_OVERLAY_BASE,
+                               NP560_APPLICATION_LCD_INIT_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_PERIPHERAL_INIT_OVERLAY_BASE,
+                               NP560_PERIPHERAL_INIT_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_ACTIVATION_CONTEXT_OVERLAY_BASE,
+                               NP560_ACTIVATION_CONTEXT_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_POINTER_SERVICE_OVERLAY_BASE,
+                               NP560_POINTER_SERVICE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_POINTER_STATE_OVERLAY_BASE,
+                               NP560_POINTER_STATE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_POINTER_FLAG_OVERLAY_BASE,
+                               NP560_POINTER_FLAG_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_POINTER_NORMALIZE_OVERLAY_BASE,
+                               NP560_POINTER_NORMALIZE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_POINTER_RESOLVE_OVERLAY_BASE,
+                               NP560_POINTER_RESOLVE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_ACTIVATION_DISPATCH_OVERLAY_BASE,
+                               NP560_ACTIVATION_DISPATCH_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_PROPERTY_OVERLAY_BASE,
+                               NP560_APPLICATION_PROPERTY_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_PROPERTY_SETTER_OVERLAY_BASE,
+                               NP560_PROPERTY_SETTER_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_LCD_RESOURCE_OVERLAY_BASE,
+                               NP560_LCD_RESOURCE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_LCD_TIMING_OVERLAY_BASE,
+                               NP560_LCD_TIMING_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_STATE_OVERLAY_BASE,
+                               NP560_APPLICATION_STATE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_MEMORY_FILL_OVERLAY_BASE,
+                               NP560_MEMORY_FILL_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_RANGE_OVERLAY_BASE,
+                               NP560_APPLICATION_RANGE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_TABLE_INIT_OVERLAY_BASE,
+                               NP560_APPLICATION_TABLE_INIT_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_TABLE_CLEAR_OVERLAY_BASE,
+                               NP560_APPLICATION_TABLE_CLEAR_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_BUFFER_COPY_OVERLAY_BASE,
+                               NP560_APPLICATION_BUFFER_COPY_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_COMMAND_OVERLAY_BASE,
+                               NP560_APPLICATION_COMMAND_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_COMMAND_TABLE_PRIMARY_OVERLAY_BASE,
+                               NP560_COMMAND_TABLE_PRIMARY_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_COMMAND_TABLE_SECONDARY_OVERLAY_BASE,
+                               NP560_COMMAND_TABLE_SECONDARY_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_COMMAND_TABLE_TERTIARY_OVERLAY_BASE,
+                               NP560_COMMAND_TABLE_TERTIARY_OVERLAY_SIZE);
+    np560_seed_program_overlay(
+        s, NP560_APPLICATION_ROOT_STATIC_DISPLAY_OVERLAY_BASE,
+        NP560_APPLICATION_ROOT_STATIC_DISPLAY_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_ROOT_ITEM_MASK_OVERLAY_BASE,
+                               NP560_APPLICATION_ROOT_ITEM_MASK_OVERLAY_SIZE);
+    np560_seed_program_overlay(
+        s, NP560_APPLICATION_ROOT_HARDWARE_RESET_OVERLAY_BASE,
+        NP560_APPLICATION_ROOT_HARDWARE_RESET_OVERLAY_SIZE);
+    np560_seed_program_overlay(
+        s, NP560_APPLICATION_ROOT_BITMAP_RENDER_OVERLAY_BASE,
+        NP560_APPLICATION_ROOT_BITMAP_RENDER_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_COMMAND_MATRIX_OVERLAY_BASE,
+                               NP560_COMMAND_MATRIX_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_MODE_OVERLAY_BASE,
+                               NP560_APPLICATION_MODE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_SLOT_OVERLAY_BASE,
+                               NP560_APPLICATION_SLOT_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_TRIPLE_OVERLAY_BASE,
+                               NP560_APPLICATION_TRIPLE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_APPLICATION_HW_STATE_OVERLAY_BASE,
+                               NP560_APPLICATION_HW_STATE_OVERLAY_SIZE);
+    for (overlay_index = 0;
+         overlay_index < G_N_ELEMENTS(np560_late_overlays);
+         overlay_index++) {
+        /* Destinations below segment 20 are reconstructed resident ROM, not
+         * flat PRG bytes.  The guest late loader fills their RAM aliases from
+         * the evidenced +0x1d source before executing them. */
+        if (np560_late_overlays[overlay_index].base >= DMCU_PROGRAM_BASE) {
+            np560_seed_program_overlay(s,
+                                       np560_late_overlays[overlay_index].base,
+                                       np560_late_overlays[overlay_index].size);
+        }
+    }
+    np560_seed_program_overlay(s, NP560_UINT32_MULTIPLY_OVERLAY_BASE,
+                               NP560_UINT32_MULTIPLY_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_SYSTEM_MODE_OVERLAY_BASE,
+                               NP560_SYSTEM_MODE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_STARTUP_TABLE_SERVICE_OVERLAY_BASE,
+                               NP560_STARTUP_TABLE_SERVICE_OVERLAY_SIZE);
+    np560_seed_program_overlay(s, NP560_STARTUP_REGION_SERVICE_OVERLAY_BASE,
+                               NP560_STARTUP_REGION_SERVICE_OVERLAY_SIZE);
+
+    if (s->usb_loader && *s->usb_loader) {
+        auxiliary_code_base = dmcu_code_address(0x00, 0x1000);
+        usb_loader_size = np560_load_be16_image(
+            &s->usb_loader_region, "np560.usb-loader", s->usb_loader,
+            auxiliary_code_base);
+        auxiliary_code_limit = auxiliary_code_base + usb_loader_size;
+    }
+    if (s->burn_code && *s->burn_code) {
+        burn_code_size = np560_load_be16_image(
+            &s->burn_code_region, "np560.burn-code", s->burn_code,
+            dmcu_code_address(0x50, 0x6000));
+    }
+    if (s->driver_code && *s->driver_code) {
+        driver_code_size = np560_load_be16_image(
+            &s->driver_code_region, "np560.driver-code", s->driver_code,
+            dmcu_code_address(0x52, 0x0000));
+    }
+    if (usb_loader_size) {
+        memory_region_init_alias(&s->code_usb_loader_alias, NULL,
+                                 "np560.code-usb-loader-alias",
+                                 &s->usb_loader_region, 0, usb_loader_size);
+        memory_region_add_subregion_overlap(&s->code, auxiliary_code_base,
+                                             &s->code_usb_loader_alias, 2);
+    }
+    if (burn_code_size) {
+        memory_region_init_alias(&s->code_burn_code_alias, NULL,
+                                 "np560.code-burn-code-alias",
+                                 &s->burn_code_region, 0, burn_code_size);
+        memory_region_add_subregion_overlap(
+            &s->code, dmcu_code_address(0x50, 0x6000),
+            &s->code_burn_code_alias, 2);
+    }
+    if (driver_code_size) {
+        memory_region_init_alias(&s->code_driver_code_alias, NULL,
+                                 "np560.code-driver-code-alias",
+                                 &s->driver_code_region, 0, driver_code_size);
+        memory_region_add_subregion_overlap(
+            &s->code, dmcu_code_address(0x52, 0x0000),
+            &s->code_driver_code_alias, 3);
+    }
+
+    if (!s->boot_mode || !*s->boot_mode ||
+        g_str_equal(s->boot_mode, "firmware")) {
+        reset_pc = DMCU_PROGRAM_BASE;
+    } else if (g_str_equal(s->boot_mode, "usb")) {
+        if (!s->usb_loader || !*s->usb_loader) {
+            error_report("NP560+ boot-mode=usb requires usb-loader=FILE");
+            exit(EXIT_FAILURE);
+        }
+        reset_pc = dmcu_code_address(0x00, 0x1000);
+    } else if (g_str_equal(s->boot_mode, "burn")) {
+        if (!s->burn_code || !*s->burn_code) {
+            error_report("NP560+ boot-mode=burn requires burn-code=FILE");
+            exit(EXIT_FAILURE);
+        }
+        reset_pc = dmcu_code_address(0x50, 0x6000);
+    } else if (g_str_equal(s->boot_mode, "driver")) {
+        if (!s->driver_code || !*s->driver_code) {
+            error_report("NP560+ boot-mode=driver requires driver-code=FILE");
+            exit(EXIT_FAILURE);
+        }
+        reset_pc = dmcu_code_address(0x52, 0x0000);
+    } else {
+        error_report("Unknown NP560+ boot mode '%s' "
+                     "(use firmware, usb, burn, or driver)", s->boot_mode);
+        exit(EXIT_FAILURE);
+    }
+
+    s->cpu = DMCU_CPU(object_new(machine->cpu_type));
+    if (!s->cpu) {
+        error_report("Unable to create DMCU CPU '%s'", machine->cpu_type);
+        exit(EXIT_FAILURE);
+    }
+    cs = CPU(s->cpu);
+    s->cpu->code_memory = &s->code;
+    s->cpu->internal_data = memory_region_get_ram_ptr(&s->data);
+    s->cpu->reset_pc = reset_pc;
+    s->cpu->mask_rom03_present = mask_rom03_present;
+    s->cpu->rom_hle_enabled = s->rom_hle;
+    s->cpu->soc_rom_skeleton = s->soc_rom_skeleton;
+    s->cpu->hle_ui_enabled = s->hle_ui && s->rom_hle &&
+                            !mask_rom03_present;
+    s->cpu->auxiliary_code_base = auxiliary_code_base;
+    s->cpu->auxiliary_code_limit = auxiliary_code_limit;
+    s->cpu->resident_rom_base = resident_rom_base;
+    s->cpu->resident_rom_limit = resident_rom_limit;
+    s->cpu->startup_context = s->startup_context;
+    qdev_realize(DEVICE(s->cpu), NULL, &error_fatal);
+    cpu_reset(cs);
+    np560_keyboard_reset(s);
+    s->system_tick_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                        np560_system_tick, s);
+    np560_schedule_system_tick(s);
+    object_property_add_uint32_ptr(OBJECT(machine), "key-state",
+        &s->cpu->env.web_key_state, OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(OBJECT(machine), "key-code",
+        &s->cpu->env.web_key_code, OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(OBJECT(machine), "key-matrix-low",
+        &s->cpu->env.web_matrix_state_low, OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(OBJECT(machine), "key-matrix-high",
+        &s->cpu->env.web_matrix_state_high, OBJ_PROP_FLAG_READWRITE);
+}
+
+static void np560_machine_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "Noah NP560+ (King Billion DMCU)";
+    mc->init = np560_init;
+    mc->default_cpu_type = TYPE_DMCU_V1_CPU;
+    mc->default_cpus = 1;
+    mc->min_cpus = 1;
+    mc->max_cpus = 1;
+    mc->no_floppy = true;
+    mc->no_cdrom = true;
+    mc->no_parallel = true;
+    object_class_property_add_str(oc, "cpu-state", np560_get_cpu_state,
+                                  NULL);
+    object_class_property_set_description(oc, "cpu-state",
+        "Live NP560+ DMCU register state for the Web frontend");
+    object_class_property_add_str(oc, "lcd-frame", np560_get_lcd_frame,
+                                  NULL);
+    object_class_property_set_description(oc, "lcd-frame",
+        "Base64 240x120 5-bit grayscale output from the ST7529 controller");
+    object_class_property_add_str(oc, "lcd-gram-frame",
+                                  np560_get_lcd_gram_frame, NULL);
+    object_class_property_set_description(oc, "lcd-gram-frame",
+        "Observer-only Base64 240x160 raw ST7529 controller-line view");
+    object_class_property_add_str(oc, "lcd-annunciators",
+                                  np560_get_lcd_annunciators, NULL);
+    object_class_property_set_description(oc, "lcd-annunciators",
+        "Base64 two-plane 240-bit NP560 custom-glass annunciator state");
+    object_class_property_add_str(oc, "root-entry-back-frame",
+                                  np560_get_root_entry_back_frame, NULL);
+    object_class_property_set_description(oc, "root-entry-back-frame",
+        "Observer-only packed native back buffer before the root controller");
+    object_class_property_add_str(oc, "root-entry-front-frame",
+                                  np560_get_root_entry_front_frame, NULL);
+    object_class_property_set_description(oc, "root-entry-front-frame",
+        "Observer-only packed native front buffer before the root controller");
+    object_class_property_add_str(oc, "root-top-bitmap",
+                                  np560_get_root_top_bitmap, NULL);
+    object_class_property_set_description(oc, "root-top-bitmap",
+        "Base64 240x22 root-toolbar object captured after resource load");
+    object_class_property_add_str(oc, "root-top-source",
+                                  np560_get_root_top_source, NULL);
+    object_class_property_set_description(oc, "root-top-source",
+        "Base64 raw staging bytes used to construct the root toolbar");
+    object_class_property_add_str(oc, "lcd-state", np560_get_lcd_state,
+                                  NULL);
+    object_class_property_set_description(oc, "lcd-state",
+        "Live NP560+ ST7529 controller state");
+    object_class_property_add_str(oc, "nand-state", np560_get_nand_state,
+                                  NULL);
+    object_class_property_set_description(oc, "nand-state",
+        "Live EC:DC NAND geometry and reconstructed-controller state");
+    object_class_property_add_str(oc, "ecc-state", np560_get_ecc_state,
+                                  NULL);
+    object_class_property_set_description(oc, "ecc-state",
+        "Live F20A/F20C/F20E 32-bit paired-parity ECC state");
+    object_class_property_add_str(oc, "mask-rom", np560_get_mask_rom,
+                                  np560_set_mask_rom);
+    object_class_property_set_description(oc, "mask-rom",
+        "Optional raw 64 KiB dump of the SoC's code segment 03 mask ROM");
+    object_class_property_add_str(oc, "soc-rom", np560_get_soc_rom,
+                                  np560_set_soc_rom);
+    object_class_property_set_description(oc, "soc-rom",
+        "Optional raw flat dump of SoC resident code at 00:0000 (up to 2 MiB)");
+    object_class_property_add_str(oc, "usb-loader", np560_get_usb_loader,
+                                  np560_set_usb_loader);
+    object_class_property_set_description(oc, "usb-loader",
+        "Optional big-endian 16-bit USB_Loader image mapped at 00:1000");
+    object_class_property_add_str(oc, "burn-code", np560_get_burn_code,
+                                  np560_set_burn_code);
+    object_class_property_set_description(oc, "burn-code",
+        "Optional big-endian 16-bit NAND burner image mapped at 50:6000");
+    object_class_property_add_str(oc, "driver-code", np560_get_driver_code,
+                                  np560_set_driver_code);
+    object_class_property_set_description(oc, "driver-code",
+        "Optional update driver image mapped at 52:0000");
+    object_class_property_add_str(oc, "nand-image", np560_get_nand_image,
+                                  np560_set_nand_image);
+    object_class_property_set_description(oc, "nand-image",
+        "Optional logical 512-byte-page NAND data image; a 0x200-byte "
+        "MASKROM package header is detected and stripped");
+    object_class_property_add_str(oc, "nand-checkpoint",
+                                  np560_get_nand_checkpoint,
+                                  np560_set_nand_checkpoint);
+    object_class_property_set_description(oc, "nand-checkpoint",
+        "Restore a complete NP560+ NAND data/OOB checkpoint");
+    object_class_property_add_str(oc, "nand-save", np560_get_nand_save,
+                                  np560_set_nand_save);
+    object_class_property_set_description(oc, "nand-save",
+        "Write the complete live NAND data/OOB state to a checkpoint");
+    object_class_property_add_str(oc, "debug-data-load",
+                                  np560_get_debug_data_load,
+                                  np560_set_debug_data_load);
+    object_class_property_set_description(oc, "debug-data-load",
+        "Diagnostic only: load ADDRESS@FILE into writable external data RAM");
+    object_class_property_add_str(oc, "debug-data-write",
+                                  np560_get_debug_data_write,
+                                  np560_set_debug_data_write);
+    object_class_property_set_description(oc, "debug-data-write",
+        "Diagnostic only: write ADDRESS@HEX into writable external data RAM");
+    object_class_property_add_str(oc, "debug-data-save",
+                                  np560_get_debug_data_save,
+                                  np560_set_debug_data_save);
+    object_class_property_set_description(oc, "debug-data-save",
+        "Diagnostic only: save ADDRESS:SIZE@FILE directly from data RAM");
+    object_class_property_add_str(oc, "debug-program-load",
+                                  np560_get_debug_program_load,
+                                  np560_set_debug_program_load);
+    object_class_property_set_description(oc, "debug-program-load",
+        "Diagnostic only: replace ADDRESS@FILE in the updater source window");
+    object_class_property_add_bool(oc, "debug-trace-reset",
+                                   np560_get_debug_trace_reset,
+                                   np560_set_debug_trace_reset);
+    object_class_property_set_description(oc, "debug-trace-reset",
+        "Diagnostic only: reset the streamed-copy address trace");
+    object_class_property_add_str(oc, "boot-mode", np560_get_boot_mode,
+                                  np560_set_boot_mode);
+    object_class_property_set_description(oc, "boot-mode",
+        "Reset source: firmware (default), usb, burn, or driver");
+    object_class_property_add_bool(oc, "hle-ui", np560_get_hle_ui,
+                                   np560_set_hle_ui);
+    object_class_property_set_description(oc, "hle-ui",
+        "Render the diagnostic compatibility menu (requires rom-hle=on)");
+    object_class_property_add_bool(oc, "rom-hle", np560_get_rom_hle,
+                                   np560_set_rom_hle);
+    object_class_property_set_description(oc, "rom-hle",
+        "Enable diagnostic host replacements for missing resident ROM code");
+    object_class_property_add_bool(oc, "soc-rom-skeleton",
+                                   np560_get_soc_rom_skeleton,
+                                   np560_set_soc_rom_skeleton);
+    object_class_property_set_description(oc, "soc-rom-skeleton",
+        "Treat reserved 0x0f00 words in an experimental SoC ROM as missing");
+}
+
+static void np560_machine_instance_init(Object *obj)
+{
+    NP560MachineState *s = NP560_MACHINE(obj);
+
+    s->rom_hle = false;
+    s->soc_rom_skeleton = false;
+    s->hle_ui = false;
+    s->adc_level = 8;
+    s->external_power = 0;
+    object_property_add_uint32_ptr(obj, "startup-context",
+                                   &s->startup_context,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_set_description(obj, "startup-context",
+        "24-bit context pointer supplied by the missing resident loader");
+    object_property_add_uint32_ptr(obj, "adc-level", &s->adc_level,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_set_description(obj, "adc-level",
+        "F2D0 analog comparator level exposed to the guest (0..8; default 8)");
+    object_property_add_uint32_ptr(obj, "external-power", &s->external_power,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_set_description(obj, "external-power",
+        "F160 bit-12 external-power/charger input (0 or 1; default 0)");
+}
+
+static void np560_machine_finalize(Object *obj)
+{
+    NP560MachineState *s = NP560_MACHINE(obj);
+
+    qemu_unregister_reset(np560_st7529_reset, s);
+    qemu_unregister_reset(np560_ecc_reset, s);
+    qemu_unregister_reset(np560_adc_reset, s);
+    qemu_unregister_reset(np560_nand_reset, s);
+    qemu_unregister_reset(np560_keyboard_reset, s);
+    qemu_unregister_reset(np560_timer_reset, s);
+    if (s->system_tick_timer) {
+        timer_del(s->system_tick_timer);
+        timer_free(s->system_tick_timer);
+    }
+    g_free(s->nand.data);
+    g_free(s->nand.oob);
+    g_free(s->soc_rom);
+    g_free(s->mask_rom);
+    g_free(s->usb_loader);
+    g_free(s->burn_code);
+    g_free(s->driver_code);
+    g_free(s->nand_image);
+    g_free(s->nand_checkpoint);
+    g_free(s->nand_save);
+    g_free(s->debug_data_load);
+    g_free(s->debug_data_write);
+    g_free(s->debug_data_save);
+    g_free(s->debug_program_load);
+    g_free(s->boot_mode);
+}
+
+static const TypeInfo np560_machine_type = {
+    .name = TYPE_NP560_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(NP560MachineState),
+    .instance_init = np560_machine_instance_init,
+    .instance_finalize = np560_machine_finalize,
+    .class_init = np560_machine_class_init,
+};
+
+static void np560_machine_register_types(void)
+{
+    type_register_static(&np560_machine_type);
+}
+
+type_init(np560_machine_register_types)
