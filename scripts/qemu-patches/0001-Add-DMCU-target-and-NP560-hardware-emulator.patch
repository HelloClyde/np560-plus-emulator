+static void np560_set_debug_data_load(Object *obj, const char *value,
+                                      Error **errp)
+{
+    NP560MachineState *s = NP560_MACHINE(obj);
+    const char *path;
+    uint64_t address;
+    g_autofree gchar *contents = NULL;
+    g_autoptr(GError) gerror = NULL;
+    gsize size = 0;
+
+    if (!value || !*value) {
+        g_clear_pointer(&s->debug_data_load, g_free);
+        return;
+    }
+    if (!np560_parse_debug_address(value, &path, &address, errp)) {
+        return;
+    }
+    if (!g_file_get_contents(path, &contents, &size, &gerror)) {
+        error_setg(errp, "Unable to load NP560+ debug data '%s': %s",
+                   path, gerror->message);
+        return;
+    }
+    if (!np560_debug_data_range(s, address, size, errp)) {
+        return;
+    }
+    memcpy(memory_region_get_ram_ptr(&s->data) + address, contents, size);
+    g_free(s->debug_data_load);
+    s->debug_data_load = g_strdup(value);
+}
