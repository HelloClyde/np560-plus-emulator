diff --git a/inspect_np560_media_sectors.py b/inspect_np560_media_sectors.py
new file mode 100644
index 0000000000000000000000000000000000000000..c663a508e06dbb9a321b4d99f38c785473b8f8d3
--- /dev/null
+++ b/inspect_np560_media_sectors.py
@@ -0,0 +1,186 @@
+#!/usr/bin/env python3
+"""Locate and classify MBR/FAT boot sectors in an NP560 NAND checkpoint.
+
+The external 16-bit NAND bus exposes adjacent bytes in the opposite order to
+the firmware's byte loads.  This scanner checks both the physical byte order
+stored in a checkpoint and the pair-swapped logical order seen by the guest.
+It is read-only and reports physical page/sector provenance for every credible
+MBR or FAT BPB it finds.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+import mmap
+from pathlib import Path
+import struct
+
+
+CHECKPOINT_MAGIC = b"NP560N1\0"
+CHECKPOINT_HEADER_SIZE = 64
+SECTOR_SIZE = 512
+
+
+@dataclass(frozen=True)
+class Geometry:
+    data_offset: int
+    data_size: int
+    page_size: int
+
+
+def checkpoint_geometry(image: mmap.mmap) -> Geometry:
+    if len(image) < CHECKPOINT_HEADER_SIZE or image[:8] != CHECKPOINT_MAGIC:
+        raise ValueError("not an NP560N1 NAND checkpoint")
+    version, header_size, page_size, _page_oob = struct.unpack_from(
+        "<4I", image, 8
+    )
+    data_size = struct.unpack_from("<Q", image, 32)[0]
+    if (
+        version != 1
+        or header_size != CHECKPOINT_HEADER_SIZE
+        or page_size <= 0
+        or page_size % SECTOR_SIZE
+        or data_size <= 0
+        or CHECKPOINT_HEADER_SIZE + data_size > len(image)
+    ):
+        raise ValueError("unsupported NP560 checkpoint geometry")
+    return Geometry(CHECKPOINT_HEADER_SIZE, data_size, page_size)
+
+
+def swap_adjacent_bytes(data: bytes) -> bytes:
+    swapped = bytearray(len(data))
+    swapped[0::2] = data[1::2]
+    swapped[1::2] = data[0::2]
+    return bytes(swapped)
+
+
+def u16(data: bytes, offset: int) -> int:
+    return int.from_bytes(data[offset:offset + 2], "little")
+
+
+def u32(data: bytes, offset: int) -> int:
+    return int.from_bytes(data[offset:offset + 4], "little")
+
+
+def fat_bpb(data: bytes) -> dict[str, int] | None:
+    if data[510:512] != b"\x55\xAA":
+        return None
+    bytes_per_sector = u16(data, 0x0B)
+    sectors_per_cluster = data[0x0D]
+    reserved_sectors = u16(data, 0x0E)
+    fat_count = data[0x10]
+    root_entries = u16(data, 0x11)
+    total_sectors_16 = u16(data, 0x13)
+    total_sectors_32 = u32(data, 0x20)
+    sectors_per_fat_16 = u16(data, 0x16)
+    total_sectors = total_sectors_16 or total_sectors_32
+    if (
+        bytes_per_sector not in (512, 1024, 2048, 4096)
+        or sectors_per_cluster == 0
+        or sectors_per_cluster & (sectors_per_cluster - 1)
+        or reserved_sectors == 0
+        or fat_count not in (1, 2)
+        or total_sectors == 0
+    ):
+        return None
+    return {
+        "bytes_per_sector": bytes_per_sector,
+        "sectors_per_cluster": sectors_per_cluster,
+        "reserved_sectors": reserved_sectors,
+        "fat_count": fat_count,
+        "root_entries": root_entries,
+        "total_sectors": total_sectors,
+        "sectors_per_fat_16": sectors_per_fat_16,
+        "hidden_sectors": u32(data, 0x1C),
+    }
+
+
+def mbr_partitions(data: bytes) -> list[dict[str, int]]:
+    if data[510:512] != b"\x55\xAA":
+        return []
+    partitions: list[dict[str, int]] = []
+    for index in range(4):
+        offset = 0x1BE + index * 16
+        boot = data[offset]
+        part_type = data[offset + 4]
+        start_lba = u32(data, offset + 8)
+        sectors = u32(data, offset + 12)
+        if boot in (0x00, 0x80) and part_type and sectors:
+            partitions.append({
+                "index": index,
+                "boot": boot,
+                "type": part_type,
+                "start_lba": start_lba,
+                "sectors": sectors,
+            })
+    return partitions
+
+
+def describe_sector(data: bytes) -> tuple[str, str] | None:
+    bpb = fat_bpb(data)
+    if bpb:
+        fields = " ".join(f"{key}={value}" for key, value in bpb.items())
+        return "FAT_BPB", fields
+    partitions = mbr_partitions(data)
+    if partitions:
+        fields = ";".join(
+            f"p{part['index']} boot={part['boot']:02x} "
+            f"type={part['type']:02x} start={part['start_lba']} "
+            f"sectors={part['sectors']}"
+            for part in partitions
+        )
+        return "MBR", fields
+    return None
+
+
+def scan_checkpoint(path: Path) -> int:
+    matches = 0
+    with path.open("rb") as source:
+        image = mmap.mmap(source.fileno(), 0, access=mmap.ACCESS_READ)
+        try:
+            geometry = checkpoint_geometry(image)
+            sector_count = geometry.data_size // SECTOR_SIZE
+            print(
+                f"IMAGE={path} DATA={geometry.data_size} "
+                f"PAGE={geometry.page_size} SECTORS={sector_count}"
+            )
+            for sector_index in range(sector_count):
+                offset = geometry.data_offset + sector_index * SECTOR_SIZE
+                physical = image[offset:offset + SECTOR_SIZE]
+                for byte_order, candidate in (
+                    ("physical", physical),
+                    ("guest", swap_adjacent_bytes(physical)),
+                ):
+                    description = describe_sector(candidate)
+                    if not description:
+                        continue
+                    kind, fields = description
+                    page = sector_index * SECTOR_SIZE // geometry.page_size
+                    in_page = (
+                        sector_index * SECTOR_SIZE % geometry.page_size
+                    ) // SECTOR_SIZE
+                    print(
+                        f"{kind} order={byte_order} page=0x{page:x} "
+                        f"page_sector={in_page} data_offset=0x{offset:x} "
+                        f"bpb_total16={u16(candidate, 0x13)} "
+                        f"bpb_total32={u32(candidate, 0x20)} {fields}"
+                    )
+                    matches += 1
+        finally:
+            image.close()
+    print(f"MATCHES={matches}")
+    return matches
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("checkpoints", type=Path, nargs="+")
+    args = parser.parse_args()
+    for path in args.checkpoints:
+        scan_checkpoint(path)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/mirror_np560_runtime_patches.py b/mirror_np560_runtime_patches.py
new file mode 100644
index 0000000000000000000000000000000000000000..7116200b2b4fa5221d62ae321f65b76bf092a3ab
--- /dev/null
+++ b/mirror_np560_runtime_patches.py
@@ -0,0 +1,200 @@
+#!/usr/bin/env python3
+"""Mirror guest-installed NP560 code patches into source-pinned PRG copies.
+
+The reconstructed resident ROM installs application overlays and then patches
+some call sites in their writable destinations.  A Harvard QEMU mapping may
+source an overlay's instruction view from its immutable linked PRG copy to
+protect it from unrelated NAND-buffer writes.  In that case the later guest
+patch would otherwise be hidden.  This preflight extracts immediate program
+writes from the actual guest installer routines, reports every conflict, and
+mirrors only those evidenced words into a derived PRG image.
+
+This is firmware preprocessing, not a host ROM service: the output contains
+the same final instruction words that the reconstructed guest installer writes
+to its destination code RAM.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import defaultdict
+import hashlib
+import json
+from pathlib import Path
+import sys
+from typing import Iterable, Sequence
+
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from disassembly import build_np560_reconstructed_rom as rom  # noqa: E402
+from disassembly.np560_overlay_map import (  # noqa: E402
+    DEFAULT_QEMU_SOURCE,
+    QemuMapping,
+    parse_qemu_mappings,
+)
+
+
+PROGRAM_BASE = 0x200000
+
+
+def current_resident_routines() -> dict[int, tuple[str, list[int]]]:
+    """Build the v416 resident-ROM routine set used by the active emulator."""
+    return rom.make_routines(
+        initializer_overlay_probe=True,
+        probe_rom_08_return=True,
+        probe_rom_01_return=True,
+        probe_system_main=True,
+        probe_storage_global_templates=True,
+        factory_linked_startup=True,
+    )
+
+
+def static_program_writes(
+    routines: dict[int, tuple[str, Sequence[int]]],
+) -> tuple[dict[int, list[int]], dict[int, set[str]]]:
+    """Recover immediate DS0/MOV/store writes emitted by guest installers."""
+    # Keep write order.  Several installers first copy an original call word
+    # and then retarget that same word later in the same guest routine.  A set
+    # makes preprocessing alternate between the two values on each run;
+    # retaining the sequence makes the final guest-visible write idempotent.
+    values: dict[int, list[int]] = defaultdict(list)
+    origins: dict[int, set[str]] = defaultdict(set)
+    for _base, (name, words) in routines.items():
+        ds0: int | None = None
+        index = 0
+        while index < len(words):
+            if words[index] == 0x6810 and index + 1 < len(words):
+                ds0 = words[index + 1]
+                index += 2
+                continue
+            if (
+                ds0 is not None
+                and words[index] == 0x68F0
+                and index + 3 < len(words)
+                and words[index + 2] == 0xA8F0
+            ):
+                address = (ds0 << 15) | (words[index + 3] & 0x7FFF)
+                values[address].append(words[index + 1])
+                origins[address].add(name)
+                index += 4
+                continue
+            index += 1
+    return dict(values), dict(origins)
+
+
+def narrowest_source_mapping(
+    address: int,
+    mappings: Iterable[QemuMapping],
+) -> QemuMapping | None:
+    matches = [
+        mapping for mapping in mappings
+        if mapping.code and mapping.source is not None
+        and mapping.base <= address and address + 2 <= mapping.end
+    ]
+    return min(matches, key=lambda mapping: mapping.size, default=None)
+
+
+def firmware_word(firmware: bytes, address: int) -> int:
+    offset = address - PROGRAM_BASE
+    if offset < 0 or offset + 2 > len(firmware):
+        raise ValueError(f"source address {address:06X} is outside the PRG")
+    return int.from_bytes(firmware[offset:offset + 2], "little")
+
+
+def planned_source_patches(
+    firmware: bytes,
+    mappings: Sequence[QemuMapping],
+    writes: dict[int, Sequence[int]],
+    origins: dict[int, set[str]],
+) -> list[dict]:
+    patches: dict[int, dict] = {}
+    for destination, candidates in sorted(writes.items()):
+        mapping = narrowest_source_mapping(destination, mappings)
+        if mapping is None:
+            continue
+        source = mapping.source + destination - mapping.base
+        old_word = firmware_word(firmware, source)
+        if not candidates:
+            continue
+        new_word = candidates[-1]
+        if new_word == old_word:
+            continue
+        previous = patches.get(source)
+        if previous is not None and previous["new_word"] != new_word:
+            raise ValueError(
+                f"conflicting mirrored values for source {source:06X}"
+            )
+        patches[source] = {
+            "destination": destination,
+            "source": source,
+            "old_word": old_word,
+            "new_word": new_word,
+            "mapping": mapping.symbol,
+            "origins": sorted(origins.get(destination, ())),
+        }
+    return [patches[address] for address in sorted(patches)]
+
+
+def apply_source_patches(firmware: bytes, patches: Sequence[dict]) -> bytes:
+    image = bytearray(firmware)
+    for patch in patches:
+        offset = patch["source"] - PROGRAM_BASE
+        image[offset:offset + 2] = patch["new_word"].to_bytes(2, "little")
+    return bytes(image)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("firmware", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--qemu-source", type=Path, default=DEFAULT_QEMU_SOURCE)
+    parser.add_argument("--manifest", type=Path)
+    parser.add_argument("--dry-run", action="store_true")
+    args = parser.parse_args()
+
+    firmware = args.firmware.read_bytes()
+    mappings = parse_qemu_mappings(
+        args.qemu_source.read_text(encoding="utf-8")
+    )
+    writes, origins = static_program_writes(current_resident_routines())
+    patches = planned_source_patches(
+        firmware, mappings, writes, origins
+    )
+    output = apply_source_patches(firmware, patches)
+    document = {
+        "format": "np560-source-pinned-runtime-patches-v1",
+        "hardware_rom_service": False,
+        "input": str(args.firmware.resolve()),
+        "input_sha256": hashlib.sha256(firmware).hexdigest(),
+        "output": str(args.output.resolve()),
+        "output_sha256": hashlib.sha256(output).hexdigest(),
+        "patch_words": len(patches),
+        "patches": [
+            {
+                **patch,
+                "destination": f"{patch['destination'] >> 16:02X}:"
+                               f"{patch['destination'] & 0xFFFF:04X}",
+                "source": f"{patch['source'] >> 16:02X}:"
+                          f"{patch['source'] & 0xFFFF:04X}",
+                "old_word": f"{patch['old_word']:04X}",
+                "new_word": f"{patch['new_word']:04X}",
+            }
+            for patch in patches
+        ],
+    }
+    print(json.dumps(document, ensure_ascii=False, indent=2))
+    if not args.dry_run:
+        args.output.write_bytes(output)
+        manifest = args.manifest or args.output.with_suffix(".json")
+        manifest.write_text(
+            json.dumps(document, ensure_ascii=False, indent=2) + "\n",
+            encoding="utf-8",
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/monitor_np560_bitmap_nand.py b/monitor_np560_bitmap_nand.py
new file mode 100644
index 0000000000000000000000000000000000000000..2f92694cf47bd5ef5cc10ecbf4d8ca0cd2d54243
--- /dev/null
+++ b/monitor_np560_bitmap_nand.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Capture NAND history at each new root bitmap-transfer count.
+
+The monitor is read-only and polls the lightweight diagnostics endpoint.  It
+exists to preserve the short-lived NAND trace that precedes the resident
+29:AC4E resource copy, before background FTL reads overwrite the ring.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import time
+from pathlib import Path
+from typing import Any
+from urllib.request import urlopen
+
+
+TRANSFER_RE = re.compile(r"^ROOT_BITMAP_TRANSFER=CALLS:(\d+).*$", re.M)
+
+
+def diagnostic_line(registers: str, name: str) -> str:
+    match = re.search(rf"^{re.escape(name)}=.*$", registers, re.M)
+    return match.group(0) if match else f"{name}=unavailable"
+
+
+def fetch(url: str, timeout: float) -> dict[str, Any]:
+    with urlopen(
+        f"{url.rstrip('/')}/api/diagnostics", timeout=timeout
+    ) as response:
+        state = json.load(response)
+    if not isinstance(state, dict) or "error" in state:
+        raise ValueError(f"invalid diagnostics response: {state!r}")
+    return state
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8778")
+    parser.add_argument("--timeout", type=float, default=90.0)
+    parser.add_argument("--request-timeout", type=float, default=2.0)
+    parser.add_argument("--interval", type=float, default=0.01)
+    parser.add_argument("--settle", type=float, default=1.0)
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    if args.timeout <= 0 or args.request_timeout <= 0:
+        parser.error("timeouts must be positive")
+    if args.interval < 0 or args.settle < 0:
+        parser.error("interval and settle must be non-negative")
+
+    deadline = time.monotonic() + args.timeout
+    last_calls = 0
+    first_event_at: float | None = None
+    samples: list[dict[str, object]] = []
+    while time.monotonic() < deadline:
+        state = fetch(args.url, args.request_timeout)
+        registers = str(state.get("registers", ""))
+        match = TRANSFER_RE.search(registers)
+        calls = int(match.group(1)) if match else 0
+        if calls > last_calls:
+            sample = {
+                "elapsed_seconds": args.timeout - (deadline - time.monotonic()),
+                "calls": calls,
+                "pc": registers.splitlines()[0] if registers else "PC=unavailable",
+                "nand_trace": diagnostic_line(registers, "NAND_TRACE"),
+                "transfer": diagnostic_line(registers, "ROOT_BITMAP_TRANSFER"),
+                "header_copy": diagnostic_line(
+                    registers, "ROOT_BITMAP_HEADER_COPY"
+                ),
+                "resource": diagnostic_line(registers, "ROOT_BITMAP_RESOURCE"),
+                "blit": diagnostic_line(registers, "ROOT_BITMAP_BLIT"),
+            }
+            samples.append(sample)
+            print(json.dumps(sample, ensure_ascii=False), flush=True)
+            last_calls = calls
+            if first_event_at is None:
+                first_event_at = time.monotonic()
+        if first_event_at is not None and time.monotonic() >= first_event_at + args.settle:
+            break
+        if args.interval:
+            time.sleep(args.interval)
+
+    result = {
+        "schema": "np560-bitmap-nand-monitor-v1",
+        "url": args.url,
+        "transfer_calls": last_calls,
+        "samples": samples,
+    }
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(
+            json.dumps(result, ensure_ascii=False, indent=2) + "\n",
+            encoding="utf-8",
+        )
+    if not samples:
+        raise TimeoutError("root bitmap transfer was not observed")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/monitor_np560_event_state.py b/monitor_np560_event_state.py
new file mode 100644
index 0000000000000000000000000000000000000000..502514bbafddc5572af4e0ff6cebfc1880946740
--- /dev/null
+++ b/monitor_np560_event_state.py
@@ -0,0 +1,290 @@
+#!/usr/bin/env python3
+"""Print only NP560 initialization/event-state changes and their writers.
+
+Attach to an existing Web/QEMU process.  The QEMU hardware model records the
+instruction PC for every value-changing write to the low-level event helper's
+flags and timestamps.  This client de-duplicates polling snapshots, so a long
+modal wait produces a compact causal timeline instead of a multi-gigabyte
+instruction log.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+import json
+import re
+import time
+from typing import Any
+from urllib.error import URLError
+from urllib.request import urlopen
+
+
+EVENT_LINE = "EVENT_STATE"
+WRITE_LINE = "EVENT_STATE_WRITES"
+USB_LINE = "USB_BOOT_STATE"
+USB_WRITE_LINE = "USB_BOOT_WRITES"
+MILESTONES = ("MODALPOLL", "MODALDONE", "LAUNCH", "MENU")
+USB_MILESTONES = (
+    "DETECT", "INIT", "SVCCLEAR", "SVCSET", "TRIGGER",
+)
+# 2ABC is a continuously advancing firmware tick, useful in a one-shot state
+# dump but not as an initialization transition.  Suppress it from delta output
+# so a long cold-boot monitor remains a short causal trace.
+USB_VOLATILE_VALUES = frozenset(("2ABC",))
+USB_VOLATILE_MILESTONES = frozenset(("DETECT",))
+
+
+@dataclass(frozen=True)
+class EventWrite:
+    pc: str
+    address: int
+    old: int
+    new: int
+    bits: int
+
+
+def endpoint(base_url: str, path: str) -> str:
+    return f"{base_url.rstrip('/')}{path}"
+
+
+def fetch_state(base_url: str, timeout: float) -> dict[str, Any]:
+    with urlopen(endpoint(base_url, "/api/state"), timeout=timeout) as response:
+        state = json.load(response)
+    if not isinstance(state, dict) or "error" in state:
+        raise ValueError(f"invalid Web/QEMU state: {state!r}")
+    return state
+
+
+def state_line(registers: str, name: str) -> str:
+    prefix = f"{name}="
+    for line in registers.splitlines():
+        if line.startswith(prefix):
+            return line[len(prefix):].strip()
+    return "none"
+
+
+def parse_values(registers: str) -> dict[str, int]:
+    line = state_line(registers, EVENT_LINE)
+    return {
+        name: int(value, 16)
+        for name, value in re.findall(r"([0-9A-Z]+):([0-9a-fA-F]{4})", line)
+    }
+
+
+def parse_usb_values(registers: str) -> dict[str, int]:
+    line = state_line(registers, USB_LINE)
+    result = {
+        name: int(value, 16)
+        for name, value in re.findall(
+            r"(SFRB0|4B28|2A48|2A4A|2A56|2ABC):([0-9a-fA-F]{4})",
+            line,
+        )
+    }
+    bit_match = re.search(r"(?:^|\s)BIT13:([01])", line)
+    if bit_match:
+        result["BIT13"] = int(bit_match.group(1))
+    return result
+
+
+def parse_named_writes(registers: str,
+                       line_name: str) -> tuple[int, list[EventWrite]]:
+    line = state_line(registers, line_name)
+    count_match = re.search(r"(?:^|\s)COUNT:(\d+)", line)
+    count = int(count_match.group(1)) if count_match else 0
+    writes = [
+        EventWrite(pc.lower(), int(address, 16), int(old, 16),
+                   int(new, 16), int(bits))
+        for pc, address, old, new, bits in re.findall(
+            r"([0-9a-fA-F]{2}:[0-9a-fA-F]{4})/"
+            r"([0-9a-fA-F]{6})/([0-9a-fA-F]{4})>"
+            r"([0-9a-fA-F]{4})/(8|16)",
+            line,
+        )
+    ]
+    return count, writes
+
+
+def parse_writes(registers: str) -> tuple[int, list[EventWrite]]:
+    return parse_named_writes(registers, WRITE_LINE)
+
+
+def parse_usb_writes(registers: str) -> tuple[int, list[EventWrite]]:
+    return parse_named_writes(registers, USB_WRITE_LINE)
+
+
+def usb_milestone_counts(registers: str) -> dict[str, int]:
+    line = state_line(registers, USB_LINE)
+    return {
+        name: int(match.group(1)) if (match := re.search(
+            rf"(?:MILESTONES:|,){name}:(\d+)", line,
+        )) else 0
+        for name in USB_MILESTONES
+    }
+
+
+def application_counts(registers: str) -> dict[str, int]:
+    result: dict[str, int] = {}
+    for milestone in MILESTONES:
+        match = re.search(
+            rf"(?:APPLICATION_TRACE=|,){milestone}:(\d+)@", registers,
+        )
+        result[milestone] = int(match.group(1)) if match else 0
+    return result
+
+
+def incidents(registers: str) -> list[str]:
+    result: list[str] = []
+    for name in ("ROM_MISSING", "INVALID_CONTROL", "UNSUPPORTED"):
+        value = state_line(registers, name)
+        if value != "none" and not value.startswith("none "):
+            result.append(f"{name}={value}")
+    return result
+
+
+def new_writes(previous_count: int, count: int,
+               ring: list[EventWrite]) -> tuple[int, list[EventWrite]]:
+    if count <= previous_count:
+        return 0, []
+    delta = count - previous_count
+    if delta >= len(ring):
+        return max(0, delta - len(ring)), ring
+    return 0, ring[-delta:]
+
+
+def format_values(changed: dict[str, tuple[int | None, int]]) -> str:
+    return " ".join(
+        f"{name}:{'----' if old is None else f'{old:04x}'}>{new:04x}"
+        for name, (old, new) in changed.items()
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8777")
+    parser.add_argument("--interval", type=float, default=0.25)
+    parser.add_argument("--timeout", type=float, default=2.0)
+    parser.add_argument(
+        "--startup-timeout",
+        type=float,
+        default=90.0,
+        help=(
+            "wait this long for the Web/QEMU endpoint before failing; large "
+            "checkpoints are hash-validated before the port starts listening"
+        ),
+    )
+    parser.add_argument("--duration", type=float, default=120.0)
+    parser.add_argument("--stop-at", choices=("done", "launch", "menu",
+                                               "usb-trigger", "incident",
+                                               "never"),
+                        default="launch")
+    args = parser.parse_args()
+
+    started = time.monotonic()
+    previous_values: dict[str, int] = {}
+    previous_writes = 0
+    previous_milestones = {name: 0 for name in MILESTONES}
+    previous_usb_values: dict[str, int] = {}
+    previous_usb_writes = 0
+    previous_usb_milestones = {name: 0 for name in USB_MILESTONES}
+    connected = False
+    while args.duration <= 0 or time.monotonic() - started < args.duration:
+        try:
+            state = fetch_state(args.url, args.timeout)
+        except (OSError, URLError, ValueError):
+            if connected or time.monotonic() - started >= args.startup_timeout:
+                raise
+            time.sleep(max(args.interval, 0.05))
+            continue
+        if not connected:
+            connected = True
+            print(
+                f"{time.monotonic() - started:8.3f}s READY {args.url}",
+                flush=True,
+            )
+        registers = str(state.get("registers", ""))
+        now = time.monotonic() - started
+        values = parse_values(registers)
+        changed = {
+            name: (previous_values.get(name), value)
+            for name, value in values.items()
+            if previous_values.get(name) != value and
+            (not previous_values or name not in ("0494", "0496", "0498", "TICK"))
+        }
+        if changed:
+            print(f"{now:8.3f}s STATE {format_values(changed)}", flush=True)
+            previous_values = values
+
+        write_count, ring = parse_writes(registers)
+        lost, writes = new_writes(previous_writes, write_count, ring)
+        if lost:
+            print(f"{now:8.3f}s WRITES lost={lost} (poll slower than ring)",
+                  flush=True)
+        sequence = write_count - len(writes) + 1
+        for offset, write in enumerate(writes):
+            print(f"{now:8.3f}s WRITE #{sequence + offset} "
+                  f"{write.address:06x} {write.old:04x}>{write.new:04x}/"
+                  f"{write.bits} by {write.pc}", flush=True)
+        previous_writes = write_count
+
+        usb_values = parse_usb_values(registers)
+        usb_changed = {
+            name: (previous_usb_values.get(name), value)
+            for name, value in usb_values.items()
+            if (name not in USB_VOLATILE_VALUES and
+                previous_usb_values.get(name) != value)
+        }
+        if usb_changed:
+            print(f"{now:8.3f}s USB_STATE {format_values(usb_changed)}",
+                  flush=True)
+        previous_usb_values = usb_values
+
+        usb_write_count, usb_ring = parse_usb_writes(registers)
+        lost, usb_writes = new_writes(previous_usb_writes, usb_write_count,
+                                      usb_ring)
+        if lost:
+            print(f"{now:8.3f}s USB_WRITES lost={lost} "
+                  "(poll slower than ring)", flush=True)
+        sequence = usb_write_count - len(usb_writes) + 1
+        for offset, write in enumerate(usb_writes):
+            address = "SFRB0" if write.address == 0xFF00B0 else \
+                      f"{write.address:06x}"
+            print(f"{now:8.3f}s USB_WRITE #{sequence + offset} "
+                  f"{address} {write.old:04x}>{write.new:04x}/"
+                  f"{write.bits} by {write.pc}", flush=True)
+        previous_usb_writes = usb_write_count
+
+        usb_milestones = usb_milestone_counts(registers)
+        for name, count in usb_milestones.items():
+            if (name not in USB_VOLATILE_MILESTONES and
+                count != previous_usb_milestones[name]):
+                print(f"{now:8.3f}s USB_MILESTONE {name}={count}",
+                      flush=True)
+        previous_usb_milestones = usb_milestones
+
+        milestones = application_counts(registers)
+        for name, count in milestones.items():
+            if count != previous_milestones[name]:
+                print(f"{now:8.3f}s MILESTONE {name}={count}", flush=True)
+        previous_milestones = milestones
+
+        problems = incidents(registers)
+        if problems:
+            for problem in problems:
+                print(f"{now:8.3f}s INCIDENT {problem}", flush=True)
+            if args.stop_at in ("incident", "done", "launch", "menu"):
+                return 2
+        if args.stop_at == "done" and milestones["MODALDONE"]:
+            return 0
+        if args.stop_at == "launch" and milestones["LAUNCH"]:
+            return 0
+        if args.stop_at == "menu" and milestones["MENU"]:
+            return 0
+        if args.stop_at == "usb-trigger" and usb_milestones["TRIGGER"]:
+            return 0
+        time.sleep(max(args.interval, 0.01))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
