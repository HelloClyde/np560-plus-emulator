+static char *np560_get_debug_data_write(Object *obj, Error **errp)
+{
+    NP560MachineState *s = NP560_MACHINE(obj);
+
+    return g_strdup(s->debug_data_write ? s->debug_data_write : "");
+}
+
+static void np560_set_debug_data_write(Object *obj, const char *value,
+                                       Error **errp)
+{
+    NP560MachineState *s = NP560_MACHINE(obj);
+    const char *hex;
+    uint64_t address;
+    size_t hex_length;
+    size_t size;
+    size_t i;
+    g_autofree uint8_t *bytes = NULL;
+
+    if (!value || !*value) {
+        g_clear_pointer(&s->debug_data_write, g_free);
+        return;
+    }
+    if (!np560_parse_debug_address(value, &hex, &address, errp)) {
+        return;
+    }
+    hex_length = strlen(hex);
+    if (!hex_length || (hex_length & 1) || hex_length > 8192) {
+        error_setg(errp, "NP560+ debug data hex payload must contain 1..4096 bytes");
+        return;
+    }
+    size = hex_length / 2;
+    if (!np560_debug_data_range(s, address, size, errp)) {
+        return;
+    }
+    bytes = g_malloc(size);
+    for (i = 0; i < size; i++) {
+        int high = g_ascii_xdigit_value(hex[i * 2]);
+        int low = g_ascii_xdigit_value(hex[i * 2 + 1]);
+
+        if (high < 0 || low < 0) {
+            error_setg(errp, "NP560+ debug data payload is not hexadecimal");
+            return;
+        }
+        bytes[i] = (high << 4) | low;
+    }
+    memcpy(memory_region_get_ram_ptr(&s->data) + address, bytes, size);
+    g_free(s->debug_data_write);
+    s->debug_data_write = g_strdup(value);
+}
