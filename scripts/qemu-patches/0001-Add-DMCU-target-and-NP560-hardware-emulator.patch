+                page_oob = HEADER_SIZE + DATA_SIZE + FACTORY_PHYSICAL_PAGE * PAGE_OOB
+                target.seek(page_data)
+                target.write(b"\xFF" * PAGE_DATA)
+                target.seek(page_oob)
+                target.write(b"\xFF" * PAGE_OOB)
