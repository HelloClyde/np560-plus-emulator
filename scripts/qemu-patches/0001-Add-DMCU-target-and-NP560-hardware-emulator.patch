+                target.truncate(HEADER_SIZE + DATA_SIZE + OOB_SIZE)
+                header = bytearray(b"\xFF" * HEADER_SIZE)
+                header[:8] = CHECKPOINT_MAGIC
+                struct.pack_into(
+                    "<6I2Q2I",
