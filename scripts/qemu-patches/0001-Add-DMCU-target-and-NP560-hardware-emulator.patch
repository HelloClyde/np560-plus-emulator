diff --git a/test-np560-st7529.ps1 b/test-np560-st7529.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..3a0ea090f48d56309906e5f94f77f82bdd52237d
--- /dev/null
+++ b/test-np560-st7529.ps1
@@ -0,0 +1,78 @@
+[CmdletBinding()]
+param([int]$Port = 8768)
+
+$ErrorActionPreference = 'Stop'
+$temporaryRoot = [IO.Path]::GetFullPath([IO.Path]::GetTempPath())
+$firmware = Join-Path $temporaryRoot (
+    'np560-st7529-test-{0}.bin' -f [guid]::NewGuid().ToString('N')
+)
+$words = [Collections.Generic.List[uint16]]::new()
+
+function Add-Word([uint16]$Value) { $words.Add($Value) }
+function Add-Move([uint16]$Register, [uint16]$Value) {
+    Add-Word ([uint16](0x68F0 -bor $Register))
+    Add-Word $Value
+}
+function Add-ByteWrite([bool]$Data, [byte]$Value) {
+    Add-Word 0x69F4                 # MOVB RB4, #Value
+    Add-Word ([uint16]$Value)
+    Add-Word ([uint16]$(if ($Data) { 0x0B14 } else { 0x0B04 }))
+}
+function Add-Command([byte]$Command, [byte[]]$Parameters = @()) {
+    Add-ByteWrite $false $Command
+    foreach ($parameter in $Parameters) { Add-ByteWrite $true $parameter }
+}
+
+Add-Word 0x3F10                     # IGNDS: next DS write is unbanked
+Add-Word 0x6811                     # MOV DS1, #0x01E0
+Add-Word 0x01E0
+Add-Move 0 0x8001                   # command port -> 0xF00001
+Add-Move 1 0x8003                   # data port -> 0xF00003
+Add-Command 0x30
+Add-Command 0x94
+Add-Command 0xBC ([byte[]](0x00, 0x00, 0x02))
+Add-Command 0xBB ([byte[]](0x01))       # NP560 V3.80 COMSCN setting
+Add-Command 0x15 ([byte[]](0x00, 0x00))
+Add-Command 0x75 ([byte[]](0x14, 0x14)) # GRAM20 -> physical panel row 119
+Add-Command 0x5C
+foreach ($pixel in [byte[]](0x20, 0x20, 0x20)) {
+    Add-ByteWrite $true $pixel
+}
+Add-Command 0x75 ([byte[]](0x4F, 0x4F)) # GRAM79 -> physical panel row 60
+Add-Command 0x5C
+foreach ($pixel in [byte[]](0x60, 0x60, 0x60)) {
+    Add-ByteWrite $true $pixel
+}
+Add-Command 0x75 ([byte[]](0x50, 0x50)) # GRAM80 -> physical panel row 59
+Add-Command 0x5C
+foreach ($pixel in [byte[]](0xA0, 0xA0, 0xA0)) {
+    Add-ByteWrite $true $pixel
+}
+Add-Command 0x75 ([byte[]](0x8B, 0x8B)) # GRAM139 -> physical panel row 0
+Add-Command 0x5C
+foreach ($pixel in [byte[]](0xE0, 0xE0, 0xE0)) {
+    Add-ByteWrite $true $pixel
+}
+Add-Command 0xAF
+Add-Word 0xD0FF                     # RJMP ALWAYS, self
+
+$image = [byte[]]::new(0x400000)
+for ($index = 0; $index -lt $words.Count; $index++) {
+    $image[$index * 2] = $words[$index] -band 0xFF
+    $image[$index * 2 + 1] = ($words[$index] -shr 8) -band 0xFF
+}
+[IO.File]::WriteAllBytes($firmware, $image)
+
+try {
+    & (Join-Path $PSScriptRoot 'test-np560-web.ps1') `
+        -Firmware $firmware -Port $Port -FrameSource lcd `
+        -ExpectNonzero -InitialDelayMs 100 `
+        -ExpectedPixel '0,0,28','0,59,20','0,60,12','0,119,4' `
+        -RegisterPattern 'ST7529=on.*COM=1.*WINDOW=C0-0,L139-139.*FRAMES=4'
+} finally {
+    $resolved = [IO.Path]::GetFullPath($firmware)
+    if ($resolved.StartsWith($temporaryRoot, [StringComparison]::OrdinalIgnoreCase) -and
+        (Test-Path -LiteralPath $resolved -PathType Leaf)) {
+        Remove-Item -LiteralPath $resolved -Force
+    }
+}
diff --git a/test-np560-system-boot.ps1 b/test-np560-system-boot.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..e8446d227641dbe5044c225b2c1b4ee9c31aa3a4
--- /dev/null
+++ b/test-np560-system-boot.ps1
@@ -0,0 +1,176 @@
+[CmdletBinding()]
+param(
+    [switch]$PrintLcdTrace,
+    [switch]$PrintCpuState,
+    [string]$LcdFrameOutput,
+    [string]$NativeFramebufferOutput,
+    [string]$NativeBackbufferOutput,
+    [switch]$LogUnimp,
+    [switch]$SkipEvent,
+    [switch]$SkipLcdContentCheck,
+    [double]$IdleTimeout = 30,
+    [string[]]$RawEvent,
+    [string[]]$MatrixEvent,
+    [switch]$AllMatrixEvents,
+    [switch]$RowIsolatedMatrix,
+    [ValidateRange(0, 63)]
+    [int]$MatrixStart = 0,
+    [ValidateRange(1, 64)]
+    [int]$MatrixCount = 64,
+    [string]$NandCheckpoint
+)
+
+$ErrorActionPreference = 'Stop'
+$project = Split-Path $PSScriptRoot -Parent
+$updateSource = Get-ChildItem -LiteralPath $project -Recurse -File `
+    -Filter 'NP560+.upd' | Select-Object -First 1 -ExpandProperty FullName
+$firmwareSource = Get-ChildItem -LiteralPath $project -Recurse -File `
+    -Filter 'NP560.PRG' | Select-Object -First 1 -ExpandProperty FullName
+if (-not $updateSource -or -not $firmwareSource) {
+    throw 'Unable to locate the vendor NP560 update inputs.'
+}
+$temporaryRoot = [IO.Path]::GetFullPath([IO.Path]::GetTempPath())
+$workDirectory = Join-Path $temporaryRoot (
+    'np560-system-boot-{0}' -f [guid]::NewGuid().ToString('N')
+)
+[IO.Directory]::CreateDirectory($workDirectory) | Out-Null
+
+try {
+    # The locally installed Windows Python runs in legacy argv mode and
+    # corrupts the Chinese directory name.  Stage both immutable vendor
+    # inputs under the already-isolated ASCII temporary path before invoking
+    # either Python or WSL; this changes neither image.
+    $update = Join-Path $workDirectory 'NP560+.upd'
+    $firmware = Join-Path $workDirectory 'NP560.PRG'
+    Copy-Item -LiteralPath $updateSource -Destination $update
+    Copy-Item -LiteralPath $firmwareSource -Destination $firmware
+
+    $rom = Join-Path $workDirectory 'np560-system-rom.bin'
+    & python (Join-Path $project 'disassembly\build_np560_reconstructed_rom.py') `
+        --initializer-overlay-probe --probe-system-main `
+        --probe-resident-app-state-guard --probe-rom-08-427e-return `
+        --probe-rom-01-0200-return `
+        --output $rom | Out-Null
+    if ($LASTEXITCODE -ne 0) { throw 'Unable to build system ROM.' }
+
+    if ($NandCheckpoint) {
+        $nand = (Resolve-Path -LiteralPath $NandCheckpoint).Path
+    } else {
+        & python (Join-Path $project 'disassembly\np560_upd.py') $update `
+            --extract-dir $workDirectory --extract-slot 3 | Out-Null
+        if ($LASTEXITCODE -ne 0) { throw 'Unable to extract NAND image.' }
+        $nand = Join-Path $workDirectory 'NP560_NAND_IMAGE.bin'
+    }
+
+    $paths = @{}
+    foreach ($item in @(
+        @{ Name = 'script'; Path = (Join-Path $PSScriptRoot 'test_np560_system_boot.py') },
+        @{ Name = 'firmware'; Path = $firmware },
+        @{ Name = 'rom'; Path = $rom },
+        @{ Name = 'nand'; Path = $nand }
+    )) {
+        $windows = (Resolve-Path -LiteralPath $item.Path).Path -replace '\\', '/'
+        $paths[$item.Name] = (& wsl.exe -d Ubuntu2 -- wslpath -a -- $windows).Trim()
+        if ($LASTEXITCODE -ne 0 -or -not $paths[$item.Name]) {
+            throw "Unable to translate $($item.Name) path into WSL."
+        }
+    }
+
+    $testArguments = @(
+        $paths.script,
+        '--qemu', '/mnt/e/qemu-dmcu-build/qemu-system-dmcu',
+        '--firmware', $paths.firmware,
+        '--soc-rom', $paths.rom,
+        $(if ($NandCheckpoint) { '--nand-checkpoint' } else { '--nand' }),
+        $paths.nand,
+        '--idle-timeout', [string]$IdleTimeout
+    )
+    if ($PrintLcdTrace) {
+        $testArguments += '--print-lcd-trace'
+    }
+    if ($PrintCpuState) {
+        $testArguments += '--print-cpu-state'
+    }
+    if ($LcdFrameOutput) {
+        $frameParent = Split-Path -Parent $LcdFrameOutput
+        if ($frameParent -and -not (Test-Path -LiteralPath $frameParent)) {
+            [IO.Directory]::CreateDirectory($frameParent) | Out-Null
+        }
+        $frameWindows = [IO.Path]::GetFullPath($LcdFrameOutput) -replace '\\', '/'
+        $frameWsl = (& wsl.exe -d Ubuntu2 -- wslpath -a -- $frameWindows).Trim()
+        if ($LASTEXITCODE -ne 0 -or -not $frameWsl) {
+            throw 'Unable to translate the LCD frame output path into WSL.'
+        }
+        $testArguments += @('--lcd-frame-output', $frameWsl)
+    }
+    foreach ($memoryOutput in @(
+        @{ Value = $NativeFramebufferOutput; Option = '--native-framebuffer-output' },
+        @{ Value = $NativeBackbufferOutput; Option = '--native-backbuffer-output' }
+    )) {
+        if (-not $memoryOutput.Value) { continue }
+        $memoryParent = Split-Path -Parent $memoryOutput.Value
+        if ($memoryParent -and -not (Test-Path -LiteralPath $memoryParent)) {
+            [IO.Directory]::CreateDirectory($memoryParent) | Out-Null
+        }
+        $memoryWindows = [IO.Path]::GetFullPath($memoryOutput.Value) -replace '\\', '/'
+        $memoryWsl = (& wsl.exe -d Ubuntu2 -- wslpath -a -- $memoryWindows).Trim()
+        if ($LASTEXITCODE -ne 0 -or -not $memoryWsl) {
+            throw "Unable to translate $($memoryOutput.Option) path into WSL."
+        }
+        $testArguments += @($memoryOutput.Option, $memoryWsl)
+    }
+    if ($LogUnimp) {
+        $testArguments += '--log-unimp'
+    }
+    if ($SkipEvent) {
+        $testArguments += '--skip-event'
+    }
+    if ($SkipLcdContentCheck) {
+        $testArguments += '--skip-lcd-content-check'
+    }
+    foreach ($eventValue in $RawEvent) {
+        $testArguments += @('--raw-event', $eventValue)
+    }
+    foreach ($eventValue in $MatrixEvent) {
+        $testArguments += @('--matrix-event', $eventValue)
+    }
+    if ($AllMatrixEvents) {
+        if (-not $RowIsolatedMatrix) {
+            $matrixArguments = $testArguments + @(
+                '--all-matrix-events',
+                '--matrix-start', [string]$MatrixStart,
+                '--matrix-count', [string]$MatrixCount
+            )
+            & wsl.exe -d Ubuntu2 -- python3 @matrixArguments
+            if ($LASTEXITCODE -ne 0) {
+                throw 'Native single-process matrix regression failed.'
+            }
+        } else {
+            # Retain row-isolated mode as a focused keyboard-hardware test.
+            $matrixEnd = [Math]::Min(64, $MatrixStart + $MatrixCount)
+            for ($matrixChunkStart = $MatrixStart;
+                 $matrixChunkStart -lt $matrixEnd;
+                 $matrixChunkStart += 8) {
+                $chunkCount = [Math]::Min(8, $matrixEnd - $matrixChunkStart)
+                $chunkArguments = $testArguments + @(
+                    '--all-matrix-events',
+                    '--matrix-start', [string]$matrixChunkStart,
+                    '--matrix-count', [string]$chunkCount
+                )
+                & wsl.exe -d Ubuntu2 -- python3 @chunkArguments
+                if ($LASTEXITCODE -ne 0) {
+                    throw "Native matrix chunk starting at $matrixChunkStart failed."
+                }
+            }
+        }
+    } else {
+        & wsl.exe -d Ubuntu2 -- python3 @testArguments
+        if ($LASTEXITCODE -ne 0) { throw 'Native system boot test failed.' }
+    }
+} finally {
+    $resolved = [IO.Path]::GetFullPath($workDirectory)
+    if ($resolved.StartsWith($temporaryRoot, [StringComparison]::OrdinalIgnoreCase) -and
+        (Test-Path -LiteralPath $resolved -PathType Container)) {
+        Remove-Item -LiteralPath $resolved -Recurse -Force
+    }
+}
diff --git a/test-np560-system-lifecycle.ps1 b/test-np560-system-lifecycle.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..f534c762b5a32c8e3b27e25e5dd9e4d713d38e4d
--- /dev/null
+++ b/test-np560-system-lifecycle.ps1
@@ -0,0 +1,30 @@
+[CmdletBinding()]
+param(
+    [ValidateRange(1, 256)]
+    [int]$Count = 64,
+    [double]$IdleTimeout = 90,
+    [string]$NandCheckpoint
+)
+
+$ErrorActionPreference = 'Stop'
+$project = Split-Path $PSScriptRoot -Parent
+if (-not $NandCheckpoint) {
+    $candidate = Join-Path $project 'tmp\np560-v380-flashed-ecc.nand'
+    if (Test-Path -LiteralPath $candidate -PathType Leaf) {
+        $NandCheckpoint = $candidate
+    }
+}
+
+$events = [string[]]@(1..$Count | ForEach-Object { '0x100' })
+$parameters = @{
+    IdleTimeout = $IdleTimeout
+    RawEvent = $events
+}
+if ($NandCheckpoint) {
+    $parameters.NandCheckpoint = $NandCheckpoint
+}
+
+& (Join-Path $PSScriptRoot 'test-np560-system-boot.ps1') @parameters
+if ($LASTEXITCODE -ne 0) {
+    throw "NP560 lifecycle stress failed after at most $Count events."
+}
diff --git a/test-np560-system-web.ps1 b/test-np560-system-web.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..cd55f01a27da2ae477245cc59d024ac078322b63
--- /dev/null
+++ b/test-np560-system-web.ps1
@@ -0,0 +1,61 @@
+[CmdletBinding()]
+param(
+    [int]$Port = 8766,
+    [string]$NandCheckpoint
+)
+
+$ErrorActionPreference = 'Stop'
+$project = Split-Path $PSScriptRoot -Parent
+if (-not $NandCheckpoint) {
+    foreach ($candidate in @(
+        (Join-Path $project 'tmp\np560-v380-flashed-ecc.nand'),
+        'E:\np560-data\np560-v380-flashed-ecc.nand'
+    )) {
+        if (Test-Path -LiteralPath $candidate -PathType Leaf) {
+            $NandCheckpoint = $candidate
+            break
+        }
+    }
+}
+$firmwareSource = Get-ChildItem -LiteralPath $project -Recurse -File `
+    -Filter 'NP560.PRG' | Select-Object -First 1 -ExpandProperty FullName
+if (-not $firmwareSource) {
+    throw 'Unable to locate the vendor NP560 firmware.'
+}
+if (-not $NandCheckpoint -or
+    -not (Test-Path -LiteralPath $NandCheckpoint -PathType Leaf)) {
+    throw "NAND checkpoint not found: $NandCheckpoint"
+}
+
+$temporaryRoot = [IO.Path]::GetFullPath([IO.Path]::GetTempPath())
+$workDirectory = Join-Path $temporaryRoot (
+    'np560-system-web-{0}' -f [guid]::NewGuid().ToString('N')
+)
+[IO.Directory]::CreateDirectory($workDirectory) | Out-Null
+
+try {
+    # PowerShell 5 and legacy Windows Python corrupt the Chinese source path
+    # in argv, so stage immutable inputs under a disposable ASCII path.
+    $firmware = Join-Path $workDirectory 'NP560.PRG'
+    Copy-Item -LiteralPath $firmwareSource -Destination $firmware
+
+    $rom = Join-Path $workDirectory 'np560-system-rom.bin'
+    & python (Join-Path $project 'disassembly\build_np560_reconstructed_rom.py') `
+        --initializer-overlay-probe --probe-system-main `
+        --probe-resident-app-state-guard --probe-rom-08-427e-return `
+        --probe-rom-01-0200-return `
+        --output $rom | Out-Null
+    if ($LASTEXITCODE -ne 0) { throw 'Unable to build system ROM.' }
+
+    & (Join-Path $PSScriptRoot 'test-np560-web.ps1') `
+        -Firmware $firmware -SocRom $rom -SocRomSkeleton `
+        -NandCheckpoint $NandCheckpoint -FrameSource lcd -ExpectNative -Port $Port
+    if ($LASTEXITCODE -ne 0) { throw 'Native system Web test failed.' }
+} finally {
+    $resolved = [IO.Path]::GetFullPath($workDirectory)
+    if ($resolved.StartsWith($temporaryRoot,
+            [StringComparison]::OrdinalIgnoreCase) -and
+        (Test-Path -LiteralPath $resolved -PathType Container)) {
+        Remove-Item -LiteralPath $resolved -Recurse -Force
+    }
+}
diff --git a/test-np560-web.ps1 b/test-np560-web.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..13a853da52ac696c7000fe703097192c68018790
--- /dev/null
+++ b/test-np560-web.ps1
@@ -0,0 +1,776 @@
+[CmdletBinding()]
+param(
+    [string]$Firmware = (Join-Path (Split-Path $PSScriptRoot -Parent) 'NP560+V3.80版系统升级程序\NP560.PRG'),
+    [string]$SocRom,
+    [switch]$SocRomSkeleton,
+    [string]$DriverCode,
+    [string]$BurnCode,
+    [string]$NandImage,
+    [string]$NandCheckpoint,
+    [string]$NandSaveOnExit,
+    [ValidateSet('firmware', 'usb', 'burn', 'driver')]
+    [string]$BootMode = 'firmware',
+    [int]$Port = 8766,
+    [ValidateRange(30, 1800)]
+    [int]$ServerTimeoutSeconds = 180,
+    [ValidateRange(-1, 20)]
+    [int]$IcountShift = -1,
+    [switch]$ExpectNonzero,
+    [switch]$ExpectHle,
+    [switch]$RomHle,
+    [switch]$HleUi,
+    [switch]$ExpectNative,
+    [switch]$ExpectModalPolling,
+    [uint32]$StartupContext = 0,
+    [int]$InitialDelayMs = 0,
+    [int]$MinimumLcdCalls = 0,
+    [string]$RegisterPattern,
+    [string[]]$ExpectedPixel,
+    [ValidateSet('memory', 'data', 'lcd')]
+    [string]$FrameSource = 'memory',
+    [uint32]$MemoryBase = 0xEF0000
+)
+
+$ErrorActionPreference = 'Stop'
+$distro = 'Ubuntu2'
+$qemu = '/mnt/e/qemu-dmcu-build/qemu-system-dmcu'
+$scriptWindows = Join-Path $PSScriptRoot 'web\np560_web.py'
+$shutdownToken = [guid]::NewGuid().ToString('N')
+
+$firmwareWindows = (Resolve-Path -LiteralPath $Firmware).Path -replace '\\', '/'
+$scriptWindows = (Resolve-Path -LiteralPath $scriptWindows).Path -replace '\\', '/'
+$wslFirmware = (& wsl.exe -d $distro -- wslpath -a -- $firmwareWindows).Trim()
+$wslScript = (& wsl.exe -d $distro -- wslpath -a -- $scriptWindows).Trim()
+if ($LASTEXITCODE -ne 0 -or -not $wslFirmware -or -not $wslScript) {
+    throw 'Unable to translate test paths into WSL.'
+}
+
+$arguments = @(
+    '-d', $distro, '--', 'timeout', "${ServerTimeoutSeconds}s", 'python3', $wslScript,
+    '--qemu', $qemu, '--firmware', $wslFirmware, '--port', [string]$Port,
+    '--startup-context', [string]$StartupContext, '--boot-mode', $BootMode,
+    '--shutdown-token', $shutdownToken
+)
+if ($IcountShift -ge 0) {
+    $arguments += @('--icount-shift', [string]$IcountShift)
+}
+$enableHleUi = $HleUi -or $ExpectHle
+$enableRomHle = $RomHle -or $enableHleUi
+if ($enableRomHle) {
+    $arguments += '--rom-hle'
+}
+if ($enableHleUi) {
+    $arguments += '--hle-ui'
+}
+if ($SocRom) {
+    $socRomWindows = (Resolve-Path -LiteralPath $SocRom).Path -replace '\\', '/'
+    $wslSocRom = (& wsl.exe -d $distro -- wslpath -a -- $socRomWindows).Trim()
+    if ($LASTEXITCODE -ne 0 -or -not $wslSocRom) {
+        throw 'Unable to translate the SoC ROM test path into WSL.'
+    }
+    $arguments += @('--soc-rom', $wslSocRom)
+    if ($SocRomSkeleton) {
+        $arguments += '--soc-rom-skeleton'
+    }
+} elseif ($SocRomSkeleton) {
+    throw 'SocRomSkeleton requires -SocRom.'
+}
+if ($DriverCode) {
+    $driverWindows = (Resolve-Path -LiteralPath $DriverCode).Path -replace '\\', '/'
+    $wslDriver = (& wsl.exe -d $distro -- wslpath -a -- $driverWindows).Trim()
+    if ($LASTEXITCODE -ne 0 -or -not $wslDriver) {
+        throw 'Unable to translate the update driver path into WSL.'
+    }
+    $arguments += @('--driver-code', $wslDriver)
+}
+if ($BurnCode) {
+    $burnWindows = (Resolve-Path -LiteralPath $BurnCode).Path -replace '\\', '/'
+    $wslBurn = (& wsl.exe -d $distro -- wslpath -a -- $burnWindows).Trim()
+    if ($LASTEXITCODE -ne 0 -or -not $wslBurn) {
+        throw 'Unable to translate the burner-code test path into WSL.'
+    }
+    $arguments += @('--burn-code', $wslBurn)
+}
+if ($NandImage) {
+    $nandWindows = (Resolve-Path -LiteralPath $NandImage).Path -replace '\\', '/'
+    $wslNand = (& wsl.exe -d $distro -- wslpath -a -- $nandWindows).Trim()
+    if ($LASTEXITCODE -ne 0 -or -not $wslNand) {
+        throw 'Unable to translate the NAND-image test path into WSL.'
+    }
+    $arguments += @('--nand-image', $wslNand)
+}
+if ($NandCheckpoint) {
+    if ($NandImage) {
+        throw 'NandImage and NandCheckpoint are mutually exclusive.'
+    }
+    $checkpointWindows = (Resolve-Path -LiteralPath $NandCheckpoint).Path -replace '\\', '/'
+    $wslCheckpoint = (& wsl.exe -d $distro -- wslpath -a -- $checkpointWindows).Trim()
+    if ($LASTEXITCODE -ne 0 -or -not $wslCheckpoint) {
+        throw 'Unable to translate the NAND-checkpoint path into WSL.'
+    }
+    $arguments += @('--nand-checkpoint', $wslCheckpoint)
+}
+if ($NandSaveOnExit) {
+    $saveWindows = [IO.Path]::GetFullPath($NandSaveOnExit)
+    $saveParent = Split-Path -Parent $saveWindows
+    if ($saveParent -and -not (Test-Path -LiteralPath $saveParent)) {
+        [IO.Directory]::CreateDirectory($saveParent) | Out-Null
+    }
+    $saveWslInput = $saveWindows -replace '\\', '/'
+    $wslSave = (& wsl.exe -d $distro -- wslpath -a -- $saveWslInput).Trim()
+    if ($LASTEXITCODE -ne 0 -or -not $wslSave) {
+        throw 'Unable to translate the NAND save test path into WSL.'
+    }
+    $arguments += @('--nand-save-on-exit', $wslSave)
+}
+if ($BootMode -eq 'driver' -and -not $DriverCode) {
+    throw 'BootMode driver requires -DriverCode.'
+}
+$serverProcess = Start-Process -FilePath 'wsl.exe' -ArgumentList $arguments `
+    -PassThru -WindowStyle Hidden
+$stateUri = if ($FrameSource -eq 'lcd') {
+    "http://127.0.0.1:$Port/api/state"
+} else {
+    "http://127.0.0.1:$Port/api/state?source=$FrameSource&base=0x$($MemoryBase.ToString('X6'))&size=3600"
+}
+
+try {
+    if ($InitialDelayMs -gt 0) {
+        Start-Sleep -Milliseconds $InitialDelayMs
+    }
+    $state = $null
+    $lastStateError = $null
+    for ($attempt = 0; $attempt -lt 60 -and $null -eq $state; $attempt++) {
+        try {
+            $state = Invoke-RestMethod -Uri $stateUri -TimeoutSec 1
+        } catch {
+            $lastStateError = $_.Exception.Message
+            Start-Sleep -Milliseconds 100
+        }
+    }
+    if ($null -eq $state) {
+        $serverProcess.Refresh()
+        throw "Web API did not become ready (process exit=$($serverProcess.ExitCode)): $lastStateError"
+    }
+
+    if ($ExpectNative) {
+        $nativeReady = $false
+        for ($attempt = 0; $attempt -lt 240; $attempt++) {
+            $state = Invoke-RestMethod -Uri $stateUri -TimeoutSec 2
+            $residentWitness = (
+                $state.registers -match
+                    'CONTROL_TRACE=[^\r\n]*3b:f7c6/bd33>33:2562' -or
+                $state.registers -match '\bF010_READS=([5-9]|[1-9]\d+)' -or
+                ($state.registers -match
+                    '(?:APPLICATION_TRACE=|,)MODALHEAD:([1-9]\d*)@' -and
+                 $state.registers -match '\bMATRIX_READS[:=]([1-9]\d*)')
+            )
+            $nativeReady = (
+                $state.registers -match 'ROM_HLE=off' -and
+                $state.registers -match 'ROM_MISSING=none' -and
+                $state.registers -match 'INVALID_CONTROL=none' -and
+                $state.registers -match 'UNSUPPORTED=none' -and
+                $state.registers -match 'FIRST_LOW_FP=none' -and
+                $state.registers -match 'FIRST_LOW_SP=none' -and
+                $state.registers -match 'NAND=EC:DC:10:95' -and
+                $state.registers -match 'ERROR=0' -and
+                $residentWitness -and
+                $state.lcd_state -match '\bFRAMES=([1-9]\d*)'
+            )
+            if ($nativeReady) { break }
+            $serverProcess.Refresh()
+            if ($serverProcess.HasExited) {
+                throw "Native Web guest exited with $($serverProcess.ExitCode).`n$($state.registers)"
+            }
+            Start-Sleep -Milliseconds 50
+        }
+        if (-not $nativeReady) {
+            throw "Native firmware did not reach the resident event loop.`n$($state.registers)"
+        }
+    }
+
+    $frame = [Convert]::FromBase64String($state.frame)
+    $expectedFrameLength = if ($FrameSource -eq 'lcd') { 240 * 120 } else { 3600 }
+    if ($frame.Length -ne $expectedFrameLength) {
+        throw "Expected a $expectedFrameLength-byte frame, received $($frame.Length)."
+    }
+    if ($FrameSource -eq 'lcd') {
+        if ($state.format -ne 'gray5' -or
+            $state.lcd_state -notmatch '^ST7529 ') {
+            throw 'QEMU does not expose the ST7529 hardware framebuffer.'
+        }
+    } elseif ($FrameSource -eq 'memory' -and
+              ($state.registers -notmatch 'HLE_FB=ef0000' -or
+               $state.registers -notmatch 'HLE_LCD_CALLS=')) {
+        throw 'QEMU CPU state does not expose the diagnostic HLE framebuffer.'
+    } elseif ($FrameSource -eq 'data' -and
