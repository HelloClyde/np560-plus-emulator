+++ b/hw/dmcu/np560.c
@@ -0,0 +1,15370 @@
+/* QEMU machine model for the Noah NP560+ learning computer. */
+
+#include "qemu/osdep.h"
+#include "qemu/datadir.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/boards.h"
+#include "hw/loader.h"
+#include "exec/address-spaces.h"
+#include "exec/exec-all.h"
+#include "exec/tb-flush.h"
+#include "sysemu/reset.h"
+#include "cpu.h"
+
+#define TYPE_NP560_MACHINE MACHINE_TYPE_NAME("np560")
+OBJECT_DECLARE_SIMPLE_TYPE(NP560MachineState, NP560_MACHINE)
+
+#define NP560_ST7529_BASE          0x00f00000u
+#define NP560_ST7529_MMIO_SIZE     4u
+#define NP560_ST7529_RAM_COLUMNS   85u
+#define NP560_ST7529_RAM_LINES     160u
+#define NP560_ST7529_PIXELS_PER_COLUMN 3u
+#define NP560_ST7529_RAM_WIDTH     (NP560_ST7529_RAM_COLUMNS * \
+                                    NP560_ST7529_PIXELS_PER_COLUMN)
+#define NP560_ST7529_FRAME_TRACE   64u
+#define NP560_ST7529_STATUS_TRACE  64u
+#define NP560_LCD_VISIBLE_LINE     20u
+#define NP560_LCD_ANNUNCIATOR_PLANES 2u
+#define NP560_LCD_ANNUNCIATOR_BYTES_PER_PLANE (DMCU_LCD_WIDTH / 8u)
+#define NP560_LCD_ANNUNCIATOR_BYTES \
+    (NP560_LCD_ANNUNCIATOR_PLANES * \
+     NP560_LCD_ANNUNCIATOR_BYTES_PER_PLANE)
+
+/*
+ * Clean-room controller contract used by the reconstructed resident ROM.
+ *
+ * The NP560+ is a 512-MiB product and the updater's Samsung EC:DC branch
+ * derives the matching 2-KiB-page geometry from extended ID byte 0x95.  The
+ * package does not contain the mask-ROM routine that bit-bangs the original
+ * GPIO pins.  Keep the reconstructed ABI in guest code and expose storage as
+ * a real MMIO device instead of intercepting SCALL on the host.  This private
+ * register window is intentionally separate from the observed F100 GPIO and
+ * F20A/F20C/F20E ECC registers; it is not claimed to be the vendor register
+ * layout.
+ */
+#define NP560_NAND_CTRL_BASE       0x0000f300u
+#define NP560_NAND_CTRL_SIZE       0x22u
+#define NP560_ECC_BASE             0x0000f20au
+#define NP560_ECC_SIZE             0x06u
+#define NP560_ADC_BASE             0x0000f2d0u
+#define NP560_ADC_SIZE             0x02u
+#define NP560_KEYBOARD_GPIO_BASE   0x0000f010u
+#define NP560_KEYBOARD_GPIO_SIZE   0x02u
+#define NP560_KEYBOARD_TRACE       32u
+#define NP560_MATRIX_TRACE         16u
+#define NP560_SYSTEM_CONTROL_TRACE 16u
+#define NP560_SYSTEM_CONTROL_BASE  0x0000f100u
+#define NP560_SYSTEM_CONTROL_SIZE  0x02u
+#define NP560_KEY_MATRIX_BASE      0x0000f160u
+#define NP560_KEY_MATRIX_SIZE      0x06u
+#define NP560_KEYBOARD_BASE        0x0000f340u
+#define NP560_KEYBOARD_SIZE        0x08u
+#define NP560_TIMER_BASE           0x00000494u
+#define NP560_TIMER_SIZE           0x06u
+#define NP560_TIMER_COUNT          3u
+#define NP560_TIMER_FREQUENCY      64u
+#define NP560_NAND_PAGE_DATA       2048u
+#define NP560_NAND_PAGE_OOB        64u
+#define NP560_NAND_PAGE_TOTAL      (NP560_NAND_PAGE_DATA + NP560_NAND_PAGE_OOB)
+#define NP560_NAND_OOB_STREAM_MAX  (4u * NP560_NAND_PAGE_OOB)
+#define NP560_NAND_FTL_SECTOR_DATA 512u
+#define NP560_NAND_FTL_SECTOR_ECC  8u
+#define NP560_NAND_PAGES_PER_BLOCK 64u
+#define NP560_NAND_BLOCKS          4096u
+#define NP560_NAND_PAGES           (NP560_NAND_PAGES_PER_BLOCK * NP560_NAND_BLOCKS)
+#define NP560_NAND_DATA_SIZE       ((size_t)NP560_NAND_PAGES * NP560_NAND_PAGE_DATA)
+#define NP560_NAND_OOB_SIZE        ((size_t)NP560_NAND_PAGES * NP560_NAND_PAGE_OOB)
+#define NP560_NAND_CHECKPOINT_HEADER_SIZE 64u
+#define NP560_NAND_CHECKPOINT_VERSION 1u
+#define NP560_MASKROM_HEADER_SIZE  0x200u
+#define NP560_NAND_TRACE           16u
+#define NP560_NAND_TRACE_PREFIX    8u
+#define NP560_NAND_CAFE_PREFIX     32u
+
+/*
+ * The application power-state path at 2D:2D98 copies 22 words from
+ * 2F:550C to data address 00:1002 and immediately jumps there.  Only this
+ * prefix is writable internal code RAM; execution after 00:102E falls
+ * through into resident ROM.  Map the same RAMBlock on the code bus so normal
+ * guest data writes install executable instructions and trigger QEMU's usual
+ * self-modifying-code invalidation.
+ */
+#define NP560_INTERNAL_CODE_PREFIX_BASE 0x00001002u
+#define NP560_INTERNAL_CODE_PREFIX_SIZE 0x0000002cu
+
+/*
+ * The exact application call at 21:C076 enters resident 05:2286 after the
+ * late loader has copied the complete 22:2286..22:2C8F body there.  This is
+ * an evidenced internal executable-RAM overlay, not immutable mask ROM.
+ * Alias only that closed function onto the code bus; the surrounding segment
+ * remains the reconstructed SoC ROM and the guest still performs every write.
+ */
+#define NP560_RESIDENT_RECORD_LOAD_OVERLAY_BASE 0x00052286u
+#define NP560_RESIDENT_RECORD_LOAD_OVERLAY_SIZE 0x00000a0au
+
+/*
+ * V3.80's fixed 20:0030 callback programs boundaries at segments 20 and 50,
+ * then clears data addresses 50:0000..53:FFFF while code continues to exist
+ * in those logical segments.  Until the complete memory-controller register
+ * semantics are recovered, expose the directly evidenced power-on layout:
+ * NOR is data-readable from 20:0000 through 4F:FFFF, segment 50 and above is
+ * writable external data RAM, and all 20:0000..5F:FFFF instruction fetches
+ * still come from the immutable PRG/NOR source image.
+ */
+#define NP560_PROGRAM_DATA_NOR_SIZE 0x00300000u
+/*
+ * Exact 26:371E obtains a free 0..1023 slot from 2F:4350, forms the two
+ * object-workspace bases by shifting the class keys 51:2770 and 51:27C6 left
+ * six bits, and publishes the resulting 24-bit addresses at A2:28FA/28FC.
+ * Natural execution therefore constructs mutable records at 49:DC00 and
+ * 49:F180 even though both lie inside the wider data-visible NOR window.
+ * Give only the allocator's evidenced 0x400-slot span plus the largest
+ * observed record tail (rounded to 0x500 bytes) its underlying external-RAM
+ * view.  Code fetches and every surrounding data address remain PRG/NOR.
+ */
+#define NP560_OPERATION_OBJECT_WORKSPACE_BASE 0x0049dc00u
+#define NP560_OPERATION_OBJECT_WORKSPACE_SIZE 0x00000500u
+#define NP560_MODAL_OBJECT_WORKSPACE_BASE 0x0049f180u
+#define NP560_MODAL_OBJECT_WORKSPACE_SIZE 0x00000500u
+#define NP560_MENU_TEXT_DATA_30_BASE 0x00303900u
+#define NP560_MENU_TEXT_DATA_30_SOURCE 0x004d3900u
+#define NP560_MENU_TEXT_DATA_30_SIZE 0x00000156u
+#define NP560_PIM_RESOURCE_DATA_2F_BASE 0x002ff46au
+#define NP560_PIM_RESOURCE_DATA_2F_SOURCE 0x004cf46au
+#define NP560_PIM_RESOURCE_DATA_2F_SIZE 0x00000032u
+/*
+ * The application validation worker at 2A:A746 passes data pointer 28:E368
+ * to the exact resident file-open routine at 1F:1F1A.  The flat destination
+ * is executable overlay code, while the same-linked +0x1d source at 45:E368
+ * is the complete word-serialized string "0:\\USERINFO.SYS" including its
+ * NUL terminator.  Redirect only those sixteen evidenced data bytes; code
+ * fetches at 28:E368 must continue to observe the executable overlay.
+ */
+#define NP560_USERINFO_PATH_DATA_28_BASE 0x0028e368u
+#define NP560_USERINFO_PATH_DATA_28_SOURCE 0x0045e368u
