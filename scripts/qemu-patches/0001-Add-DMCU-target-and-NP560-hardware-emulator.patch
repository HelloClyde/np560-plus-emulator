+static gsize np560_load_be16_image(MemoryRegion *region,
+                                   const char *region_name,
+                                   const char *path, hwaddr base)
+{
+    g_autofree char *filename = qemu_find_file(QEMU_FILE_TYPE_BIOS, path);
+    g_autofree gchar *image = NULL;
+    g_autoptr(GError) gerror = NULL;
+    gsize image_size = 0;
+    uint8_t *destination;
+    gsize offset;
+
+    if (!filename) {
+        error_report("Unable to find NP560+ word image '%s'", path);
+        exit(EXIT_FAILURE);
+    }
+    if (!g_file_get_contents(filename, &image, &image_size, &gerror)) {
+        error_report("Unable to load NP560+ word image '%s': %s", filename,
+                     gerror->message);
+        exit(EXIT_FAILURE);
+    }
+    if (!image_size || (image_size & 1)) {
+        error_report("NP560+ word image '%s' has invalid size 0x%zx",
+                     filename, image_size);
+        exit(EXIT_FAILURE);
+    }
+
+    memory_region_init_ram(region, NULL, region_name, image_size, &error_fatal);
+    destination = memory_region_get_ram_ptr(region);
+    for (offset = 0; offset < image_size; offset += 2) {
+        destination[offset] = image[offset + 1];
+        destination[offset + 1] = image[offset];
+    }
+    memory_region_add_subregion_overlap(get_system_memory(), base, region, 2);
+    return image_size;
+}
