+/*
+ * The exact V3.80 helper at 51:C1A4 resets F20A, feeds 256 consecutive
+ * 16-bit words through F20E, then reads F20A and F20C.  Its verifier at
+ * 51:6CB8 proves the result is a paired-parity SEC-DED code: after XORing a
+ * freshly calculated value with the stored value, F20A bits 3:0 select the
+ * bad bit and bits 15:4 select the bad word.  F20C is the complementary
+ * parity half.  This is also the documented layout of the conventional
+ * 32-bit Hsiao NAND ECC used for 16-bit data words.
+ *
+ * Keep this state independent from the clean-room NAND command ABI at F300.
+ * These three addresses are directly observed SoC registers, not ROM HLE.
+ */
+typedef struct NP560ECCState {
+    uint16_t parity;
+    uint16_t nparity;
+    uint16_t word_index;
+    uint64_t reset_writes;
+    uint64_t feed_writes;
+} NP560ECCState;
+
+/*
+ * V3.80's exact sampler at 4F:C336 writes (threshold << 2) | 2 to F2D0,
+ * reads the same word back, and treats bit 7 as the comparator output.  It
+ * scans thresholds 7 down to 0 and returns the first asserted level plus one,
+ * giving a directly evidenced 0..8 ADC contract.  Leaving F2D0 as RAM makes
+ * bit 7 permanently clear and eventually raises the firmware's debounced
+ * low-level system event, which closes every freshly opened menu.
+ */
+typedef struct NP560ADCState {
+    uint16_t control;
+    uint64_t reads;
+    uint64_t writes;
+} NP560ADCState;
