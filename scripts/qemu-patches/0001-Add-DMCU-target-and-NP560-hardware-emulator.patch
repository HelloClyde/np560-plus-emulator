index 0000000000000000000000000000000000000000..a0646bc3d8ebd40a58eb9023bbfe5f4e79ca91f8
--- /dev/null
+++ b/monitor_np560_file_records.py
@@ -0,0 +1,186 @@
+#!/usr/bin/env python3
+"""Print concise NP560 directory-record decisions from the Web endpoint."""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+import json
+import re
+import time
+from typing import Any
+from urllib.error import URLError
+from urllib.request import urlopen
+
+
+TRACE_LINE = "FILE_RECORD_CANDIDATES"
+RECORD_BYTES = 0x40
+
+
+@dataclass(frozen=True)
+class FileRecordCandidate:
+    sequence: int
+    call: int
+    output: int
+    selector: int
+    pointer: int
+    cursor: int
+    limit: int
+    span: int
+    active: int
+    compare_valid: bool
+    compare: int
+    data: bytes
+
+    @property
+    def short_name(self) -> str:
+        raw = self.data[:11]
+        base = raw[:8].decode("ascii", errors="replace").rstrip()
+        extension = raw[8:11].decode("ascii", errors="replace").rstrip()
+        return f"{base}.{extension}" if extension else base
+
+    @property
+    def attribute(self) -> int:
+        return self.data[11]
+
+    @property
+    def kind(self) -> str:
+        first = self.data[0]
+        if first == 0:
+            return "end"
+        if first == 0xE5:
+            return "deleted"
+        if self.attribute & 0x0F == 0x0F:
+            return "long-name"
+        if self.attribute & 0x08:
+            return "volume"
+        if self.attribute & 0x10:
+            return "directory"
+        return "file"
+
+    @property
+    def decision(self) -> str:
+        if self.kind in {"end", "deleted", "long-name"}:
+            return self.kind
+        if self.compare_valid and self.compare != 0:
+            return "selector-mismatch"
+        if self.attribute & 0x08:
+            return "volume-rejected"
+        return "eligible"
+
+
+ENTRY_RE = re.compile(
+    r"#(?P<sequence>\d+)/call(?P<call>\d+)/"
+    r"out(?P<output>[0-9a-fA-F]{6})/"
+    r"sel(?P<selector>[0-9a-fA-F]{6})/"
+    r"p(?P<pointer>[0-9a-fA-F]{6})/"
+    r"cur(?P<cursor>[0-9a-fA-F]{4})/"
+    r"lim(?P<limit>[0-9a-fA-F]{4})/"
+    r"span(?P<span>[0-9a-fA-F]{4})/"
+    r"act(?P<active>[0-9a-fA-F]{4})/"
+    r"cmp(?P<invalid>-?)(?P<compare>[0-9a-fA-F]{4})/"
+    rf"data(?P<data>[0-9a-fA-F]{{{RECORD_BYTES * 2}}})"
+)
+
+
+def fetch_state(url: str, timeout: float) -> dict[str, Any]:
+    with urlopen(f"{url.rstrip('/')}/api/state", timeout=timeout) as response:
+        state = json.load(response)
+    if not isinstance(state, dict) or "error" in state:
+        raise ValueError(f"invalid Web/QEMU state: {state!r}")
+    return state
+
+
+def state_line(registers: str, name: str) -> str:
+    prefix = f"{name}="
+    for line in registers.splitlines():
+        if line.startswith(prefix):
+            return line[len(prefix):].strip()
+    return "none"
+
+
+def parse_candidates(registers: str) -> tuple[int, list[FileRecordCandidate]]:
+    line = state_line(registers, TRACE_LINE)
+    header = re.fullmatch(r"COUNT:(\d+) TRACE:(.*)", line)
+    if not header:
+        return 0, []
+    count = int(header.group(1))
+    candidates: list[FileRecordCandidate] = []
+    for encoded in filter(None, header.group(2).split(";")):
+        match = ENTRY_RE.fullmatch(encoded)
+        if not match:
+            raise ValueError(f"invalid file-record candidate: {encoded!r}")
+        values = match.groupdict()
+        candidates.append(FileRecordCandidate(
+            sequence=int(values["sequence"]),
+            call=int(values["call"]),
+            output=int(values["output"], 16),
+            selector=int(values["selector"], 16),
+            pointer=int(values["pointer"], 16),
+            cursor=int(values["cursor"], 16),
+            limit=int(values["limit"], 16),
+            span=int(values["span"], 16),
+            active=int(values["active"], 16),
+            compare_valid=values["invalid"] != "-",
+            compare=int(values["compare"], 16),
+            data=bytes.fromhex(values["data"]),
+        ))
+    return count, candidates
+
+
+def format_candidate(candidate: FileRecordCandidate) -> str:
+    compare = f"{candidate.compare:04x}" if candidate.compare_valid else "----"
+    return (
+        f"#{candidate.sequence} call={candidate.call} "
+        f"name={candidate.short_name!r} attr={candidate.attribute:02x} "
+        f"kind={candidate.kind} compare={compare} "
+        f"cursor={candidate.cursor:04x}/{candidate.span:04x} "
+        f"decision={candidate.decision}"
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8778")
+    parser.add_argument("--interval", type=float, default=0.05)
+    parser.add_argument("--timeout", type=float, default=2.0)
+    parser.add_argument("--startup-timeout", type=float, default=90.0)
+    parser.add_argument("--duration", type=float, default=120.0)
+    parser.add_argument(
+        "--once", action="store_true",
+        help="print the current ring once (including an empty ring) and exit",
+    )
+    args = parser.parse_args()
+
+    started = time.monotonic()
+    connected = False
+    previous_sequence = 0
+    while args.duration <= 0 or time.monotonic() - started < args.duration:
+        try:
+            state = fetch_state(args.url, args.timeout)
+        except (OSError, URLError, ValueError):
+            if connected or time.monotonic() - started >= args.startup_timeout:
+                raise
+            time.sleep(max(args.interval, 0.01))
+            continue
+
+        now = time.monotonic() - started
+        if not connected:
+            connected = True
+            print(f"{now:8.3f}s READY {args.url}", flush=True)
+        count, candidates = parse_candidates(str(state.get("registers", "")))
+        for candidate in candidates:
+            if args.once or candidate.sequence > previous_sequence:
+                print(f"{now:8.3f}s {format_candidate(candidate)}", flush=True)
+        if candidates:
+            previous_sequence = max(candidate.sequence for candidate in candidates)
+        if args.once:
+            if not candidates:
+                print(f"{now:8.3f}s CANDIDATES count={count}", flush=True)
+            return 0
+        time.sleep(max(args.interval, 0.01))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/monitor_np560_hardware_init_return.py b/monitor_np560_hardware_init_return.py
new file mode 100644
index 0000000000000000000000000000000000000000..6ce4efc618ccda5ef4c068ca5351350e5befa165
--- /dev/null
+++ b/monitor_np560_hardware_init_return.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Compactly monitor the NP560 hardware-init far return frame via Web/QEMU."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import time
+from urllib.error import URLError
+from urllib.request import urlopen
+
+
+def fetch_registers(url: str, timeout: float) -> str:
+    with urlopen(f"{url.rstrip('/')}/api/state", timeout=timeout) as response:
+        state = json.load(response)
+    if not isinstance(state, dict) or "error" in state:
+        raise ValueError(f"invalid Web/QEMU state: {state!r}")
+    return str(state.get("registers", ""))
+
+
+def field(registers: str, prefix: str) -> str:
+    for line in registers.splitlines():
+        if line.startswith(prefix):
+            return line
+    return f"{prefix}missing"
+
+
+def counter(line: str, name: str) -> int:
+    match = re.search(rf"\b{re.escape(name)}:(\d+)\b", line)
+    return int(match.group(1)) if match else 0
+
+
+def should_stop(mode: str, watch: str, invalid: str, unsupported: str) -> bool:
+    incident = invalid != "INVALID_CONTROL=none" or not unsupported.startswith(
+        "UNSUPPORTED=none"
+    )
+    if mode == "incident":
+        return incident
+    if mode == "overwrite":
+        return incident or (
+            counter(watch, "ENTRIES") >= 2 and " FIRST:none " not in watch
+        )
+    if mode == "second-exit":
+        return counter(watch, "EXITS") >= 2
+    return False
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8778")
+    parser.add_argument("--interval", type=float, default=0.2)
+    parser.add_argument("--timeout", type=float, default=300.0)
+    parser.add_argument("--request-timeout", type=float, default=5.0)
+    parser.add_argument(
+        "--stop-at",
+        choices=("overwrite", "second-exit", "incident", "never"),
+        default="overwrite",
+    )
+    args = parser.parse_args()
+    if args.interval <= 0 or args.timeout <= 0 or args.request_timeout <= 0:
+        parser.error("interval and timeouts must be positive")
+
+    started = time.monotonic()
+    previous: tuple[str, str, str] | None = None
+    while time.monotonic() - started < args.timeout:
+        try:
+            registers = fetch_registers(args.url, args.request_timeout)
+        except (OSError, URLError, ValueError, json.JSONDecodeError):
+            time.sleep(args.interval)
+            continue
+        pc = field(registers, "PC=")
+        watch = field(registers, "HARDWARE_INIT_RETURN=")
+        invalid = field(registers, "INVALID_CONTROL=")
+        unsupported = field(registers, "UNSUPPORTED=")
+        current = (
+            watch,
+            invalid,
+            re.sub(r"\bCOUNT=\d+\b", "COUNT=#", unsupported),
+        )
+        if current != previous:
+            elapsed = time.monotonic() - started
+            print(f"{elapsed:8.3f}s {pc}", flush=True)
+            print(f"{elapsed:8.3f}s {watch}", flush=True)
+            if invalid != "INVALID_CONTROL=none":
+                print(f"{elapsed:8.3f}s {invalid}", flush=True)
+            if not unsupported.startswith("UNSUPPORTED=none"):
+                print(f"{elapsed:8.3f}s {unsupported}", flush=True)
+            previous = current
+        if should_stop(args.stop_at, watch, invalid, unsupported):
+            return 0
+        time.sleep(args.interval)
+    raise TimeoutError(f"no {args.stop_at} condition within {args.timeout:g}s")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/monitor_np560_lcd_segments.py b/monitor_np560_lcd_segments.py
new file mode 100644
index 0000000000000000000000000000000000000000..8c3feca097574851997f48a80c5961b29d945692
--- /dev/null
+++ b/monitor_np560_lcd_segments.py
@@ -0,0 +1,139 @@
+#!/usr/bin/env python3
+"""Monitor the NP560+ factory LCD annunciator buffer without mutating QEMU.
+
+The V3.80 firmware keeps two 240-bit annunciator planes at data address
+51:2734.  Resident routine 14:6E10 transfers those planes to ST7529 lines 19
+and 140, outside the 240x120 dot-matrix window.  On the real device those
+signals drive the custom-glass status icons above the main LCD surface.
+
+This monitor polls the existing read-only Web memory endpoint and prints only
+changes, which makes hardware-input and firmware-state correlations quick to
+spot without adding guest hooks or injecting keys.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import json
+import time
+from dataclasses import dataclass
+from urllib.parse import urlencode
+from urllib.request import urlopen
+
+
+STATUS_ADDRESS = 0x512734
+PLANE_BYTES = 30
+STATUS_BYTES = PLANE_BYTES * 2
+
+
+@dataclass(frozen=True)
+class StatusPlanes:
+    raw: bytes
+
+    @property
+    def bits(self) -> tuple[tuple[int, ...], tuple[int, ...]]:
+        planes: list[tuple[int, ...]] = []
+        for plane in range(2):
+            payload = self.raw[plane * PLANE_BYTES:(plane + 1) * PLANE_BYTES]
+            planes.append(tuple(
+                byte_index * 8 + bit
+                for byte_index, value in enumerate(payload)
+                for bit in range(8)
+                if value & (1 << bit)
+            ))
+        return planes[0], planes[1]
+
+    @property
+    def hex(self) -> str:
+        return self.raw.hex()
+
+
+def endpoint(base_url: str) -> str:
+    query = urlencode({
+        "source": "data",
+        "base": hex(STATUS_ADDRESS),
+        "size": STATUS_BYTES,
+    })
+    return f"{base_url.rstrip('/')}/api/state?{query}"
+
+
+def read_status(base_url: str, timeout: float) -> StatusPlanes:
+    with urlopen(endpoint(base_url), timeout=timeout) as response:
+        state = json.load(response)
+    if state.get("source") != "data" or state.get("format") != "packed":
+        raise ValueError("Web endpoint did not return a packed data-bus view")
+    payload = base64.b64decode(state["frame"], validate=True)
+    if len(payload) != STATUS_BYTES:
+        raise ValueError(
+            f"status buffer is {len(payload)} bytes, expected {STATUS_BYTES}"
+        )
+    return StatusPlanes(payload)
+
+
+def bit_delta(
+    previous: tuple[int, ...], current: tuple[int, ...],
+) -> tuple[tuple[int, ...], tuple[int, ...]]:
+    old = set(previous)
+    new = set(current)
+    return tuple(sorted(new - old)), tuple(sorted(old - new))
+
+
+def format_bits(bits: tuple[int, ...]) -> str:
+    return ",".join(str(bit) for bit in bits) if bits else "-"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8778")
+    parser.add_argument("--interval", type=float, default=0.25)
+    parser.add_argument(
+        "--samples", type=int, default=0,
+        help="number of samples; zero keeps monitoring until interrupted",
+    )
+    parser.add_argument("--timeout", type=float, default=5.0)
+    parser.add_argument(
+        "--show-unchanged", action="store_true",
+        help="print every sample instead of only changes",
+    )
+    args = parser.parse_args()
+    if args.interval <= 0 or args.samples < 0 or args.timeout <= 0:
+        parser.error("interval/timeout must be positive and samples nonnegative")
+
+    previous: StatusPlanes | None = None
+    sample = 0
+    try:
+        while args.samples == 0 or sample < args.samples:
+            current = read_status(args.url, args.timeout)
+            sample += 1
+            current_bits = current.bits
+            if previous is None:
+                print(
+                    f"#{sample} plane19={format_bits(current_bits[0])} "
+                    f"plane140={format_bits(current_bits[1])} "
+                    f"hex={current.hex}"
+                )
+            elif current.raw != previous.raw:
+                previous_bits = previous.bits
+                changes = []
+                for plane in range(2):
+                    enabled, disabled = bit_delta(
+                        previous_bits[plane], current_bits[plane],
+                    )
+                    changes.append(
+                        f"plane{(19, 140)[plane]} "
+                        f"+{format_bits(enabled)} -{format_bits(disabled)}"
+                    )
+                print(f"#{sample} {'; '.join(changes)} hex={current.hex}")
+            elif args.show_unchanged:
+                print(f"#{sample} unchanged hex={current.hex}")
+            previous = current
+            if args.samples == 0 or sample < args.samples:
+                time.sleep(args.interval)
+    except KeyboardInterrupt:
+        pass
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/monitor_np560_provision.py b/monitor_np560_provision.py
new file mode 100644
index 0000000000000000000000000000000000000000..dd65eaaaf1c6651616de63a1962f5b11c672d8b8
--- /dev/null
+++ b/monitor_np560_provision.py
@@ -0,0 +1,246 @@
+#!/usr/bin/env python3
+"""Monitor NP560 guest-native provisioning and its startup frame guard."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import re
+import time
+from urllib.error import URLError
+from urllib.request import urlopen
+
+
+PREFIXES = (
+    "PC=",
+    "PROVISION=",
+    "FILE_OPEN=",
+    "FILE_OPEN_NESTED=",
+    "FILE_WRAPPER_TRACE=",
+    "FILE_WRAPPER_FRAME=",
+    "USERINFO_PATH_TRACE=",
+    "FILE_OPEN_ERROR_TRACE=",
+    "FILE_PATH_RESOLVE=",
+    "FILE_PATH_TRACE=",
+    "FILE_COMPONENT_FRAME=",
+    "FILE_ROOT_POOL=",
+    "FILE_WRITE=",
+    "FILE_COMMIT=",
+    "CAPACITY_SCAN=",
+    "REGISTRY_INIT=",
+    "FILE_ENTRY_BUILD=",
+    "FILE_RECORD_RESOLVE=",
+    "FILE_RECORD_CANDIDATES=",
+    "ROOT_METADATA=",
+    "ROOT_OBJECT_INIT=",
+    "ROOT_OBJECT_FAIL=",
+    "APPLICATION_INIT_FRAME=",
+    "INVALID_CONTROL=",
+    "UNSUPPORTED=",
+)
+
+
+PROGRESS_FIELDS = (
+    "provision",
+    "file_open",
+    "file_open_nested",
+    "file_wrapper_trace",
+    "file_wrapper_frame",
+    "userinfo_path_trace",
+    "file_open_error_trace",
+    "file_path_resolve",
+    "file_path_trace",
+    "file_component_frame",
+    "file_root_pool",
+    "file_write",
+    "file_commit",
+    "capacity_scan",
+    "registry_init",
+    "file_entry_build",
+    "file_record_resolve",
+    "file_record_candidates",
+    "root_metadata",
+    "root_object_init",
+    "root_object_fail",
+    "application_init_frame",
+    "invalid_control",
+    "unsupported",
+)
+
+
+def fetch_registers(url: str, timeout: float) -> str:
+    with urlopen(f"{url.rstrip('/')}/api/state", timeout=timeout) as response:
+        state = json.load(response)
+    if not isinstance(state, dict) or "error" in state:
+        raise ValueError(f"invalid Web/QEMU state: {state!r}")
+    return str(state.get("registers", ""))
+
+
+def field(registers: str, prefix: str) -> str:
+    for line in registers.splitlines():
+        if line.startswith(prefix):
+            return line
+    return f"{prefix}missing"
+
+
+def decimal_field(line: str, name: str) -> int:
+    match = re.search(rf"\b{re.escape(name)}:(\d+)\b", line)
+    return int(match.group(1)) if match else 0
+
+
+def result_words(line: str) -> tuple[int, int] | None:
+    match = re.search(r"\bRESULT:([0-9a-fA-F]{4}):([0-9a-fA-F]{4})\b", line)
+    if not match:
+        return None
+    return int(match.group(1), 16), int(match.group(2), 16)
+
+
+def snapshot(registers: str) -> dict[str, str]:
+    return {prefix[:-1].lower(): field(registers, prefix) for prefix in PREFIXES}
+
+
+def outcome(current: dict[str, str], expected_write_calls: int) -> str:
+    invalid = current["invalid_control"]
+    unsupported = current["unsupported"]
+    provision = current["provision"]
+    file_write = current["file_write"]
+    file_commit = current["file_commit"]
+    frame = current["application_init_frame"]
+
+    if invalid != "INVALID_CONTROL=none":
+        return "invalid-control"
+    if not unsupported.startswith("UNSUPPORTED=none"):
+        return "unsupported-instruction"
+    # Stage 7 is entered only after all writes, close/commit, and the final
+    # read-only stat call.  The wrapper then invokes the original 2B:2F44
+    # initializer, which is precisely the routine that can wait indefinitely;
+    # requiring the wrapper's later RETS (stage 8) would hide a valid commit.
+    if decimal_field(provision, "STAGE") >= 7:
+        if decimal_field(file_write, "CALLS") < expected_write_calls:
+            return "incomplete-write-count"
+        if result_words(file_write) != (0, 0x100):
+            return "write-failed"
+        if (decimal_field(file_commit, "CALLS") < 1 or
+                decimal_field(file_commit, "RETURNS") < 1):
+            return "close-incomplete"
+        commit_result = result_words(file_commit)
+        if commit_result is None or commit_result[0] != 0:
+            return "commit-failed"
+        return "complete"
+    if decimal_field(frame, "WRITES") > 0:
+        return "frame-overwrite"
+    if decimal_field(provision, "STAGE") > 0:
+        return "provisioning"
+    return "startup"
+
+
+def should_stop(mode: str, result: str) -> bool:
+    incident = result in {
+        "invalid-control",
+        "unsupported-instruction",
+        "frame-overwrite",
+        "incomplete-write-count",
+        "write-failed",
+        "close-incomplete",
+        "commit-failed",
+    }
+    if mode == "terminal":
+        return incident or result == "complete"
+    if mode == "incident":
+        return incident
+    if mode == "provisioning":
+        return result == "provisioning" or incident or result == "complete"
+    if mode == "complete":
+        return result == "complete" or incident
+    return False
+
+
+def write_json(path: Path | None, elapsed: float, result: str,
+               current: dict[str, str]) -> None:
+    if path is None:
+        return
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(
+            {"elapsed_seconds": elapsed, "outcome": result, **current},
+            ensure_ascii=False,
+            indent=2,
+        ) + "\n",
+        encoding="utf-8",
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8778")
+    parser.add_argument("--interval", type=float, default=0.2)
+    parser.add_argument("--timeout", type=float, default=600.0)
+    parser.add_argument("--request-timeout", type=float, default=5.0)
+    parser.add_argument(
+        "--expected-write-calls",
+        type=int,
+        default=256,
+        help="guest writer call count required for a complete result",
+    )
+    parser.add_argument(
+        "--compact",
+        action="store_true",
+        help="print only provisioning, write, close, and terminal diagnostics",
+    )
+    parser.add_argument(
+        "--stop-at",
+        choices=("terminal", "incident", "provisioning", "complete", "never"),
+        default="terminal",
+    )
+    parser.add_argument("--json-output", type=Path)
+    args = parser.parse_args()
+    if (args.interval <= 0 or args.timeout <= 0 or args.request_timeout <= 0 or
+            args.expected_write_calls <= 0):
+        parser.error("interval, timeouts, and expected write calls must be positive")
+
+    started = time.monotonic()
+    previous: dict[str, str] | None = None
+    previous_signature: tuple[str, ...] | None = None
+    last: dict[str, str] | None = None
+    last_result = "unavailable"
+    while time.monotonic() - started < args.timeout:
+        try:
+            registers = fetch_registers(args.url, args.request_timeout)
+        except (OSError, URLError, ValueError, json.JSONDecodeError):
+            time.sleep(args.interval)
+            continue
+
+        current = snapshot(registers)
+        result = outcome(current, args.expected_write_calls)
+        last = current
+        last_result = result
+        signature = tuple(current[name] for name in PROGRESS_FIELDS)
+        if signature != previous_signature:
+            elapsed = time.monotonic() - started
+            print(f"{elapsed:8.3f}s OUTCOME={result}", flush=True)
+            print(f"{elapsed:8.3f}s {current['pc']}", flush=True)
+            display_fields = (
+                ("provision", "file_write", "file_commit",
+                 "invalid_control", "unsupported")
+                if args.compact else PROGRESS_FIELDS
+            )
+            for name in display_fields:
+                if previous is None or current[name] != previous[name]:
+                    print(f"{elapsed:8.3f}s {current[name]}", flush=True)
+            previous = current
+            previous_signature = signature
+        if should_stop(args.stop_at, result):
+            elapsed = time.monotonic() - started
+            write_json(args.json_output, elapsed, result, current)
+            return 0 if result == "complete" else 2
+        time.sleep(args.interval)
+
+    elapsed = time.monotonic() - started
+    if last is not None:
+        write_json(args.json_output, elapsed, last_result, last)
+    raise TimeoutError(f"no {args.stop_at} condition within {args.timeout:g}s")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/monitor_np560_resource_candidates.py b/monitor_np560_resource_candidates.py
new file mode 100644
index 0000000000000000000000000000000000000000..f9e20d56e64319a79a4dd747eb4d6f6a18c72dce
--- /dev/null
+++ b/monitor_np560_resource_candidates.py
@@ -0,0 +1,224 @@
+#!/usr/bin/env python3
+"""Stop at the first resource-range candidate selected after a valid CAFE record."""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+import json
+import re
+import time
+from typing import Any
+from urllib.error import URLError
+from urllib.request import urlopen
+
+
+TRACE_LINE = "RESOURCE_CANDIDATES"
+EXPECTED_BASE = 0x0E93
+EXPECTED_RANGE = 0x0158
+
+
+@dataclass(frozen=True)
+class ResourceCandidate:
+    pc: str
+    caller: str
+    source_logical: int
+    source_physical: int
+    old: int
+    base: int
+    range_: int
+    r8: int
+    r10: int
+    sp: int
+    fp: int
+    ds0: int
+    ds1: int
+    parent_fp: int
+    copy_args: tuple[int, ...]
+    outer_caller: str
+    outer_args: tuple[int, ...]
+    record: tuple[int, ...]
+
+    @property
+    def cafe_consistent(self) -> bool:
+        return (
+            len(self.record) >= 3 and
+            self.record[0] == 0xCAFE and
+            self.record[1] == self.base and
+            self.record[2] == self.range_
+        )
+
+    @property
+    def expected(self) -> bool:
+        return self.base == EXPECTED_BASE and self.range_ == EXPECTED_RANGE
+
+
+ENTRY_RE = re.compile(
+    r"(?P<pc>[0-9a-fA-F]{2}:[0-9a-fA-F]{4})<"
+    r"(?P<caller>[0-9a-fA-F]{2}:[0-9a-fA-F]{4})/"
+    r"src(?P<source_logical>[0-9a-fA-F]{4})"
+    r"\(p(?P<source_physical>[0-9a-fA-F]{6})\)/"
+    r"(?P<old>[0-9a-fA-F]{4})>"
+    r"(?P<base>[0-9a-fA-F]{4}),"
+    r"(?P<range>[0-9a-fA-F]{4})/"
+    r"r8(?P<r8>[0-9a-fA-F]{4})/"
+    r"r10(?P<r10>[0-9a-fA-F]{4})/"
+    r"sp(?P<sp>[0-9a-fA-F]{4})/"
+    r"fp(?P<fp>[0-9a-fA-F]{4})/"
+    r"ds(?P<ds0>[0-9a-fA-F]{3}),(?P<ds1>[0-9a-fA-F]{3})/"
+    r"pfp(?P<parent_fp>[0-9a-fA-F]{4})/"
+    r"args(?P<copy_args>[0-9a-fA-F]{4}(?:,[0-9a-fA-F]{4}){5})/"
+    r"outer(?P<outer_caller>[0-9a-fA-F]{2}:[0-9a-fA-F]{4})/"
+    r"oargs(?P<outer_args>[0-9a-fA-F]{4}(?:,[0-9a-fA-F]{4}){5})/"
+    r"rec(?P<record>-|[0-9a-fA-F]{4}(?:,[0-9a-fA-F]{4})*)"
+)
+
+
+def fetch_state(url: str, timeout: float) -> dict[str, Any]:
+    with urlopen(f"{url.rstrip('/')}/api/state", timeout=timeout) as response:
+        state = json.load(response)
+    if not isinstance(state, dict) or "error" in state:
+        raise ValueError(f"invalid Web/QEMU state: {state!r}")
+    return state
+
+
+def state_line(registers: str, name: str) -> str:
+    prefix = f"{name}="
+    for line in registers.splitlines():
+        if line.startswith(prefix):
+            return line[len(prefix):].strip()
+    return "none"
+
+
+def parse_candidates(registers: str) -> tuple[int, list[ResourceCandidate]]:
+    line = state_line(registers, TRACE_LINE)
+    header = re.fullmatch(r"COUNT:(\d+) TRACE=(.*)", line)
+    if not header:
+        return 0, []
+    count = int(header.group(1))
+    entries: list[ResourceCandidate] = []
+    if not header.group(2):
+        return count, entries
+    for encoded in header.group(2).split(";"):
+        match = ENTRY_RE.fullmatch(encoded)
+        if not match:
+            raise ValueError(f"invalid resource candidate trace entry: {encoded!r}")
+        values = match.groupdict()
+        record = () if values["record"] == "-" else tuple(
+            int(word, 16) for word in values["record"].split(",")
+        )
+        entries.append(ResourceCandidate(
+            pc=values["pc"].lower(),
+            caller=values["caller"].lower(),
+            source_logical=int(values["source_logical"], 16),
+            source_physical=int(values["source_physical"], 16),
+            old=int(values["old"], 16),
+            base=int(values["base"], 16),
+            range_=int(values["range"], 16),
+            r8=int(values["r8"], 16),
+            r10=int(values["r10"], 16),
+            sp=int(values["sp"], 16),
+            fp=int(values["fp"], 16),
+            ds0=int(values["ds0"], 16),
+            ds1=int(values["ds1"], 16),
+            parent_fp=int(values["parent_fp"], 16),
+            copy_args=tuple(
+                int(word, 16) for word in values["copy_args"].split(",")
+            ),
+            outer_caller=values["outer_caller"].lower(),
+            outer_args=tuple(
+                int(word, 16) for word in values["outer_args"].split(",")
+            ),
+            record=record,
+        ))
+    return count, entries
+
+
+def new_candidates(previous_count: int, count: int,
+                   ring: list[ResourceCandidate]
+                   ) -> tuple[int, list[ResourceCandidate]]:
+    if count <= previous_count:
+        return 0, []
+    delta = count - previous_count
+    if delta >= len(ring):
+        return max(0, delta - len(ring)), ring
+    return 0, ring[-delta:]
+
+
+def first_divergent_after_expected(
+    candidates: list[ResourceCandidate], armed: bool = False,
+) -> tuple[bool, ResourceCandidate | None]:
+    for candidate in candidates:
+        if candidate.expected and candidate.cafe_consistent:
+            armed = True
+        elif armed and candidate.base != 0 and not candidate.expected:
+            return armed, candidate
+    return armed, None
+
+
+def format_candidate(candidate: ResourceCandidate) -> str:
+    signature = candidate.record[0] if candidate.record else None
+    signature_text = "----" if signature is None else f"{signature:04x}"
+    return (
+        f"{candidate.base:04x}/{candidate.range_:04x} "
+        f"record={signature_text} source={candidate.source_physical:06x} "
+        f"copy={candidate.pc} caller={candidate.caller} "
+        f"outer={candidate.outer_caller} r8={candidate.r8:04x} "
+        f"sp={candidate.sp:04x} fp={candidate.fp:04x}"
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8778")
+    parser.add_argument("--interval", type=float, default=0.02)
+    parser.add_argument("--timeout", type=float, default=2.0)
+    parser.add_argument("--startup-timeout", type=float, default=90.0)
+    parser.add_argument("--duration", type=float, default=120.0)
+    args = parser.parse_args()
+
+    started = time.monotonic()
+    connected = False
+    previous_count = 0
+    armed = False
+    while args.duration <= 0 or time.monotonic() - started < args.duration:
+        try:
+            state = fetch_state(args.url, args.timeout)
+        except (OSError, URLError, ValueError):
+            if connected or time.monotonic() - started >= args.startup_timeout:
+                raise
+            time.sleep(max(args.interval, 0.01))
+            continue
+
+        now = time.monotonic() - started
+        if not connected:
+            connected = True
+            print(f"{now:8.3f}s READY {args.url}", flush=True)
+        count, ring = parse_candidates(str(state.get("registers", "")))
+        lost, candidates = new_candidates(previous_count, count, ring)
+        if lost:
+            print(f"{now:8.3f}s CANDIDATES lost={lost}", flush=True)
+        sequence = count - len(candidates) + 1
+        for offset, candidate in enumerate(candidates):
+            print(
+                f"{now:8.3f}s CANDIDATE #{sequence + offset} "
+                f"{format_candidate(candidate)} "
+                f"consistent={int(candidate.cafe_consistent)}",
+                flush=True,
+            )
+        previous_count = count
+        armed, incident = first_divergent_after_expected(candidates, armed)
+        if incident:
+            record = ",".join(f"{word:04x}" for word in incident.record)
+            print(
+                f"{now:8.3f}s INCIDENT selected candidate after valid CAFE: "
+                f"{format_candidate(incident)} record_words={record or '-'}",
+                flush=True,
+            )
+            return 2
+        time.sleep(max(args.interval, 0.01))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
