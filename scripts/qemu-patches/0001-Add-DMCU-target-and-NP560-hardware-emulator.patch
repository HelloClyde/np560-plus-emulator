+:root {
+  color-scheme: dark;
+  --ink: #eef3ee;
+  --muted: #96a39a;
+  --line: #354039;
+  --panel: #171c19;
+  --panel-2: #202722;
+  --case: #d8d9d1;
+  --case-shadow: #777b73;
+  --key: #2b332e;
+  --accent: #9bd16f;
+  --lcd-off: #b7c8a1;
+  --lcd-on: #243126;
+}
+
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  min-width: 320px;
+  background: radial-gradient(circle at 50% -20%, #303b34 0, #121613 50rem);
+  color: var(--ink);
+  font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
+}
+button, input, select { font: inherit; }
+button {
+  border: 1px solid var(--line);
+  border-radius: .55rem;
+  background: var(--key);
+  color: var(--ink);
+  padding: .55rem .8rem;
+  cursor: pointer;
+}
+button:hover { border-color: var(--accent); }
+button:active, button.is-pressed { transform: translateY(1px); background: #40513f; }
+button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+.app-shell { width: min(1120px, 100%); margin: 0 auto; padding: 1.25rem; }
+.topbar { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 1.25rem; }
+.topbar h1 { margin: .1rem 0 0; font-weight: 500; font-size: 1.55rem; }
+.eyebrow { margin: 0; color: var(--accent); letter-spacing: .14em; font-size: .75rem; }
+.run-state { margin-left: auto; display: flex; align-items: center; gap: .5rem; color: var(--muted); }
+#status-dot { width: .65rem; height: .65rem; border-radius: 50%; background: #c48f55; box-shadow: 0 0 .7rem currentColor; }
+#status-dot.online { background: var(--accent); }
+.run-controls { display: flex; gap: .45rem; }
+
+.device {
+  display: grid;
+  grid-template-columns: minmax(320px, 1.22fr) minmax(320px, .78fr);
+  gap: 1.2rem;
+  padding: clamp(1rem, 3vw, 2rem);
+  border-radius: 1.5rem;
+  background: linear-gradient(145deg, #eeeee8, var(--case));
+  color: #242824;
+  box-shadow: 0 1.25rem 3rem #0008, inset 0 -4px 0 var(--case-shadow);
+}
+.screen-bezel { align-self: start; border-radius: .9rem; background: #313833; padding: 1rem; box-shadow: inset 0 0 0 2px #181b19; }
+.screen-header, .screen-footer { display: flex; align-items: center; gap: .6rem; color: #cfd6cf; font: .75rem/1.2 ui-monospace, monospace; }
+.screen-header { justify-content: space-between; margin-bottom: .7rem; }
+.screen-footer { margin-top: .7rem; }
+.screen-footer input { width: 8rem; accent-color: var(--accent); }
+#fps { margin-left: auto; }
+#lcd {
+  display: block;
+  width: 480px;
+  max-width: 100%;
+  height: auto;
+  margin-inline: auto;
+  image-rendering: pixelated;
+  background: var(--lcd-off);
+  border: 0;
+  outline: 2px solid #0f130f;
+  box-shadow: inset 0 0 1.2rem #17201677, 0 0 1rem #b6dda644;
+}
+.input-deck { display: flex; flex-direction: column; gap: .9rem; }
+.softkeys { display: grid; grid-template-columns: repeat(4, 1fr); gap: .45rem; }
+.navigation { display: grid; grid-template: repeat(3, 2.6rem) / repeat(3, 1fr); gap: .35rem; width: min(16rem, 100%); margin: 0 auto; }
+.navigation .up { grid-area: 1 / 2; }.navigation .left { grid-area: 2 / 1; }
+.navigation .enter { grid-area: 2 / 2; padding: .25rem; }.navigation .right { grid-area: 2 / 3; }.navigation .down { grid-area: 3 / 2; }
+.keyboard { display: grid; grid-template-columns: repeat(10, 1fr); gap: .28rem; }
+.keyboard button { min-width: 0; padding: .42rem .1rem; font-size: .76rem; }
+.keyboard .wide { grid-column: span 2; }
+
+.debug-panel { margin-top: 1.25rem; border-top: 1px solid var(--line); }
+.debug-panel summary { padding: 1rem 0; color: var(--muted); cursor: pointer; }
+.debug-grid { display: grid; grid-template-columns: minmax(260px, .7fr) minmax(340px, 1.3fr); gap: 1rem; }
+.settings { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; align-content: start; }
+.settings label { display: grid; gap: .35rem; color: var(--muted); font-size: .8rem; }
+.settings input, .settings select { width: 100%; border: 1px solid var(--line); border-radius: .45rem; padding: .5rem; background: var(--panel); color: var(--ink); }
+.settings .check { grid-template-columns: auto 1fr; align-items: center; }
+.settings .check input { width: auto; accent-color: var(--accent); }
+.scan-buttons { grid-column: 1 / -1; display: flex; gap: .45rem; }
+.scan-buttons button { flex: 1; }
+.settings p { grid-column: 1 / -1; margin: 0; color: var(--muted); font-size: .78rem; }
+.settings .rom-identity { color: var(--accent); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; overflow-wrap: anywhere; }
+#registers { margin: 0; min-height: 12rem; overflow: auto; border-radius: .65rem; padding: 1rem; background: var(--panel); color: #b9ddb2; font: .78rem/1.55 ui-monospace, SFMono-Regular, Consolas, monospace; }
+#lcd-state { margin: 0 0 .7rem; overflow: auto; border-radius: .65rem; padding: .75rem 1rem; background: var(--panel); color: var(--accent); font: .78rem/1.45 ui-monospace, SFMono-Regular, Consolas, monospace; }
+
+@media (max-width: 780px) {
+  .topbar { flex-wrap: wrap; }
+  .run-state { margin-left: 0; }
+  .run-controls { margin-left: auto; }
+  .device, .debug-grid { grid-template-columns: 1fr; }
+}
+@media (max-width: 480px) {
+  .app-shell { padding: .75rem; }
+  .run-controls { width: 100%; }.run-controls button { flex: 1; }
+  .device { padding: .75rem; border-radius: 1rem; }
+  .settings { grid-template-columns: 1fr; }
+  .settings .scan-buttons, .settings p { grid-column: 1; }
+  .keyboard { grid-template-columns: repeat(8, 1fr); }
+}
