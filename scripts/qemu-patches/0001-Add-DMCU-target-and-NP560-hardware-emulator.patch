+def read_physical(emulator: Emulator, address: int, size: int) -> bytes:
+    emulator.qmp.execute(
+        "pmemsave",
+        {"val": address, "size": size,
+         "filename": str(emulator.frame_path)},
+    )
+    return emulator.frame_path.read_bytes()
+
+
+def read_guest_bytes(emulator: Emulator, address: int, size: int) -> bytes:
+    """Read translated DMCU byte addresses through their external lane map."""
+    if not size:
+        return b""
+    first = address & ~1
+    last = ((address + size - 1) | 1) + 1
+    physical = read_physical(emulator, first, last - first)
+    return bytes(physical[((address + offset) ^ 1) - first]
+                 for offset in range(size))
+
+
+def contiguous_expected_ranges(values: dict[int, int]):
+    """Yield (address, bytes) runs from a sparse final-memory map."""
+    items = sorted(values.items())
+    if not items:
+        return
+    start = previous = items[0][0]
+    data = bytearray([items[0][1]])
+    for address, value in items[1:]:
+        if address == previous + 1:
+            data.append(value)
+        else:
+            yield start, bytes(data)
+            start = address
+            data = bytearray([value])
+        previous = address
+    yield start, bytes(data)
+
+
+def wait_for_missing(emulator: Emulator, address: str, label: str) -> str:
+    deadline = time.monotonic() + 20
+    pattern = re.compile(rf"\bROM_MISSING={re.escape(address)}\b", re.I)
+    while True:
+        state = emulator.qmp.execute(
+            "qom-get", {"path": "/machine", "property": "cpu-state"}
+        )
+        if pattern.search(state):
+            return state
+        if emulator.process.poll() is not None:
+            raise AssertionError(
+                f"QEMU exited with {emulator.process.returncode}:\n{state}"
+            )
+        if time.monotonic() >= deadline:
+            raise AssertionError(f"{label} did not reach {address}:\n{state}")
+        time.sleep(0.01)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--qemu", type=Path, required=True)
+    parser.add_argument("--firmware", type=Path, required=True)
+    parser.add_argument("--initializer-rom", type=Path, required=True)
+    parser.add_argument("--overlay-install-rom", type=Path, required=True)
+    parser.add_argument("--runtime-rom", type=Path, required=True)
+    args = parser.parse_args()
+
+    firmware = args.firmware.read_bytes()
+    contract_image = boot.WordImage(
+        "NP560.PRG", firmware, 0x200000, "little"
+    )
+    groups = boot.group_contiguous_descriptors(
+        boot.find_program_copy_descriptors(contract_image)
+    )
+    if [len(group) for group in groups] != [9, 261]:
+        raise AssertionError("unexpected initializer descriptor layout")
+
+    # Apply descriptors in execution order so later writes correctly win if
+    # two initialized objects overlap.
+    final_bytes: dict[int, int] = {}
+    for descriptor in groups[1]:
+        length = descriptor["length"]
+        for index in range(length):
+            source = (descriptor["source"] + index) ^ 1
+            for alias_base, alias_source, alias_size in (
+                    INITIALIZER_DATA_SOURCE_ALIASES):
+                if alias_base <= source < alias_base + alias_size:
+                    source = alias_source + source - alias_base
+                    break
+            source_offset = source - 0x200000
+            if source_offset < 0 or source_offset >= len(firmware):
+                raise AssertionError("initializer source outside NP560.PRG")
+            destination = (descriptor["destination"] + index) ^ 1
+            final_bytes[destination] = firmware[source_offset]
+
+    initializer = Emulator(
+        qemu=args.qemu,
+        firmware=args.firmware,
+        soc_rom=args.initializer_rom,
+        soc_rom_skeleton=True,
+    )
+    try:
+        initializer_state = wait_for_missing(
+            initializer, "07:7fe4", "dual-initializer probe"
+        )
+
+        for address, expected in FIRST_INITIALIZER_EXPECTED.items():
+            actual = read_guest_bytes(initializer, address, len(expected))
+            if actual != expected:
+                raise AssertionError(
+                    f"first initializer at {address:06X}: "
+                    f"{actual.hex()} != {expected.hex()}"
+                )
+
+        checked_initializer_bytes = 0
+        for address, expected in contiguous_expected_ranges(final_bytes):
+            actual = read_physical(initializer, address, len(expected))
+            if actual != expected:
+                raise AssertionError(
+                    f"second initializer at {address:06X}: "
+                    f"{actual.hex()} != {expected.hex()}"
+                )
+            checked_initializer_bytes += len(expected)
+    finally:
+        initializer.close()
+
+    overlay_emulator = Emulator(
+        qemu=args.qemu,
+        firmware=args.firmware,
+        soc_rom=args.overlay_install_rom,
+        soc_rom_skeleton=True,
+    )
+    try:
+        install_loader = rom.post_initializer_overlay_words(
+            probe_stop_after_overlay_install=True
+        )
+        install_trap = (rom.POST_INITIALIZER_LOADER_ADDRESS +
+                        (len(install_loader) - 1) * 2)
+        install_trap_text = (
+            f"{install_trap >> 16:02x}:{install_trap & 0xffff:04x}"
+        )
+        overlay_state = wait_for_missing(
+            overlay_emulator, install_trap_text,
+            "runtime-overlay installation trap",
+        )
+        relocated_calls = {
+            rom.APPLICATION_MAIN_RESOURCE_CREATE_CALL:
+                rom.APPLICATION_MAIN_RESOURCE_CREATE_OVERLAY_DESTINATION,
+            rom.APPLICATION_TOP_LEVEL_MAIN_CALL:
+                rom.APPLICATION_MAIN_CURSOR_REFRESH_WRAPPER_ADDRESS,
+            rom.APPLICATION_FOREGROUND_STATUS_CALL:
+                rom.APPLICATION_FOREGROUND_STATUS_OVERLAY_DESTINATION,
+            rom.SYSTEM_INIT_OVERLAY_DESTINATION + 2:
+                rom.SYSTEM_BITS_RESIDENT_ADDRESS,
+            (rom.APPLICATION_RESOURCE_LOOP_OVERLAY_DESTINATION +
+             rom.APPLICATION_RESOURCE_LOOP_SYSTEM_BITS_CALL_OFFSET):
+                rom.SYSTEM_BITS_RESIDENT_ADDRESS,
+            rom.APPLICATION_STATE_UI_ADC_CALL:
+                rom.APPLICATION_STATE_ADC_OVERLAY_DESTINATION,
+            rom.APPLICATION_MAIN_ACTION_RENDER_INPUT_CALL:
+                rom.APPLICATION_MAIN_ROM_INPUT_LOCAL_DESTINATION,
+            rom.APPLICATION_STORAGE_CAPACITY_SECTOR_PROBE_CALL:
+                rom.APPLICATION_STORAGE_SECTOR_PROBE_OVERLAY_DESTINATION,
+            rom.APPLICATION_LAUNCH_RECORD_APPLY_SECTOR_PROBE_CALL:
+                rom.APPLICATION_STORAGE_SECTOR_PROBE_OVERLAY_DESTINATION,
+            rom.APPLICATION_SYSTEM_REGISTRY_RESULT_CALL:
+                rom.APPLICATION_SYSTEM_REGISTRY_RESULT_OVERLAY_DESTINATION,
+            rom.APPLICATION_SYSTEM_REGISTRY_ENTRY_RECORD_ACCEPT_CALL:
+                rom.STORAGE_RECORD_ACCEPT_OVERLAY_DESTINATION,
+            rom.APPLICATION_SYSTEM_REGISTRY_RESULT_FALLBACK_CALL:
+                rom.APPLICATION_SYSTEM_REGISTRY_FALLBACK_OVERLAY_DESTINATION,
+            rom.APPLICATION_RESULT_OBJECT_FINALIZE_RECORD_ACCEPT_CALL:
+                rom.STORAGE_RECORD_ACCEPT_OVERLAY_DESTINATION,
+            rom.APPLICATION_RESULT_OBJECT_CLOSE_RECORD_ACCEPT_CALL:
+                rom.STORAGE_RECORD_ACCEPT_OVERLAY_DESTINATION,
+        }
+        relocated_calls.update({
+            call: relocated_target
+            for call, _, _, relocated_target in
+            rom.APPLICATION_TIMER_IDLE_REGISTER_LEAF_CALLS
+        })
+        relocated_calls.update({
+            call: rom.APPLICATION_SYSTEM_REGISTRY_ENTRY_OVERLAY_DESTINATION
+            for call in rom.APPLICATION_SYSTEM_REGISTRY_ENTRY_CALLS
+        })
+        for destination, source, length in OVERLAYS:
+            source_offset = source - 0x200000
+            expected = bytearray(
+                firmware[source_offset:source_offset + length]
+            )
+            for call, target in relocated_calls.items():
+                if destination <= call and call + 4 <= destination + length:
+                    offset = call - destination
+                    expected[offset:offset + 4] = (
+                        (0xBD00 | (target >> 16)).to_bytes(2, "little") +
+                        (target & 0xFFFF).to_bytes(2, "little")
+                    )
+            actual = read_physical(overlay_emulator, destination, length)
+            if actual != expected:
+                mismatch = next(
+                    index for index, (actual_byte, expected_byte) in
+                    enumerate(zip(actual, expected))
+                    if actual_byte != expected_byte
+                )
+                raise AssertionError(
+                    f"overlay {destination:06X} from {source:06X} differs "
+                    f"at +{mismatch:04X}: "
+                    f"{actual[mismatch:mismatch + 16].hex()} != "
+                    f"{expected[mismatch:mismatch + 16].hex()}"
+                )
+        geometry = b"".join(
+            value.to_bytes(2, "little")
+            for value in rom.STORAGE_GEOMETRY_DEFAULT_WORDS
+        )
+        actual_geometry = read_physical(
+            overlay_emulator,
+            rom.STORAGE_GEOMETRY_DATA_OVERLAY_DESTINATION,
+            len(geometry),
+        )
+        if actual_geometry != geometry:
+            raise AssertionError(
+                f"runtime NAND geometry: {actual_geometry.hex()} != "
+                f"{geometry.hex()}"
+            )
+    finally:
+        overlay_emulator.close()
+
+    emulator = Emulator(
+        qemu=args.qemu,
+        firmware=args.firmware,
+        soc_rom=args.runtime_rom,
+        soc_rom_skeleton=True,
+    )
+    try:
+        # After installing every overlay, the unmodified 20:026A path now
+        # advances to the reconstructed late-loader boundary at 01:0200.  It
+        # no longer returns to the old synthetic reserved-word trap.
+        state = wait_for_missing(
+            emulator, "01:0200", "runtime-overlay completion boundary"
+        )
+
+        # Figure 19 of CN1916884A defines EMBLK in bits 15..8 and WS in 1..0.
+        # 20:026A sets DS0=1, so logical 7108/710A/710C map to physical
+        # F108/F10A/F10C before it writes these exact values.
+        expected_emcr = bytes.fromhex("0250016002f0")
+        actual_emcr = read_physical(emulator, 0xF108, len(expected_emcr))
+        if actual_emcr != expected_emcr:
+            raise AssertionError(
+                f"EMCR1..3: {actual_emcr.hex()} != {expected_emcr.hex()}"
+            )
+
+        alias_destination, alias_source, alias_size = (
+            LAUNCH_RESOURCE_DATA_ALIAS
+        )
+        expected_alias = firmware[
+            alias_source - 0x200000:
+            alias_source - 0x200000 + alias_size
+        ]
+        actual_alias = read_physical(
+            emulator, alias_destination, alias_size
+        )
+        if actual_alias != expected_alias:
+            raise AssertionError(
+                "launch resource data alias: "
+                f"{actual_alias.hex()} != {expected_alias.hex()}"
+            )
+
+        alias_destination, alias_source, alias_size = (
+            MENU_POSITION_DATA_ALIAS
+        )
+        expected_alias = firmware[
+            alias_source - 0x200000:
+            alias_source - 0x200000 + alias_size
+        ]
+        actual_alias = read_physical(
+            emulator, alias_destination, alias_size
+        )
+        if actual_alias != expected_alias:
+            raise AssertionError(
+                "menu position data alias: "
+                f"{actual_alias.hex()} != {expected_alias.hex()}"
+            )
+
+        alias_destination, alias_source, alias_size = (
+            MODAL_STATE_TABLE_DATA_ALIAS
+        )
+        expected_alias = firmware[
+            alias_source - 0x200000:
+            alias_source - 0x200000 + alias_size
+        ]
+        actual_alias = read_physical(
+            emulator, alias_destination, alias_size
+        )
+        if actual_alias != expected_alias:
+            raise AssertionError(
+                "modal state table data alias: "
+                f"{actual_alias.hex()} != {expected_alias.hex()}"
+            )
+
+        alias_destination, alias_source, alias_size = PIM_RESOURCE_DATA_ALIAS
+        expected_alias = firmware[
+            alias_source - 0x200000:
+            alias_source - 0x200000 + alias_size
+        ]
+        actual_alias = read_physical(
+            emulator, alias_destination, alias_size
+        )
+        if actual_alias != expected_alias:
+            raise AssertionError(
+                "PIM resource data alias: "
+                f"{actual_alias.hex()} != {expected_alias.hex()}"
+            )
+
+        alias_destination, alias_source, alias_size = (
+            USERINFO_PATH_DATA_ALIAS
+        )
+        expected_alias = firmware[
+            alias_source - 0x200000:
+            alias_source - 0x200000 + alias_size
+        ]
+        actual_alias = read_physical(
+            emulator, alias_destination, alias_size
+        )
+        if actual_alias != expected_alias:
+            raise AssertionError(
+                "USERINFO path data alias: "
+                f"{actual_alias.hex()} != {expected_alias.hex()}"
+            )
+        guest_path = read_guest_bytes(
+            emulator, alias_destination, alias_size
+        )
+        if guest_path != b"0:\\USERINFO.SYS\0":
+            raise AssertionError(
+                f"USERINFO guest path: {guest_path!r}"
+            )
+
+        alias_destination, alias_source, alias_size = (
+            USERINFO_LITERAL_DATA_ALIAS
+        )
+        expected_alias = firmware[
+            alias_source - 0x200000:
+            alias_source - 0x200000 + alias_size
+        ]
+        actual_alias = read_physical(
+            emulator, alias_destination, alias_size
+        )
+        if actual_alias != expected_alias:
+            raise AssertionError(
+                "late USERINFO literal data alias: "
+                f"{actual_alias.hex()} != {expected_alias.hex()}"
+            )
+        guest_literals = read_guest_bytes(
+            emulator, alias_destination, alias_size
+        )
+        if guest_literals != b"0:\\USERINFO.SYS\0":
+            raise AssertionError(
+                "late USERINFO guest literals lack path: "
+                f"{guest_literals.hex()}"
+            )
+
+        print("NP560+ dual initializer/runtime overlay probe passed")
+        print(
+            f"DESCRIPTORS=9+261 FINAL_INIT_BYTES={checked_initializer_bytes} "
+            f"OVERLAYS={len(OVERLAYS)}"
+        )
+        initializer_stop = next(
+            line for line in initializer_state.splitlines()
+            if line.startswith("ROM_MISSING=")
+        )
+        print("INITIALIZER_STOP=" + initializer_stop)
+        overlay_stop = next(
+            line for line in overlay_state.splitlines()
+            if line.startswith("ROM_MISSING=")
+        )
+        print("OVERLAY_INSTALL_STOP=" + overlay_stop)
+        print(state)
+    finally:
+        emulator.close()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
