+static void lcd_set_pixel(uint8_t *frame, unsigned x, unsigned y,
+                          bool value)
+{
+    uint8_t *pixel = &frame[y * DMCU_LCD_STRIDE + (x >> 3)];
+    uint8_t mask = 0x80 >> (x & 7);
+
+    *pixel = value ? *pixel | mask : *pixel & ~mask;
+}
