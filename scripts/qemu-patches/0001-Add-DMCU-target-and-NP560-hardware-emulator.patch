index 0000000000000000000000000000000000000000..c80edaf977f6efbb5a9d7a70465dda5cc722753a
--- /dev/null
+++ b/monitor_np560_web.py
@@ -0,0 +1,652 @@
+#!/usr/bin/env python3
+"""Watch an NP560 Web/QEMU run and capture the first useful outcome.
+
+The monitor attaches to an existing ``np560_web.py`` instance.  It records
+compact heartbeats instead of QEMU's verbose instruction log, pauses the VM on
+the first hardware-model incident or native-menu milestone, and saves the CPU
+state plus the exact ST7529 frame for later analysis.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+from dataclasses import asdict, dataclass, replace
+from datetime import datetime
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+import time
+from typing import Any
+from urllib.error import URLError
+from urllib.request import Request, urlopen
+
+
+NATIVE_MENU_STAGES = (
+    "BOOT33", "STACK33", "INIT261", "INIT9", "SYSMAIN",
+    "TOP", "RESINIT", "SELECTOR", "SELRET", "MANAGER",
+    "REGLOOK", "REGRET", "MANRET", "MENU", "MENUPAGE",
+    "MENUBUILDRET", "PAGEBUILD", "MENUOK",
+)
+
+
+@dataclass(frozen=True)
+class Observation:
+    status: str
+    running: bool
+    pc: str
+    pc_value: int | None
+    stage: str
+    irq_entries: int
+    irq_fp_overwrites: int
+    irq_fp_overwrite_detail: str
+    irq_fp_restore_expected: int | None
+    irq_fp_restore_value: int | None
+    unsupported: str
+    rom_missing: str
+    invalid_control: str
+    frame_sha256: str
+    frame_nonuniform_pixels: int
+    lcd_nonzero_flushes: int
+    incidents: tuple[str, ...]
+    menu_reached: bool
+    sysmain_calls: int
+    sysmain_sp: int | None
+    sysmain_from: str
+    scheduler_returns: int
+    main_returns: int
+    cafe_record_reads: int
+    cafe_record_detail: str
+    resource_window_value: int | None
+    resource_window_writes: int
+    resource_window_zero_io_calls: int
+    resource_window_detail: str
+    application_state: int | None
+    application_pending: int | None
+    application_stage: int | None
+    resource_path_flag: int | None
+    resource_path_detail: str
+    foreground_cycles: int
+    operation_setup_returns: int
+    result_handle_calls: int
+    result_handle_ptr_calls: int
+    modal_polls: int
+    menu_calls: int
+    menu_ok_calls: int
+    root_object_failures: int
+
+
+@dataclass
+class StackDescentWatch:
+    """Detect a repeated foreground-stack leak before it corrupts a frame."""
+
+    required_cycles: int = 2
+    min_bytes_per_cycle: int = 16
+    last_calls: int = 0
+    last_sp: int | None = None
+    descending_cycles: int = 0
+    descending_bytes: int = 0
+
+    def update(self, observation: Observation) -> str | None:
+        calls = observation.sysmain_calls
+        sp = observation.sysmain_sp
+        if not calls or sp is None:
+            return None
+        if calls == self.last_calls:
+            return None
+        if self.last_sp is None or calls < self.last_calls:
+            self.last_calls = calls
+            self.last_sp = sp
+            self.descending_cycles = 0
+            self.descending_bytes = 0
+            return None
+
+        cycle_delta = calls - self.last_calls
+        byte_delta = self.last_sp - sp
+        if byte_delta >= self.min_bytes_per_cycle * cycle_delta:
+            self.descending_cycles += cycle_delta
+            self.descending_bytes += byte_delta
+        else:
+            self.descending_cycles = 0
+            self.descending_bytes = 0
+
+        self.last_calls = calls
+        self.last_sp = sp
+        if self.descending_cycles < self.required_cycles:
+            return None
+        average = self.descending_bytes // self.descending_cycles
+        return (
+            "SYSMAIN stack descends across "
+            f"{self.descending_cycles} lifecycle(s): "
+            f"SP={sp:04x}, drop={self.descending_bytes:#x}, "
+            f"about {average:#x}/cycle, caller={observation.sysmain_from}"
+        )
+
+
+@dataclass
+class BlankAfterVisibleWatch:
+    """Detect a display which becomes uniformly blank after showing content."""
+
+    required_seconds: float = 15.0
+    min_visible_pixels: int = 16
+    seen_visible: bool = False
+    blank_since: float | None = None
+
+    def update(self, observation: Observation, now: float) -> str | None:
+        nonuniform = observation.frame_nonuniform_pixels
+        if nonuniform >= self.min_visible_pixels:
+            self.seen_visible = True
+            self.blank_since = None
+            return None
+        # QEMU retains the number of non-empty native LCD flushes.  Use that
+        # history to arm a monitor which attaches after the display has
+        # already gone blank; otherwise a late diagnostic attachment could
+        # never observe the preceding visible frame.
+        if observation.lcd_nonzero_flushes:
+            self.seen_visible = True
+        if not self.seen_visible:
+            return None
+        if self.blank_since is None:
+            self.blank_since = now
+            return None
+        duration = now - self.blank_since
+        if duration < self.required_seconds:
+            return None
+        return (
+            "LCD became uniform after visible output: "
+            f"nonuniform={nonuniform}, blank-for={duration:.2f}s"
+        )
+
+
+def endpoint(base_url: str, path: str) -> str:
+    return f"{base_url.rstrip('/')}{path}"
+
+
+def fetch_state(base_url: str, timeout: float) -> dict[str, Any]:
+    with urlopen(endpoint(base_url, "/api/state"), timeout=timeout) as response:
+        state = json.load(response)
+    if not isinstance(state, dict):
+        raise ValueError("Web state is not a JSON object")
+    if "error" in state:
+        raise ValueError(str(state["error"]))
+    return state
+
+
+def control(base_url: str, action: str, timeout: float) -> None:
+    body = json.dumps({"action": action}).encode("utf-8")
+    request = Request(
+        endpoint(base_url, "/api/control"), data=body,
+        headers={"Content-Type": "application/json"}, method="POST",
+    )
+    with urlopen(request, timeout=timeout) as response:
+        result = json.load(response)
+    if not isinstance(result, dict) or not result.get("ok"):
+        raise ValueError(f"control {action!r} failed: {result!r}")
+
+
+def state_line(registers: str, name: str) -> str:
+    prefix = f"{name}="
+    for line in registers.splitlines():
+        if line.startswith(prefix):
+            return line[len(prefix):].strip()
+    return "none"
+
+
+def application_calls(registers: str, stage: str) -> int:
+    match = re.search(
+        rf"(?:APPLICATION_TRACE=|,){re.escape(stage)}:(\d+)@", registers,
+    )
+    return int(match.group(1)) if match else 0
+
+
+def application_entry(registers: str, stage: str) -> tuple[int, str, int | None]:
+    match = re.search(
+        rf"(?:APPLICATION_TRACE=|,){re.escape(stage)}:(\d+)@"
+        rf"([0-9a-fA-F]{{2}}:[0-9a-fA-F]{{4}})/sp([0-9a-fA-F]{{4}})",
+        registers,
+    )
+    if not match:
+        return 0, "none", None
+    return int(match.group(1)), match.group(2).lower(), int(match.group(3), 16)
+
+
+def integer_field(text: str, name: str) -> int | None:
+    match = re.search(rf"(?:^|\s){re.escape(name)}:(\d+)", text)
+    return int(match.group(1)) if match else None
+
+
+def hex_field(text: str, name: str) -> int | None:
+    match = re.search(rf"(?:^|\s){re.escape(name)}:([0-9a-fA-F]+)", text)
+    return int(match.group(1), 16) if match else None
+
+
+def observe(state: dict[str, Any]) -> Observation:
+    registers = str(state.get("registers", ""))
+    frame = base64.b64decode(str(state.get("frame", "")), validate=True)
+    value_counts = [0] * 256
+    for value in frame:
+        value_counts[value] += 1
+    frame_nonuniform_pixels = (
+        len(frame) - max(value_counts) if frame else 0
+    )
+    pc_match = re.search(r"(?:^|\n)PC=([0-9a-fA-F]{2}):([0-9a-fA-F]{4})", registers)
+    if pc_match:
+        pc = f"{pc_match.group(1).lower()}:{pc_match.group(2).lower()}"
+        pc_value = (int(pc_match.group(1), 16) << 16) | int(pc_match.group(2), 16)
+    else:
+        pc = "unknown"
+        pc_value = None
+
+    irq = state_line(registers, "IRQ64")
+    irq_entries = integer_field(irq, "ENTRIES") or 0
+    fp = state_line(registers, "IRQ_SAVE_FP")
+    overwrite = state_line(registers, "IRQ_SAVE_FP_OVERWRITE")
+    overwrite_count = integer_field(overwrite, "COUNT") or 0
+    overwrite_bus = integer_field(overwrite, "BUS")
+    restore_expected = hex_field(fp, "EXPECT")
+    restore_value = hex_field(fp, "SLOT")
+    restores = integer_field(fp, "RESTORES") or 0
+    unsupported = state_line(registers, "UNSUPPORTED")
+    rom_missing = state_line(registers, "ROM_MISSING")
+    invalid_control = state_line(registers, "INVALID_CONTROL")
+    native_lcd_flush = state_line(registers, "NATIVE_LCD_FLUSH")
+    lcd_nonzero_flushes = integer_field(native_lcd_flush, "NONZERO_CALLS") or 0
+    cafe_record = state_line(registers, "NAND_CAFE_RECORD")
+    cafe_record_reads = integer_field(cafe_record, "READS") or 0
+    resource_window = state_line(registers, "RESOURCE_WINDOW")
+    resource_window_value = hex_field(resource_window, "VALUE")
+    resource_window_writes = integer_field(resource_window, "WRITES") or 0
+    resource_window_zero_io_calls = (
+        integer_field(resource_window, "ZERO_IO") or 0
+    )
+    application_state_line = state_line(registers, "APPLICATION_STATE")
+    application_state = hex_field(application_state_line, "STATE")
+    application_pending = hex_field(application_state_line, "PENDING")
+    application_stage = hex_field(application_state_line, "STAGE")
+    resource_path_flag = hex_field(application_state_line, "RESOURCE_FLAG")
+    root_object_failures = (
+        integer_field(state_line(registers, "ROOT_OBJECT_FAIL"), "COUNT") or 0
+    )
+    sysmain_calls, sysmain_from, sysmain_sp = application_entry(
+        registers, "SYSMAIN"
+    )
+
+    stage = "RESET"
+    for candidate in NATIVE_MENU_STAGES:
+        if application_calls(registers, candidate):
+            stage = candidate
+
+    incidents: list[str] = []
+    if overwrite_count:
+        bus_name = {
+            1: "translated data bus",
+            2: "internal SRAM path",
+        }.get(overwrite_bus, f"unknown bus {overwrite_bus}")
+        incidents.append(
+            f"0x04D6 IRQ FP save slot overwritten via {bus_name}: {overwrite}"
+        )
+    if (restores and restore_expected is not None and restore_value is not None
+            and restore_expected != restore_value):
+        incidents.append(
+            f"IRQ FP restore mismatch {restore_expected:04x}!={restore_value:04x}"
+        )
+    if unsupported != "none" and not unsupported.startswith("none "):
+        incidents.append(f"unsupported stop: {unsupported}")
+    if rom_missing != "none" and not rom_missing.startswith("none "):
+        incidents.append(f"missing ROM: {rom_missing}")
+    if invalid_control != "none" and not invalid_control.startswith("none "):
+        incidents.append(f"invalid control transfer: {invalid_control}")
+    if pc_value is not None and (pc_value & 1):
+        incidents.append(f"odd instruction address {pc}")
+    exec_trace = state_line(registers, "EXEC_TRACE")
+    zero_data_instructions = sum(
+        1 for segment, _offset, word in re.findall(
+            r"(?:^|,)(5[1-3]):([0-9a-fA-F]{4})/([0-9a-fA-F]{4})",
+            exec_trace,
+        )
+        if int(word, 16) == 0
+    )
+    if (pc_value is not None and 0x510000 <= pc_value < 0x540000 and
+            zero_data_instructions >= 12):
+        incidents.append(
+            "execution entered writable data RAM with at least "
+            f"{zero_data_instructions} zero instructions: PC={pc}"
+        )
+    if resource_window_zero_io_calls:
+        incidents.append(
+            "resource I/O used A2:28E0 while it was zero: "
+            f"{resource_window}"
+        )
+
+    return Observation(
+        status=str(state.get("status", "unknown")),
+        running=bool(state.get("running")),
+        pc=pc,
+        pc_value=pc_value,
+        stage=stage,
+        irq_entries=irq_entries,
+        irq_fp_overwrites=overwrite_count,
+        irq_fp_overwrite_detail=overwrite,
+        irq_fp_restore_expected=restore_expected,
+        irq_fp_restore_value=restore_value,
+        unsupported=unsupported,
+        rom_missing=rom_missing,
+        invalid_control=invalid_control,
+        frame_sha256=hashlib.sha256(frame).hexdigest(),
+        frame_nonuniform_pixels=frame_nonuniform_pixels,
+        lcd_nonzero_flushes=lcd_nonzero_flushes,
+        incidents=tuple(incidents),
+        menu_reached=application_calls(registers, "MENUOK") > 0,
+        sysmain_calls=sysmain_calls,
+        sysmain_sp=sysmain_sp,
+        sysmain_from=sysmain_from,
+        scheduler_returns=application_calls(registers, "SCHEDRET"),
+        main_returns=application_calls(registers, "MAINRET"),
+        cafe_record_reads=cafe_record_reads,
+        cafe_record_detail=cafe_record,
+        resource_window_value=resource_window_value,
+        resource_window_writes=resource_window_writes,
+        resource_window_zero_io_calls=resource_window_zero_io_calls,
+        resource_window_detail=resource_window,
+        application_state=application_state,
+        application_pending=application_pending,
+        application_stage=application_stage,
+        resource_path_flag=resource_path_flag,
+        resource_path_detail=(
+            "not attempted" if resource_path_flag == 0 else
+            "resource path unavailable" if resource_path_flag == 1 else
+            "unknown" if resource_path_flag is None else
+            f"firmware value 0x{resource_path_flag:04x}"
+        ),
+        foreground_cycles=application_calls(registers, "FGPARENT"),
+        operation_setup_returns=application_calls(registers, "OP0BRET"),
+        result_handle_calls=application_calls(registers, "HANDLE"),
+        result_handle_ptr_calls=application_calls(registers, "HANDLEPTR"),
+        modal_polls=application_calls(registers, "MODALPOLL"),
+        menu_calls=application_calls(registers, "MENU"),
+        menu_ok_calls=application_calls(registers, "MENUOK"),
+        root_object_failures=root_object_failures,
+    )
+
+
+def render_lcd(frame: bytes, width: int, height: int, output: Path) -> None:
+    try:
+        from PIL import Image
+    except ImportError as exc:
+        raise RuntimeError("Pillow is required to render the LCD PNG") from exc
+
+    if len(frame) != width * height:
+        raise ValueError(
+            f"unexpected LCD frame size {len(frame)} != {width * height}"
+        )
+    lcd_off = (0xB7, 0xC8, 0xA1)
+    lcd_on = (0x24, 0x31, 0x26)
+    pixels = []
+    for raw in frame:
+        level = (raw & 31) / 31
+        pixels.append(tuple(
+            round(off + (on - off) * level)
+            for off, on in zip(lcd_off, lcd_on)
+        ))
+    image = Image.new("RGB", (width, height))
+    image.putdata(pixels)
+    image = image.resize((width * 4, height * 4), Image.Resampling.NEAREST)
+    image.save(output)
+
+
+def capture(output_dir: Path, state: dict[str, Any], observation: Observation,
+            reason: str) -> None:
+    output_dir.mkdir(parents=True, exist_ok=True)
+    registers = str(state.get("registers", ""))
+    frame = base64.b64decode(str(state.get("frame", "")), validate=True)
+    metadata = dict(state)
+    metadata.pop("frame", None)
+    metadata["capture_reason"] = reason
+    metadata["observation"] = asdict(observation)
+    (output_dir / "state.json").write_text(
+        json.dumps(metadata, ensure_ascii=False, indent=2), encoding="utf-8",
+    )
+    (output_dir / "registers.txt").write_text(registers, encoding="utf-8")
+    (output_dir / "lcd.gray5").write_bytes(frame)
+    render_lcd(
+        frame, int(state.get("width", 240)), int(state.get("height", 120)),
+        output_dir / "lcd.png",
+    )
+
+
+def should_stop(mode: str, observation: Observation) -> str | None:
+    # Milestone-specific modes still need to preserve the *first* hard-fault
+    # state.  Waiting for a foreground return or menu after an unsupported
+    # opcode, odd PC, corrupt IRQ frame, or invalid control transfer only lets
+    # timer traffic obscure the original cause.  ``never`` is the one explicit
+    # opt-out for users who want passive observation.
+    if mode != "never" and observation.incidents:
+        return "incident"
+    if mode in ("menu", "either") and observation.menu_reached:
+        return "menu"
+    if mode == "cafe" and observation.cafe_record_reads:
+        return "cafe"
+    if mode == "return" and observation.main_returns:
+        return "foreground-return"
+    if mode == "resource-failure" and observation.resource_path_flag == 1:
+        return "resource-failure"
+    return None
+
+
+def change_signature(observation: Observation) -> tuple[Any, ...]:
+    """Return only state transitions worth printing immediately.
+
+    Lifecycle, allocation, IRQ, and framebuffer counters can advance several
+    times between Web samples.  Including them in the signature turned the
+    compact monitor into a multi-megabyte per-instruction transcript and hid
+    the first useful transition.  They are still printed on each heartbeat
+    and retained in captures; only immediate console/event-log emission is
+    de-duplicated here.
+    """
+    return (
+        observation.status,
+        observation.stage,
+        observation.irq_fp_overwrites,
+        observation.unsupported,
+        observation.rom_missing,
+        observation.invalid_control,
+        observation.resource_window_value,
+        observation.resource_window_zero_io_calls,
+        observation.application_state,
+        observation.application_pending,
+        observation.application_stage,
+        observation.resource_path_flag,
+        observation.menu_reached,
+        observation.root_object_failures,
+        observation.incidents,
+    )
+
+
+def timestamp() -> str:
+    return datetime.now().astimezone().isoformat(timespec="seconds")
+
+
+def main() -> int:
+    if hasattr(sys.stdout, "reconfigure"):
+        sys.stdout.reconfigure(line_buffering=True)
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8775")
+    parser.add_argument("--poll-interval", type=float, default=0.25)
+    parser.add_argument("--heartbeat", type=float, default=5.0)
+    parser.add_argument("--timeout", type=float, default=1200.0)
+    parser.add_argument("--request-timeout", type=float, default=5.0)
+    parser.add_argument(
+        "--stop-on",
+        choices=(
+            "incident", "menu", "cafe", "return", "resource-failure",
+            "either", "never",
+        ),
+        default="either",
+    )
+    parser.add_argument("--no-pause", action="store_true")
+    parser.add_argument("--resume", action="store_true")
+    parser.add_argument("--once", action="store_true")
+    parser.add_argument("--expect-soc-rom-sha256")
+    parser.add_argument("--output-dir", type=Path)
+    parser.add_argument(
+        "--stack-descent-cycles", type=int, default=2,
+        help="stop after this many leaking SYSMAIN lifecycles (default: 2)",
+    )
+    parser.add_argument(
+        "--stack-descent-min-bytes", type=int, default=16,
+        help="minimum SP drop per lifecycle treated as a leak (default: 16)",
+    )
+    parser.add_argument("--no-stack-descent-check", action="store_true")
+    parser.add_argument(
+        "--blank-after-visible-seconds", type=float, default=15.0,
+        help=(
+            "stop when an LCD which showed content stays uniform for this "
+            "many seconds (default: 15)"
+        ),
+    )
+    parser.add_argument(
+        "--blank-min-visible-pixels", type=int, default=16,
+        help="nonuniform pixels required to arm the blank watch (default: 16)",
+    )
+    parser.add_argument("--no-blank-after-visible-check", action="store_true")
+    args = parser.parse_args()
+    if min(args.poll_interval, args.heartbeat, args.timeout,
+           args.request_timeout) <= 0:
+        parser.error("intervals and timeouts must be positive")
+    if min(args.stack_descent_cycles, args.stack_descent_min_bytes) <= 0:
+        parser.error("stack descent thresholds must be positive")
+    if args.blank_after_visible_seconds <= 0:
+        parser.error("blank-after-visible seconds must be positive")
+    if args.blank_min_visible_pixels <= 0:
+        parser.error("blank-min-visible-pixels must be positive")
+
+    output_dir = args.output_dir or Path("tmp") / (
+        "np560-monitor-" + datetime.now().strftime("%Y%m%d-%H%M%S")
+    )
+    output_dir.mkdir(parents=True, exist_ok=True)
+    event_log = output_dir / "events.jsonl"
+
+    if args.resume:
+        control(args.url, "resume", args.request_timeout)
+
+    deadline = time.monotonic() + args.timeout
+    next_heartbeat = 0.0
+    last_signature: tuple[Any, ...] | None = None
+    last_state: dict[str, Any] | None = None
+    last_observation: Observation | None = None
+    samples = 0
+    stack_watch = StackDescentWatch(
+        required_cycles=args.stack_descent_cycles,
+        min_bytes_per_cycle=args.stack_descent_min_bytes,
+    )
+    blank_watch = BlankAfterVisibleWatch(
+        required_seconds=args.blank_after_visible_seconds,
+        min_visible_pixels=args.blank_min_visible_pixels,
+    )
+
+    while time.monotonic() < deadline:
+        try:
+            state = fetch_state(args.url, args.request_timeout)
+            observation = observe(state)
+            if not args.no_stack_descent_check:
+                stack_incident = stack_watch.update(observation)
+                if stack_incident:
+                    observation = replace(
+                        observation,
+                        incidents=observation.incidents + (stack_incident,),
+                    )
+            if not args.no_blank_after_visible_check:
+                blank_incident = blank_watch.update(
+                    observation, time.monotonic(),
+                )
+                if blank_incident:
+                    observation = replace(
+                        observation,
+                        incidents=observation.incidents + (blank_incident,),
+                    )
+        except (OSError, URLError, ValueError, json.JSONDecodeError) as exc:
+            print(f"[{timestamp()}] Web state unavailable: {exc}", file=sys.stderr)
+            time.sleep(args.poll_interval)
+            continue
+
+        samples += 1
+        last_state = state
+        last_observation = observation
+        expected_sha = args.expect_soc_rom_sha256
+        if expected_sha and str(state.get("soc_rom_sha256", "")).lower() != expected_sha.lower():
+            raise SystemExit(
+                "attached Web instance uses a different SoC ROM: "
+                f"{state.get('soc_rom_sha256')} != {expected_sha}"
+            )
+
+        signature = change_signature(observation)
+        now = time.monotonic()
+        changed = signature != last_signature
+        if changed or now >= next_heartbeat:
+            event = {
+                "time": timestamp(), "sample": samples,
+                "changed": changed, **asdict(observation),
+            }
+            with event_log.open("a", encoding="utf-8") as stream:
+                stream.write(json.dumps(event, ensure_ascii=False) + "\n")
+            sysmain_sp = (
+                f"{observation.sysmain_sp:04x}"
+                if observation.sysmain_sp is not None else "----"
+            )
+            print(
+                f"[{event['time']}] sample={samples} status={observation.status} "
+                f"pc={observation.pc} stage={observation.stage} "
+                f"irq={observation.irq_entries} fp-overwrite="
+                f"{observation.irq_fp_overwrites} frame="
+                f"{observation.frame_sha256[:12]}/pixels"
+                f"{observation.frame_nonuniform_pixels} sysmain="
+                f"{observation.sysmain_calls}/sp{sysmain_sp} cafe="
+                f"{observation.cafe_record_reads} resource-window="
+                f"{(f'{observation.resource_window_value:04x}' if observation.resource_window_value is not None else '----')}"
+                f"/w{observation.resource_window_writes}/zero-io"
+                f"{observation.resource_window_zero_io_calls} app-state="
+                f"{(f'{observation.application_state:04x}' if observation.application_state is not None else '----')}"
+                f"/pending{(f'{observation.application_pending:04x}' if observation.application_pending is not None else '----')}"
+                f"/stage{(f'{observation.application_stage:04x}' if observation.application_stage is not None else '----')}"
+                f" resource-path={observation.resource_path_detail}"
+                f" lifecycle=fg{observation.foreground_cycles}"
+                f"/op{observation.operation_setup_returns}"
+                f"/handle{observation.result_handle_calls}"
+                f"/ptr{observation.result_handle_ptr_calls}"
+                f"/modal{observation.modal_polls}"
+                f" menu={observation.menu_calls}/{observation.menu_ok_calls}"
+                f" root-fail={observation.root_object_failures}"
+            )
+            next_heartbeat = now + args.heartbeat
+            last_signature = signature
+
+        reason = should_stop(args.stop_on, observation)
+        if args.once and reason is None:
+            reason = "one-shot"
+        if reason is not None:
+            if observation.incidents:
+                for incident in observation.incidents:
+                    print(f"INCIDENT: {incident}")
+            if not args.no_pause and observation.running:
+                incidents = observation.incidents
+                control(args.url, "pause", args.request_timeout)
+                state = fetch_state(args.url, args.request_timeout)
+                observation = observe(state)
+                observation = replace(observation, incidents=incidents)
+            capture(output_dir, state, observation, reason)
+            print(f"CAPTURE={output_dir.resolve()}")
+            print(f"STOP_REASON={reason}")
+            return 2 if reason == "incident" else 0
+
+        time.sleep(args.poll_interval)
+
+    if last_state is not None and last_observation is not None:
+        capture(output_dir, last_state, last_observation, "timeout")
+    print(f"TIMEOUT={args.timeout:g}s CAPTURE={output_dir.resolve()}")
+    return 3
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/np560_checkpoint_rehash.c b/np560_checkpoint_rehash.c
new file mode 100644
index 0000000000000000000000000000000000000000..6f4f26a9b14db849d9596175c5773eb1ee484b23
--- /dev/null
+++ b/np560_checkpoint_rehash.c
@@ -0,0 +1,95 @@
+/* Recompute the two FNV-1a payload hashes in an NP560 NAND checkpoint. */
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define HEADER_SIZE 64u
+
+static uint32_t load_le32(const unsigned char *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+           (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint64_t load_le64(const unsigned char *p)
+{
+    return (uint64_t)load_le32(p) | (uint64_t)load_le32(p + 4) << 32;
+}
+
+static void store_le32(unsigned char *p, uint32_t value)
+{
+    p[0] = value;
+    p[1] = value >> 8;
+    p[2] = value >> 16;
+    p[3] = value >> 24;
+}
+
+static uint32_t hash_region(FILE *file, uint64_t length)
+{
+    unsigned char buffer[1u << 20];
+    uint32_t hash = 2166136261u;
+
+    while (length) {
+        size_t wanted = length < sizeof(buffer) ? (size_t)length : sizeof(buffer);
+        size_t got = fread(buffer, 1, wanted, file);
+        size_t i;
+
+        if (got != wanted) {
+            fprintf(stderr, "checkpoint read failed: %s\n",
+                    ferror(file) ? strerror(errno) : "unexpected EOF");
+            exit(EXIT_FAILURE);
+        }
+        for (i = 0; i < got; i++) {
+            hash = (hash ^ buffer[i]) * 16777619u;
+        }
+        length -= got;
+    }
+    return hash;
+}
+
+int main(int argc, char **argv)
+{
+    static const unsigned char magic[8] = {
+        'N', 'P', '5', '6', '0', 'N', '1', 0
+    };
+    unsigned char header[HEADER_SIZE];
+    uint64_t data_size;
+    uint64_t oob_size;
+    uint32_t data_hash;
+    uint32_t oob_hash;
+    FILE *file;
+
+    if (argc != 2) {
+        fprintf(stderr, "usage: %s CHECKPOINT\n", argv[0]);
+        return EXIT_FAILURE;
+    }
+    file = fopen(argv[1], "r+b");
+    if (!file) {
+        fprintf(stderr, "cannot open %s: %s\n", argv[1], strerror(errno));
+        return EXIT_FAILURE;
+    }
+    if (fread(header, 1, sizeof(header), file) != sizeof(header) ||
+        memcmp(header, magic, sizeof(magic)) ||
+        load_le32(header + 12) != HEADER_SIZE) {
+        fprintf(stderr, "%s is not a supported NP560 checkpoint\n", argv[1]);
+        fclose(file);
+        return EXIT_FAILURE;
+    }
+    data_size = load_le64(header + 32);
+    oob_size = load_le64(header + 40);
+    data_hash = hash_region(file, data_size);
+    oob_hash = hash_region(file, oob_size);
+    store_le32(header + 48, data_hash);
+    store_le32(header + 52, oob_hash);
+    if (fseek(file, 0, SEEK_SET) ||
+        fwrite(header, 1, sizeof(header), file) != sizeof(header) ||
+        fclose(file)) {
+        fprintf(stderr, "checkpoint header update failed: %s\n", strerror(errno));
+        return EXIT_FAILURE;
+    }
+    printf("DATA_HASH=%08x OOB_HASH=%08x\n", data_hash, oob_hash);
+    return EXIT_SUCCESS;
+}
diff --git a/preflight-np560.ps1 b/preflight-np560.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..7a1d79b96d79cfda7c739a5682002c2f2c30abb2
--- /dev/null
+++ b/preflight-np560.ps1
@@ -0,0 +1,70 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)]
+    [string]$Firmware,
+    [string]$OutputDirectory,
+    [string]$RuntimeUrl,
+    [ValidateRange(1, 1000)]
+    [int]$ProbeCount = 1,
+    [switch]$SkipTests
+)
+
+$ErrorActionPreference = 'Stop'
+$repoRoot = Split-Path $PSScriptRoot -Parent
+$firmwarePath = (Resolve-Path -LiteralPath $Firmware).Path
+if (-not $OutputDirectory) {
+    $stem = [System.IO.Path]::GetFileNameWithoutExtension($firmwarePath)
+    $OutputDirectory = Join-Path $repoRoot "tmp\$stem-ui-preprocessed"
+}
+
+function Invoke-PythonChecked {
+    param([Parameter(ValueFromRemainingArguments = $true)][string[]]$Arguments)
+    & python @Arguments
+    if ($LASTEXITCODE -ne 0) {
+        throw "Python command failed with exit code $LASTEXITCODE`: python $Arguments"
+    }
+}
+
+Push-Location $repoRoot
+try {
+    Write-Host '[1/4] Generating exact UI/startup/menu slices...'
+    Invoke-PythonChecked `
+        'disassembly\preprocess_np560_ui.py' `
+        $firmwarePath `
+        '--output-dir' $OutputDirectory
+
+    Write-Host '[2/4] Auditing Harvard code/data mappings and overlay collisions...'
+    Invoke-PythonChecked `
+        'disassembly\np560_overlay_map.py' `
+        '--qemu-source' 'qemu-dmcu\hw\dmcu\np560.c' `
+        '--output' 'tmp\np560-overlay-map.json'
+
+    if ($SkipTests) {
+        Write-Host '[3/4] Unit tests skipped.'
+    } else {
+        Write-Host '[3/4] Running preprocessing, mapping, and monitor tests...'
+        Invoke-PythonChecked `
+            '-m' 'unittest' `
+            'disassembly\test_np560_overlay_map.py' `
+            'disassembly\test_preprocess_np560_ui.py' `
+            'disassembly\test_audit_np560_overlay_mappings.py' `
+            'qemu-dmcu\test_probe_np560_runtime.py' `
+            'qemu-dmcu\test_watch_np560_code_sources.py' `
+            'qemu-dmcu\test_analyze_np560_runtime_code_sources.py'
+    }
+
+    if ($RuntimeUrl) {
+        Write-Host '[4/4] Sampling live hardware-model diagnostics...'
+        Invoke-PythonChecked `
+            'qemu-dmcu\probe_np560_runtime.py' `
+            '--url' $RuntimeUrl `
+            '--count' ([string]$ProbeCount) `
+            '--changes-only'
+    } else {
+        Write-Host '[4/4] Live probe skipped (no -RuntimeUrl supplied).'
+    }
+
+    Write-Host "Preflight passed. UI index: $OutputDirectory"
+} finally {
+    Pop-Location
+}
diff --git a/probe-np560-burn.ps1 b/probe-np560-burn.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..a396189620ba85cd2181e60539e2243b82316a7f
--- /dev/null
+++ b/probe-np560-burn.ps1
@@ -0,0 +1,86 @@
+[CmdletBinding()]
+param(
+    [ValidateRange(0, 0xFFFF)]
+    [int]$Command = 1,
+    [int]$DurationMs = 500,
+    [switch]$Trace,
+    [switch]$CpuTrace
+)
+
+$ErrorActionPreference = 'Stop'
+$root = Split-Path $PSScriptRoot -Parent
+$package = Join-Path $root 'NP560+V3.80版系统升级程序'
+$burnCode = Join-Path $package 'BURN_NAND_FLASH_CODE.bin'
+$qemu = '/mnt/e/qemu-dmcu-build/qemu-system-dmcu'
+$traceWindows = 'E:\qemu-dmcu-build\np560-burn-command.log'
+$temporaryRoot = [IO.Path]::GetFullPath([IO.Path]::GetTempPath())
+$firmware = Join-Path $temporaryRoot (
+    'np560-burn-command-' + [guid]::NewGuid().ToString('N') + '.bin')
+
+function Set-Word([byte[]]$Image, [int]$Offset, [uint16]$Value) {
+    $Image[$Offset] = $Value -band 0xFF
+    $Image[$Offset + 1] = ($Value -shr 8) -band 0xFF
+}
+
+function Add-StoreWord(
+    [byte[]]$Image,
+    [ref]$Offset,
+    [uint16]$Address,
+    [uint16]$Value
+) {
+    Set-Word $Image $Offset.Value 0x68F0 # MOV R0, #value
+    Set-Word $Image ($Offset.Value + 2) $Value
+    Set-Word $Image ($Offset.Value + 4) 0xA8F0 # MOV [address], R0
+    Set-Word $Image ($Offset.Value + 6) $Address
+    $Offset.Value += 8
+}
+
+function Convert-ToWslPath([string]$Path) {
+    $windowsPath = (Resolve-Path -LiteralPath $Path).Path.Replace(
+        [char]92, [char]47)
+    $translated = (& wsl.exe -d Ubuntu2 -- wslpath -a -- $windowsPath).Trim()
+    if ($LASTEXITCODE -ne 0 -or -not $translated) {
+        throw "Unable to translate path into WSL: $Path"
+    }
+    return $translated
+}
+
+$image = [byte[]]::new(0x400000)
+$offset = 0
+Set-Word $image $offset 0x6810 # MOV DS0, #0x00A0 (physical 0x500000)
+Set-Word $image ($offset + 2) 0x00A0
+$offset += 4
+Add-StoreWord $image ([ref]$offset) 0x0008 ([uint16]$Command)
+
+# Values written by UpdateAll.exe for command 1.  The USB protocol reverses
+# byte order, so these are the words observed by DMCU after transmission.
+Add-StoreWord $image ([ref]$offset) 0x0034 0x0100
+Add-StoreWord $image ([ref]$offset) 0x0036 0x6A4F
+Add-StoreWord $image ([ref]$offset) 0x0094 0x0200
+Set-Word $image $offset 0xAD50 # SJMP 50:6000
+Set-Word $image ($offset + 2) 0x6000
+[IO.File]::WriteAllBytes($firmware, $image)
+
+try {
+    $wslFirmware = Convert-ToWslPath $firmware
+    $wslBurnCode = Convert-ToWslPath $burnCode
+    $seconds = [Math]::Max($DurationMs, 1) / 1000.0
+    $debug = if ($CpuTrace) { 'in_asm,cpu,unimp' } elseif ($Trace) {
+        'in_asm,unimp'
+    } else {
+        'unimp'
+    }
+    & wsl.exe -d Ubuntu2 -- timeout "${seconds}s" $qemu `
+        -M "np560,burn-code=$wslBurnCode" -bios $wslFirmware `
+        -nographic -monitor none -no-reboot -d $debug `
+        -D /mnt/e/qemu-dmcu-build/np560-burn-command.log
+} finally {
+    $resolved = [IO.Path]::GetFullPath($firmware)
+    if ($resolved.StartsWith($temporaryRoot,
+            [StringComparison]::OrdinalIgnoreCase) -and
+        (Test-Path -LiteralPath $resolved -PathType Leaf)) {
+        Remove-Item -LiteralPath $resolved -Force
+    }
+}
+
+Get-Content -LiteralPath $traceWindows
diff --git a/probe_np560_runtime.py b/probe_np560_runtime.py
new file mode 100644
index 0000000000000000000000000000000000000000..c56faaaf0e2b3da8bcaf79857bf2a0c884dbd1ac
--- /dev/null
+++ b/probe_np560_runtime.py
@@ -0,0 +1,470 @@
+#!/usr/bin/env python3
+"""Take low-overhead NP560 Web/QEMU runtime snapshots.
+
+Unlike the interactive frontend, this probe performs one state request per
+interval.  It keeps the fields needed for current ROM reconstruction visible
+without continuously asking QEMU for the large diagnostic register block.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+from datetime import datetime
+import hashlib
+import json
+import re
+import sys
+import time
+from typing import Any
+from urllib.error import HTTPError, URLError
+from urllib.request import urlopen
+
+
+IMPORTANT_LINES = (
+    "APPLICATION_STATE",
+    "APPLICATION_STATE_WRITE",
+    "APPLICATION_TRACE",
+    "APPLICATION_INIT",
+    "PROVISION",
+    "FILE_OPEN",
+    "FILE_WRITE",
+    "FILE_COMMIT",
+    "STORAGE_DRIVER",
+    "FILE_ROOT_POOL",
+    "FILE_ROOT_RELEASE",
+    "FILE_SIZE_RECORD",
+    "FILE_RECORD_RESOLVE",
+    "RESOURCE_OPEN",
+    "RESOURCE_RECOVERY_WORD",
+    "INDIRECT_CALLBACK",
+    "MENU_OVERLAY_COPY",
+    "NATIVE_LCD_FLUSH",
+    "NATIVE_FB",
+    "NATIVE_REFRESH",
+    "TEXT_TRACE",
+    "USERINFO_FLOW",
+    "IRQ_SAVE_FP_OVERWRITE",
+    "IRQ64",
+    "TIMER64",
+    "EVENT_STATE",
+    "INVALID_CONTROL",
+    "UNSUPPORTED",
+    "NAND",
+)
+
+FOREGROUND_STAGES = (
+    "FGLOOP", "FGRAWRET", "FGMAPRET", "FGDECODE", "FGCHANGE", "FGEXIT",
+    "LAUNCH", "MANAGER", "MENU",
+)
+
+
+def fetch_state(url: str, timeout: float) -> dict[str, Any]:
+    root = url.rstrip("/")
+    try:
+        with urlopen(f"{root}/api/diagnostics", timeout=timeout) as response:
+            state = json.load(response)
+    except HTTPError as exc:
+        if exc.code != 404:
+            raise
+        # An existing Web process may predate the lightweight endpoint.
+        with urlopen(f"{root}/api/state", timeout=timeout) as response:
+            state = json.load(response)
+    if not isinstance(state, dict) or "error" in state:
+        raise ValueError(f"invalid Web state: {state!r}")
+    return state
+
+
+def state_lines(registers: str) -> dict[str, str]:
+    result: dict[str, str] = {}
+    pc = re.search(r"(?:^|\n)(PC=[^\n]+)", registers)
+    if pc:
+        result["PC"] = pc.group(1)[3:].strip()
+    for name in IMPORTANT_LINES:
+        match = re.search(
+            rf"(?:^|\n){re.escape(name)}=([^\n]*)", registers,
+        )
+        result[name] = match.group(1).strip() if match else "missing"
+    return result
+
+
+def integer(text: str, field: str) -> int | None:
+    match = re.search(rf"(?:^|\s){re.escape(field)}[:=](\d+)", text)
+    return int(match.group(1)) if match else None
+
+
+def application_calls(text: str, stage: str) -> int | None:
+    match = re.search(
+        rf"(?:^|,){re.escape(stage)}:(\d+)@", text,
+    )
+    return int(match.group(1)) if match else None
+
+
+def application_stage_r0(text: str, stage: str) -> int | None:
+    """Return R0 captured at the most recent named foreground stage."""
+    match = re.search(
+        rf"(?:^|,){re.escape(stage)}:\d+@[^/]+/sp[^/]+/r([0-9a-fA-F]{{4}})",
+        text,
+    )
+    return int(match.group(1), 16) if match else None
+
+
+def state_write_transition(
+    text: str,
+) -> tuple[str | None, int | None, int | None]:
+    """Extract the last application-state write site and old/new values."""
+    match = re.search(
+        r"(?:^|\s)PC:([0-9a-fA-F]{2}:[0-9a-fA-F]{4})"
+        r"(?:\s+[^\s]+)*\s+VALUE:([0-9a-fA-F]{4})>"
+        r"([0-9a-fA-F]{4})/",
+        text,
+    )
+    if not match:
+        return None, None, None
+    return match.group(1).lower(), int(match.group(2), 16), int(match.group(3), 16)
+
+
+def hex_integer(text: str, field: str) -> int | None:
+    match = re.search(
+        rf"(?:^|\s){re.escape(field)}[:=]([0-9a-fA-F]+)", text,
+    )
+    return int(match.group(1), 16) if match else None
+
+
+def text_y_values(text_trace: str) -> tuple[int, ...]:
+    return tuple(sorted({
+        int(value) for value in re.findall(
+            r"(?:^|,)[0-9a-fA-F]{2}:[0-9a-fA-F]{4}@[0-9]+,([0-9]+)",
+            text_trace,
+        )
+    }))
+
+
+def userinfo_state_copy(text: str) -> tuple[int | None, int | None, str]:
+    """Extract the relocated state-copy call balance and code prefix."""
+    match = re.search(
+        r"(?:^|\s)STATE:(\d+)/(\d+)/[^\s]*/CODE:([0-9a-fA-F.]+)",
+        text,
+    )
+    if not match:
+        return None, None, "missing"
+    return int(match.group(1)), int(match.group(2)), match.group(3).lower()
+
+
+def is_incident(lines: dict[str, str]) -> list[str]:
+    incidents: list[str] = []
+    fp = lines["IRQ_SAVE_FP_OVERWRITE"]
+    if fp != "none" and not fp.startswith("none "):
+        incidents.append(f"0x04D6 frame-pointer overwrite: {fp}")
+    invalid = lines["INVALID_CONTROL"]
+    if invalid != "none" and not invalid.startswith("none "):
+        incidents.append(f"invalid control transfer: {invalid}")
+    unsupported = lines["UNSUPPORTED"]
+    if unsupported != "none" and not unsupported.startswith("none "):
+        incidents.append(f"unsupported instruction: {unsupported}")
+    state_calls, state_returns, state_code = userinfo_state_copy(
+        lines["USERINFO_FLOW"]
+    )
+    if state_calls and state_code != "missing" and set(state_code) <= {"f", "."}:
+        incidents.append(
+            "USERINFO state-copy overlay is blank at runtime "
+            f"({state_calls}/{state_returns or 0} calls/returns)"
+        )
+    application = lines["APPLICATION_STATE"]
+    file_size = lines["FILE_SIZE_RECORD"]
+    menu = lines["MENU_OVERLAY_COPY"]
+    foreground_calls = application_calls(
+        lines["APPLICATION_TRACE"], "FGLOOP"
+    )
+    if (
+        "RESOURCE_FLAG:0001" in application
+        and "LENGTH:0000:0000" in file_size
+        and "READS:0" in menu
+        and not foreground_calls
+    ):
+        incidents.append(
+            "main resource resolved to zero length before the menu entry"
+        )
+    state_write = lines["APPLICATION_STATE_WRITE"].lower()
+    if "pc:2e:46c0" in state_write and "addr:512aaa" in state_write:
+        incidents.append(
+            "application state overwritten by the sector-copy worker"
+        )
+    irq_bad = integer(lines["IRQ64"], "BAD")
+    if irq_bad:
+        incidents.append(f"64-Hz interrupt returned through a bad frame ({irq_bad})")
+    refresh_mismatches = integer(lines["NATIVE_REFRESH"], "MISMATCHES")
+    if refresh_mismatches:
+        incidents.append(
+            "LCD refresh front/back mismatch "
+            f"({refresh_mismatches})"
+        )
+    modal_polls = application_calls(lines["APPLICATION_TRACE"], "MODALPOLL")
+    resource_calls = application_calls(lines["APPLICATION_TRACE"], "RESOURCE")
+    modal_entries = application_calls(lines["APPLICATION_TRACE"], "MODALEVT")
+    modal_cleanups = application_calls(lines["APPLICATION_TRACE"], "CLEANUP")
+    if (
+        modal_polls is not None
+        and modal_polls >= 1000
+        and modal_entries is not None
+        and modal_entries > (modal_cleanups or 0)
+        and not resource_calls
+    ):
+        incidents.append(
+            "pre-resource modal loop is blocking the main resource entry "
+            f"({modal_polls} polls)"
+        )
+    return incidents
+
+
+def compact_observation(state: dict[str, Any]) -> dict[str, Any]:
+    lines = state_lines(str(state.get("registers", "")))
+    encoded_frame = str(state.get("frame", ""))
+    frame = (
+        base64.b64decode(encoded_frame, validate=True)
+        if encoded_frame else None
+    )
+    callbacks = integer(lines["INDIRECT_CALLBACK"], "CALLS")
+    file_opens = integer(lines["FILE_OPEN"], "CALLS")
+    flushes = integer(lines["NATIVE_LCD_FLUSH"], "CALLS")
+    nonzero = integer(lines["NATIVE_FB"], "NONZERO")
+    provision_stage = integer(lines["PROVISION"], "STAGE")
+    file_writes = integer(lines["FILE_WRITE"], "CALLS")
+    file_commits = integer(lines["FILE_COMMIT"], "CALLS")
+    storage_driver_calls = integer(lines["STORAGE_DRIVER"], "CALLS")
+    file_root_allocs = integer(lines["FILE_ROOT_POOL"], "CALLS")
+    file_root_releases = integer(lines["FILE_ROOT_RELEASE"], "CALLS")
+    nand_programs = integer(lines["NAND"], "PROGRAMS")
+    nand_erases = integer(lines["NAND"], "ERASES")
+    modal_polls = application_calls(lines["APPLICATION_TRACE"], "MODALPOLL")
+    resource_calls = application_calls(lines["APPLICATION_TRACE"], "RESOURCE")
+    userinfo_state_calls, userinfo_state_returns, userinfo_state_code = (
+        userinfo_state_copy(lines["USERINFO_FLOW"])
+    )
+    foreground = {
+        stage.lower(): application_calls(lines["APPLICATION_TRACE"], stage)
+        for stage in FOREGROUND_STAGES
+    }
+    state_write_pc, state_old, state_new = state_write_transition(
+        lines["APPLICATION_STATE_WRITE"]
+    )
+    return {
+        "time": datetime.now().astimezone().isoformat(timespec="seconds"),
+        "running": bool(state.get("running")),
+        "pc": lines.get("PC", "missing"),
+        "provision_stage": provision_stage,
+        "callbacks": callbacks,
+        "file_opens": file_opens,
+        "file_writes": file_writes,
+        "file_commits": file_commits,
+        "storage_driver_calls": storage_driver_calls,
+        "file_root_allocs": file_root_allocs,
+        "file_root_releases": file_root_releases,
+        "nand_programs": nand_programs,
+        "nand_erases": nand_erases,
+        "modal_polls": modal_polls,
+        "resource_calls": resource_calls,
+        "lcd_flushes": flushes,
+        "lcd_nonzero": nonzero,
+        "text_y": text_y_values(lines["TEXT_TRACE"]),
+        "frame_sha256": (
+            hashlib.sha256(frame).hexdigest()[:12]
+            if frame is not None else None
+        ),
+        "state_write_count": integer(
+            lines["APPLICATION_STATE_WRITE"], "COUNT"
+        ),
+        "state_write_pc": state_write_pc,
+        "state_old": state_old,
+        "state_new": state_new,
+        "state_write": lines["APPLICATION_STATE_WRITE"],
+        "foreground": foreground,
+        "foreground_event": application_stage_r0(
+            lines["APPLICATION_TRACE"], "FGDECODE"
+        ),
+        "event_tick": hex_integer(lines["EVENT_STATE"], "TICK"),
+        "irq_ticks": integer(lines["IRQ64"], "TICKS"),
+        "irq_entries": integer(lines["IRQ64"], "ENTRIES"),
+        "irq_returns": integer(lines["IRQ64"], "RETURNS"),
+        "irq_bad": integer(lines["IRQ64"], "BAD"),
+        "refresh_calls": integer(lines["NATIVE_REFRESH"], "CALLS"),
+        "refresh_mismatches": integer(
+            lines["NATIVE_REFRESH"], "MISMATCHES"
+        ),
+        "menu_reads": integer(lines["MENU_OVERLAY_COPY"], "READS"),
+        "menu_entries": integer(lines["MENU_OVERLAY_COPY"], "ENTRY"),
+        "userinfo_events": integer(lines["USERINFO_FLOW"], "EVENTS"),
+        "userinfo_state_calls": userinfo_state_calls,
+        "userinfo_state_returns": userinfo_state_returns,
+        "userinfo_state_code": userinfo_state_code,
+        "application": lines["APPLICATION_STATE"],
+        "file_size_record": lines["FILE_SIZE_RECORD"],
+        "file_record_resolve": lines["FILE_RECORD_RESOLVE"],
+        "resource_open": lines["RESOURCE_OPEN"],
+        "resource_recovery_word": lines["RESOURCE_RECOVERY_WORD"],
+        "menu_overlay": lines["MENU_OVERLAY_COPY"],
+        "incidents": is_incident(lines),
+    }
+
+
+def incident_changes(
+    previous: set[str], current: list[str],
+) -> tuple[list[str], list[str]]:
+    """Return newly observed and newly resolved incidents in stable order."""
+    def identity(incident: str) -> str:
+        # Runtime counters grow while the CPU remains at one fault.  Treat a
+        # new COUNT value as the same incident so long monitors report the
+        # transition once instead of printing a false resolve/new pair on
+        # every sample.
+        return re.sub(r"\bCOUNT[=:]\d+", "COUNT:*", incident)
+
+    previous_by_identity = {identity(item): item for item in previous}
+    current_by_identity = {identity(item): item for item in current}
+    added = [
+        incident for incident in current
+        if identity(incident) not in previous_by_identity
+    ]
+    resolved = sorted(
+        incident for key, incident in previous_by_identity.items()
+        if key not in current_by_identity
+    )
+    return added, resolved
+
+
+def observation_signature(observation: dict[str, Any]) -> tuple[object, ...]:
+    """Select state changes worth printing in long-running monitor mode."""
+    return tuple(
+        observation.get(key) for key in (
+            "running", "pc", "provision_stage", "callbacks", "file_opens",
+            "file_writes", "file_commits", "storage_driver_calls",
+            "file_root_allocs", "file_root_releases", "nand_programs",
+            "nand_erases", "modal_polls", "resource_calls", "lcd_flushes",
+            "lcd_nonzero", "text_y", "frame_sha256", "application",
+            "state_write_count", "state_write_pc", "state_old", "state_new",
+            "foreground", "foreground_event", "event_tick", "irq_ticks",
+            "irq_entries", "irq_returns", "irq_bad", "refresh_calls",
+            "refresh_mismatches", "menu_reads", "menu_entries",
+            "userinfo_events", "userinfo_state_calls",
+            "userinfo_state_returns", "userinfo_state_code",
+            "file_size_record", "file_record_resolve", "resource_open",
+            "resource_recovery_word", "menu_overlay", "incidents",
+        )
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", default="http://127.0.0.1:8778")
+    parser.add_argument("--interval", type=float, default=10.0)
+    parser.add_argument("--count", type=int, default=1)
+    parser.add_argument("--timeout", type=float, default=5.0)
+    parser.add_argument("--json", action="store_true")
+    parser.add_argument(
+        "--changes-only", action="store_true",
+        help="suppress unchanged snapshots during long-running monitoring",
+    )
+    args = parser.parse_args()
+    if args.interval <= 0 or args.count <= 0 or args.timeout <= 0:
+        parser.error("interval, count and timeout must be positive")
+
+    incident_seen = False
+    previous: dict[str, Any] | None = None
+    previous_incidents: set[str] = set()
+    previous_signature: tuple[object, ...] | None = None
+    for sample in range(args.count):
+        try:
+            observation = compact_observation(fetch_state(args.url, args.timeout))
+        except (OSError, URLError, ValueError, json.JSONDecodeError) as exc:
+            print(f"probe failed: {exc}", file=sys.stderr)
+            return 1
+        added_incidents, resolved_incidents = incident_changes(
+            previous_incidents, observation["incidents"]
+        )
+        signature = observation_signature(observation)
+        should_print = not args.changes_only or signature != previous_signature
+        if args.json and should_print:
+            observation["new_incidents"] = added_incidents
+            observation["resolved_incidents"] = resolved_incidents
+            print(json.dumps(observation, ensure_ascii=False))
+        elif not args.json and should_print:
+            deltas = ""
+            if previous is not None:
+                delta_parts = []
+                for key in (
+                    "callbacks", "file_opens", "file_writes",
+                    "file_commits", "storage_driver_calls", "nand_programs",
+                    "file_root_allocs", "file_root_releases", "lcd_flushes",
+                ):
+                    current = observation[key]
+                    old = previous[key]
+                    if current is not None and old is not None:
+                        delta_parts.append(f"d-{key}={current - old:+d}")
+                deltas = " " + " ".join(delta_parts)
+            print(
+                f"[{observation['time']}] pc={observation['pc']} "
+                f"provision={observation['provision_stage']} "
+                f"callbacks={observation['callbacks']} "
+                f"file-opens={observation['file_opens']} "
+                f"writes={observation['file_writes']} "
+                f"commits={observation['file_commits']} "
+                f"drivers={observation['storage_driver_calls']} "
+                f"roots-a/r={observation['file_root_allocs']}/"
+                f"{observation['file_root_releases']} "
+                f"nand-p/e={observation['nand_programs']}/"
+                f"{observation['nand_erases']} "
+                f"modal/resource={observation['modal_polls']}/"
+                f"{observation['resource_calls']} "
+                f"lcd={observation['lcd_nonzero']}/"
+                f"{observation['lcd_flushes']} text-y={observation['text_y']} "
+                f"userinfo={observation['userinfo_events']}:"
+                f"{observation['userinfo_state_calls']}/"
+                f"{observation['userinfo_state_returns']} "
+                f"state-code={observation['userinfo_state_code'][:24]} "
+                f"frame={observation['frame_sha256']}{deltas}",
+                flush=True,
+            )
+            print(f"  app: {observation['application']}")
+            foreground = observation["foreground"]
+            if observation["state_old"] is None:
+                state_transition = "missing"
+            else:
+                state_transition = (
+                    f"{observation['state_old']:04x}>"
+                    f"{observation['state_new']:04x}@"
+                    f"{observation['state_write_pc']}"
+                )
+            foreground_event = observation["foreground_event"]
+            foreground_event_text = (
+                f"{foreground_event:04x}"
+                if foreground_event is not None else "missing"
+            )
+            print(
+                "  flow: "
+                f"state-writes={observation['state_write_count']} "
+                f"last={state_transition} event={foreground_event_text} "
+                f"fg={foreground['fgloop']}/{foreground['fgrawret']}/"
+                f"{foreground['fgmapret']}/{foreground['fgdecode']}/"
+                f"{foreground['fgchange']}/{foreground['fgexit']} "
+                f"menu={observation['menu_reads']}/"
+                f"{observation['menu_entries']} "
+                f"event-tick={observation['event_tick']} "
+                f"irq={observation['irq_entries']}/"
+                f"{observation['irq_returns']}/bad{observation['irq_bad']} "
+                f"refresh={observation['refresh_calls']}/"
+                f"bad{observation['refresh_mismatches']}",
+            )
+            for incident in added_incidents:
+                print(f"  ALERT NEW: {incident}", file=sys.stderr)
+            for incident in resolved_incidents:
+                print(f"  ALERT RESOLVED: {incident}", file=sys.stderr)
+        incident_seen |= bool(observation["incidents"])
+        previous = observation
+        previous_incidents = set(observation["incidents"])
+        previous_signature = signature
+        if sample + 1 < args.count:
+            time.sleep(args.interval)
+    return 2 if incident_seen else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/probe_np560_state.py b/probe_np560_state.py
new file mode 100644
index 0000000000000000000000000000000000000000..01b2db51bfeb6da57bd8695b2253318f698d5b02
--- /dev/null
+++ b/probe_np560_state.py
@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+"""Run an NP560 guest briefly and print CPU/NAND state for RE probes."""
+
+from __future__ import annotations
+
+import argparse
+import re
+import time
+from pathlib import Path
+
+from web.np560_web import Emulator
+
+
+def parse_pc(value: str) -> int:
+    segment_text, separator, offset_text = value.partition(":")
+    if not separator:
+        raise argparse.ArgumentTypeError("PC must use SEGMENT:OFFSET")
+    try:
+        segment = int(segment_text, 16)
+        offset = int(offset_text, 16)
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError("PC must contain hexadecimal values") from exc
+    if not 0 <= segment <= 0xFF or not 0 <= offset <= 0xFFFF:
+        raise argparse.ArgumentTypeError("PC is outside the 24-bit code space")
+    return segment << 16 | offset
+
+
+def state_pc(state: str) -> int | None:
+    match = re.search(r"^PC=([0-9a-fA-F]{2}):([0-9a-fA-F]{4})", state)
+    if match is None:
+        return None
+    return int(match.group(1), 16) << 16 | int(match.group(2), 16)
+
+
+def compact_progress(cpu_state: str, nand_state: str, elapsed: float) -> str:
+    pc_line = cpu_state.splitlines()[0] if cpu_state else "PC=unknown"
+    counters = re.search(
+        r"READS=(\d+) PROGRAMS=(\d+) ERASES=(\d+) COPIES=(\d+)",
+        nand_state,
+    )
+    page = re.search(r"PAGE_ADDR=([0-9a-fA-F]+)", nand_state)
+    detail = counters.group(0) if counters else "NAND counters unavailable"
+    page_text = page.group(1) if page else "unknown"
+    return f"PROGRESS={elapsed:.1f}s {pc_line} PAGE={page_text} {detail}"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--qemu", type=Path, required=True)
+    parser.add_argument("--firmware", type=Path, required=True)
+    parser.add_argument("--soc-rom", type=Path, required=True)
+    parser.add_argument("--burn-code", type=Path)
+    parser.add_argument("--nand-image", type=Path)
+    parser.add_argument("--nand-checkpoint", type=Path)
+    parser.add_argument("--seconds", type=float, default=3.0)
+    parser.add_argument(
+        "--until-pc", type=parse_pc,
+        help="wait until guest execution reaches SEGMENT:OFFSET; --seconds is the timeout",
+    )
+    parser.add_argument(
+        "--progress-interval", type=float, default=0.0,
+        help="print compact CPU/NAND progress at this interval while waiting",
+    )
+    parser.add_argument(
+        "--no-log-unimp", action="store_true",
+        help="disable the high-volume QEMU unimplemented/resident-call log",
+    )
+    parser.add_argument("--save", type=Path)
+    parser.add_argument(
+        "--save-nand", type=Path,
+        help="write complete NAND data/OOB state as a restartable checkpoint",
+    )
+    args = parser.parse_args()
+
+    if args.nand_image is not None and args.nand_checkpoint is not None:
+        parser.error("--nand-image and --nand-checkpoint are mutually exclusive")
+
+    emulator = Emulator(
+        qemu=args.qemu,
+        firmware=args.firmware,
+        soc_rom=args.soc_rom,
+        soc_rom_skeleton=True,
+        burn_code=args.burn_code,
+        nand_image=args.nand_image,
+        nand_checkpoint=args.nand_checkpoint,
+        log_unimp=not args.no_log_unimp,
+    )
+    try:
+        started = time.monotonic()
+        deadline = started + max(args.seconds, 0.0)
+        next_progress = started + max(args.progress_interval, 0.0)
+        reached = args.until_pc is None
+        while args.until_pc is not None and time.monotonic() < deadline:
+            cpu_state = emulator.qmp.execute(
+                "qom-get", {"path": "/machine", "property": "cpu-state"}
+            )
+            if state_pc(cpu_state) == args.until_pc:
+                reached = True
+                break
+            now = time.monotonic()
+            if args.progress_interval > 0 and now >= next_progress:
+                nand_state = emulator.qmp.execute(
+                    "qom-get", {"path": "/machine", "property": "nand-state"}
+                )
+                print(compact_progress(cpu_state, nand_state, now - started),
+                      flush=True)
+                next_progress = now + args.progress_interval
+            time.sleep(0.1)
+        if args.until_pc is None:
+            time.sleep(max(deadline - time.monotonic(), 0.0))
+        cpu_state = emulator.qmp.execute(
+            "qom-get", {"path": "/machine", "property": "cpu-state"}
+        )
+        nand_state = emulator.qmp.execute(
+            "qom-get", {"path": "/machine", "property": "nand-state"}
+        )
+        print(cpu_state)
+        print(nand_state)
+        if args.until_pc is not None:
+            target = f"{args.until_pc >> 16:02x}:{args.until_pc & 0xffff:04x}"
+            print(f"WAIT_PC={target} {'reached' if reached else 'timeout'}", flush=True)
+        if args.save is not None:
+            emulator.qmp.execute("pmemsave", {
+                "val": 0,
+                "size": 0x1000000,
+                "filename": str(args.save),
+            })
+        if args.save_nand is not None:
+            emulator.qmp.execute("qom-set", {
+                "path": "/machine",
+                "property": "nand-save",
+                "value": str(args.save_nand),
+            })
+            print(f"NAND checkpoint saved: {args.save_nand}")
+    finally:
+        emulator.close()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/repair_np560_checkpoint_ecc.py b/repair_np560_checkpoint_ecc.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb3d61e6d0377975293c56e3de5aeb0d61b7b8bc
--- /dev/null
+++ b/repair_np560_checkpoint_ecc.py
@@ -0,0 +1,129 @@
+#!/usr/bin/env python3
+"""Normalize factory metadata and rebuild ECC in an NP560 checkpoint copy.
+
+Early clean-room checkpoints preserved the NAND payload and FTL metadata but
+stored zero parity halves in descriptors carrying the valid 0x6979 signature.
+The original guest validator rejects those sectors.  This utility keeps the
+source immutable, copies it, and regenerates only signed descriptors using the
+same 512-byte paired-parity format recovered from 31:8C18/51:C1A4.
+"""
+
+from __future__ import annotations
+
+import argparse
+import mmap
+import shutil
+import struct
+from pathlib import Path
+
+from analyze_np560_ecc_checkpoint import ECC_OFFSETS, ECC_SIGNATURE, sector_descriptor
+
+
+CHECKPOINT_MAGIC = b"NP560N1\0"
+HEADER_SIZE = 64
+FACTORY_PAGE = 0x3F
+FACTORY_RECORD_SIZE = 0x208
+FACTORY_RECORDS = 3
+SECTOR_SIZE = 512
+FACTORY_DATA_PREFIX = bytes.fromhex(
+    "feca e30e 0801 424b 0000 0000 0000 0000 "
+    "0000 0000 4508 0500 0002 0000 0000"
+)
+FACTORY_OOB = bytes(55) + b"\x77" + bytes(8)
+
+
+def repair_checkpoint(source: Path, destination: Path) -> tuple[int, int]:
+    if source.resolve() == destination.resolve():
+        raise ValueError("destination must differ from source")
+    if destination.exists():
+        raise FileExistsError(destination)
+
+    shutil.copyfile(source, destination)
+    with destination.open("r+b") as target:
+        image = mmap.mmap(target.fileno(), 0)
+        try:
+            if len(image) < HEADER_SIZE or image[:8] != CHECKPOINT_MAGIC:
+                raise ValueError("not an NP560 NAND checkpoint")
+            version, header_size, page_data, page_oob, block_pages, blocks = (
+                struct.unpack_from("<6I", image, 8)
+            )
+            data_size, oob_size = struct.unpack_from("<2Q", image, 32)
+            page_count = block_pages * blocks
+            if (
+                version != 1
+                or header_size != HEADER_SIZE
+                or page_data != 2048
+                or page_oob != 64
+                or data_size != page_count * page_data
+                or oob_size != page_count * page_oob
+                or len(image) != HEADER_SIZE + data_size + oob_size
+            ):
+                raise ValueError("incompatible checkpoint geometry")
+
+            data_base = HEADER_SIZE
+            oob_base = data_base + data_size
+
+            # Preserve the record exactly as the recovered guest formatter
+            # emits it.  Byte-addressed DMCU fields use the bus order visible
+            # here ("BK" and 00:02 physically), not host-order "KB"/02:00.
+            factory_base = data_base + FACTORY_PAGE * page_data
+            for record in range(FACTORY_RECORDS):
+                record_base = factory_base + record * FACTORY_RECORD_SIZE
+                image[record_base : record_base + SECTOR_SIZE] = (
+                    FACTORY_DATA_PREFIX
+                    + bytes(SECTOR_SIZE - len(FACTORY_DATA_PREFIX))
+                )
+            factory_oob = oob_base + FACTORY_PAGE * page_oob
+            image[factory_oob : factory_oob + page_oob] = FACTORY_OOB
+
+            signed = 0
+            changed = 0
+            for page in range(page_count):
+                page_data_offset = data_base + page * page_data
+                page_oob_offset = oob_base + page * page_oob
+                for sector, descriptor_offset in enumerate(ECC_OFFSETS):
+                    target_offset = page_oob_offset + descriptor_offset
+                    if struct.unpack_from("<H", image, target_offset + 6)[0] != ECC_SIGNATURE:
+                        continue
+                    signed += 1
+                    expected = sector_descriptor(
+                        image, page_data_offset + sector * SECTOR_SIZE
+                    )
+                    if image[target_offset : target_offset + 8] != expected:
+                        image[target_offset : target_offset + 8] = expected
+                        changed += 1
+
+            for record in range(FACTORY_RECORDS):
+                record_base = factory_base + record * FACTORY_RECORD_SIZE
+                descriptor_offset = record_base + SECTOR_SIZE
+                if (
+                    struct.unpack_from("<H", image, descriptor_offset + 6)[0]
+                    != ECC_SIGNATURE
+                ):
+                    raise ValueError(
+                        f"factory record {record} lacks the 0x6979 descriptor signature"
+                    )
+                signed += 1
+                expected = sector_descriptor(image, record_base)
+                if image[descriptor_offset : descriptor_offset + 8] != expected:
+                    image[descriptor_offset : descriptor_offset + 8] = expected
+                    changed += 1
+
+            image.flush()
+            return signed, changed
+        finally:
+            image.close()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("destination", type=Path)
+    args = parser.parse_args()
+    signed, changed = repair_checkpoint(args.source, args.destination)
+    print(f"ECC_SIGNED={signed} ECC_REPAIRED={changed} OUTPUT={args.destination}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/run-np560-web.ps1 b/run-np560-web.ps1
