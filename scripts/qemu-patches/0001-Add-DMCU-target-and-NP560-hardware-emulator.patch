+}
+
+static void np560_set_debug_program_load(Object *obj, const char *value,
+                                         Error **errp)
+{
+    NP560MachineState *s = NP560_MACHINE(obj);
+    const char *path;
+    uint64_t address;
+    uint64_t end;
+    g_autofree gchar *contents = NULL;
+    g_autoptr(GError) gerror = NULL;
+    gsize size = 0;
+
+    if (!value || !*value) {
+        g_clear_pointer(&s->debug_program_load, g_free);
+        return;
+    }
+    if (!np560_parse_debug_address(value, &path, &address, errp)) {
+        return;
+    }
+    if (!g_file_get_contents(path, &contents, &size, &gerror)) {
+        error_setg(errp, "Unable to load NP560+ debug program data '%s': %s",
+                   path, gerror->message);
+        return;
+    }
+    end = address + size;
+    if (!s->cpu || memory_region_size(&s->program) != DMCU_PROGRAM_SIZE) {
+        error_setg(errp, "NP560+ program source is not initialized");
+        return;
+    }
+    if (end < address || address < DMCU_PROGRAM_BASE + 0x1000u ||
+        end > DMCU_PROGRAM_BASE + NP560_PROGRAM_DATA_NOR_SIZE) {
+        error_setg(errp, "NP560+ debug program source 0x%" PRIx64
+                   "..0x%" PRIx64 " is outside data-visible program NOR",
+                   address, end);
+        return;
+    }
+    memcpy(memory_region_get_ram_ptr(&s->program) +
+           address - DMCU_PROGRAM_BASE, contents, size);
+    memory_region_set_dirty(&s->program, address - DMCU_PROGRAM_BASE, size);
+    tb_flush(CPU(s->cpu));
+    tlb_flush(CPU(s->cpu));
+    g_free(s->debug_program_load);
+    s->debug_program_load = g_strdup(value);
+}
